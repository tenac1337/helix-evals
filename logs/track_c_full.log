    cout << "{\n";
    bool first = true;
    for (size_t i = 0; i < items.size(); i++) {
        if (!first) cout << ",\n";
        cout << "    \"" << items[i].name << "\": " << result[i];
        first = false;
    }
    cout << "\n}\n";
    
    return 0;
}
