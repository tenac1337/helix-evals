                    int score = (deg > 1) ? (deg + 100) : deg;
                    if (score > best_score) {
                        best_score = score;
                        best_idx = i;
                    }
                }
                choice = best_idx + 1;
            }
            
            cout << choice << "\n" << flush;
        }
    }
    
    return 0;
}
