using namespace std;

struct State {
    int next[2];
    int link;
    int len;
    State() : link(-1), len(0) {
        next[0] = next[1] = -1;
    }
};

class SuffixAutomaton {
public:
    vector<State> st;
    int last;
    
    void init(int maxLen = 0) {
        st.clear();
        st.reserve(2 * maxLen + 5);
        st.push_back(State());
        st[0].len = 0;
        st[0].link = -1;
        last = 0;
    }
    
    void extend(char c) {
        int cur = (int)st.size();
        st.push_back(State());
        st[cur].len = st[last].len + 1;
        
        int p = last;
        int cIdx = (c == 'X') ? 0 : 1;
        
        while (p != -1 && st[p].next[cIdx] == -1) {
            st[p].next[cIdx] = cur;
            p = st[p].link;
        }
        
        if (p == -1) {
            st[cur].link = 0;
        } else {
            int q = st[p].next[cIdx];
            if (st[p].len + 1 == st[q].len) {
                st[cur].link = q;
            } else {
                int clone = (int)st.size();
                st.push_back(st[q]);
                st[clone].len = st[p].len + 1;
                while (p != -1 && st[p].next[cIdx] == q) {
                    st[p].next[cIdx] = clone;
                    p = st[p].link;
                }
                st[q].link = st[cur].link = clone;
            }
        }
        last = cur;
    }
    
    long long countDistinctSubstrings() {
        long long result = 0;
        for (size_t i = 1; i < st.size(); i++) {
            result += st[i].len - st[st[i].link].len;
        }
        return result;
    }
};

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    if (!(cin >> n)) return 0;
    
    vector<string> words;
    words.reserve(n);
    for (int i = 1; i <= n; i++) {
        string w = "X";
        w.append(i - 1, 'O');
        words.push_back(w);
    }
    
    for (int i = 0; i < n; i++) {
        cout << words[i] << "\n";
    }
    cout.flush();
    
    int q;
    cin >> q;
    
    unordered_map<long long, pair<int, int>> powerToPair;
    powerToPair.reserve(n * n * 2);
    
    SuffixAutomaton sam;
    string concat;
    
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            concat = words[i] + words[j];
            sam.init(concat.length());
            for (char c : concat) {
                sam.extend(c);
            }
            long long power = sam.countDistinctSubstrings();
            powerToPair[power] = {i + 1, j + 1};
        }
    }
    
    for (int i = 0; i < q; i++) {
        long long p;
        cin >> p;
        auto it = powerToPair.find(p);
        if (it != powerToPair.end()) {
            cout << it->second.first << " " << it->second.second << "\n";
        } else {
            cout << "1 1\n";
        }
        cout.flush();
    }
    
    return 0;
