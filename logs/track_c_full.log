            if (token == "AC" || token == "F") {
                break;
            }
            
            int d = stoi(token);
            
            // We won't know the actual vertex IDs of neighbors
            // So we use the flags to infer which are visited
            vector<int> neighbor_degrees;
            vector<int> neighbor_flags;
            
            for (int i = 0; i < d; ++i) {
                int deg, flag;
                cin >> deg >> flag;
                neighbor_degrees.push_back(deg);
                neighbor_flags.push_back(flag);
            }
            
            // Strategy: 
            // 1. If there are unvisited neighbors (flag=0), pick one with LOWEST degree
            //    (these are likely dead-ends or leaves we should handle early)
            // 2. If all neighbors are visited (flag=1), pick one with HIGHEST degree
            //    (to maximize future exploration options)
            
            int choice = 1;
            
            // First, check if there are any unvisited neighbors
            bool has_unvisited = false;
            for (int flag : neighbor_flags) {
                if (flag == 0) {
                    has_unvisited = true;
                    break;
                }
            }
            
            if (has_unvisited) {
                // Find unvisited neighbor with minimum degree
                int best_idx = -1;
                int min_deg = INT_MAX;
                for (int i = 0; i < d; ++i) {
                    if (neighbor_flags[i] == 0 && neighbor_degrees[i] < min_deg) {
                        min_deg = neighbor_degrees[i];
                        best_idx = i;
                    }
                }
                choice = best_idx + 1;
            } else {
                // All neighbors visited - pick one with maximum degree
                // This tends to lead to vertices with more options
                int best_idx = 0;
                int max_deg = neighbor_degrees[0];
                for (int i = 1; i < d; ++i) {
                    if (neighbor_degrees[i] > max_deg) {
                        max_deg = neighbor_degrees[i];
                        best_idx = i;
                    }
                }
                choice = best_idx + 1;
            }
            
            cout << choice << "\n" << flush;
        }
    }
    
    return 0;
