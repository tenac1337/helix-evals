            for (int i = 0; i < d; ++i) {
                if (neighbor_flags[i] == 0) {
                    unvisited_idx.push_back(i);
                }
            }
            
            if (!unvisited_idx.empty()) {
                // Pick unvisited with lowest degree (explore leaves first)
                int best_idx = unvisited_idx[0];
                int min_deg = neighbor_degrees[best_idx];
                for (size_t k = 1; k < unvisited_idx.size(); ++k) {
                    int idx = unvisited_idx[k];
                    if (neighbor_degrees[idx] < min_deg) {
                        min_deg = neighbor_degrees[idx];
                        best_idx = idx;
                    }
                }
                choice = best_idx + 1;
            } else {
                // All neighbors visited - use round-robin to avoid cycles
                // Use move number to vary choice
                
                int start_idx = move_num % d;
                int candidate = start_idx;
                
                // Try to avoid backtracking
                int prev_idx = -1;
                if (prev_degree != -1) {
                    for (int i = 0; i < d; ++i) {
                        if (neighbor_degrees[i] == prev_degree) {
                            prev_idx = i;
                            break;
                        }
                    }
                }
                
                // Find first candidate that's not previous
                for (int offset = 0; offset < d; ++offset) {
                    int idx = (start_idx + offset) % d;
                    if (idx != prev_idx) {
                        candidate = idx;
                        break;
                    }
                }
                
                // If we have to take prev, take it
                choice = candidate + 1;
            }
            
            prev_degree = d;
            
            cout << choice << "\n" << flush;
        }
    }
    
    return 0;
}
