    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            cin >> value[i][j];
        }
    }
    
    // Track which tiles have been visited
    vector<vector<bool>> tile_visited(N, vector<bool>(N, false));
    
    auto mark_tile_visited = [&](int ti, int tj) {
        int tid = tile[ti][tj];
        for (int i = 0; i < N; i++) {
            for (int j = 0; j < N; j++) {
                if (tile[i][j] == tid) {
                    tile_visited[i][j] = true;
                }
            }
        }
    };
    
    int ci = si, cj = sj;
    mark_tile_visited(ci, cj);
    
    string moves;
    const int dirs[4][2] = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};
    const char dir_chars[4] = {'U', 'D', 'L', 'R'};
    
    // Greedy path finding - at each step go to the best available neighbor
    for (int step = 0; step < 2500; step++) {
        int best_value = -1;
        int best_dir = -1;
        
        for (int d = 0; d < 4; d++) {
            int ni = ci + dirs[d][0];
            int nj = cj + dirs[d][1];
            
