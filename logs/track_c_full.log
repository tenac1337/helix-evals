using namespace std;

struct Card {
    int suit; // 0-3
    int value; // 1-13 (2-A)
};

vector<string> split(const string& s) {
    vector<string> result;
    stringstream ss(s);
    string token;
    while (ss >> token) {
        result.push_back(token);
    }
    return result;
}

int cardValueToInt(char c) {
    if (c >= '2' && c <= '9') return c - '0';
    if (c == 'T') return 10;
    if (c == 'J') return 11;
    if (c == 'Q') return 12;
    if (c == 'K') return 13;
    if (c == 'A') return 14;
    return 0;
}

int parseCard(const string& s) {
    if (s.length() != 2) return -1;
    int value = cardValueToInt(s[0]);
    int suit = s[1] - '0';
    if (value >= 2 && value <= 14 && suit >= 0 && suit <= 3) {
        return (value << 2) | suit;
    }
    return -1;
}

int evaluateHand(vector<int> cards) {
    // Returns a score for the hand (higher is better)
    // Simplified evaluation
    if (cards.size() < 5) return 0;
    
    // Count values and suits
    map<int, int> valueCount;
    map<int, int> suitCount;
    for (int c : cards) {
        int value = c >> 2;
        int suit = c & 3;
        valueCount[value]++;
        suitCount[suit]++;
    }
    
    // Check for flush
    int flushSuit = -1;
    for (auto& p : suitCount) {
        if (p.second >= 5) {
            flushSuit = p.first;
            break;
        }
    }
    
    // Check for straight
    vector<int> uniqueValues;
    for (auto& p : valueCount) uniqueValues.push_back(p.first);
    sort(uniqueValues.rbegin(), uniqueValues.rend());
    
    bool isStraight = false;
    int straightHigh = 0;
    for (size_t i = 0; i + 4 < uniqueValues.size(); i++) {
        bool straight = true;
        for (size_t j = 0; j < 4; j++) {
            if (uniqueValues[i+j] != uniqueValues[i+j+1] + 1) {
                straight = false;
                break;
            }
        }
        if (straight) {
            isStraight = true;
            straightHigh = uniqueValues[i];
            break;
        }
    }
    // Check A-2-3-4-5 straight (wheel)
    if (!isStraight) {
        bool hasA = valueCount.count(14);
        bool has2 = valueCount.count(2);
        bool has3 = valueCount.count(3);
        bool has4 = valueCount.count(4);
        bool has5 = valueCount.count(5);
        if (hasA && has2 && has3 && has4 && has5) {
            isStraight = true;
            straightHigh = 5; // A-2-3-4-5 is lowest straight
        }
    }
    
    // Evaluate hand type
    // Straight flush
    if (flushSuit != -1 && isStraight) {
        return 900000 + straightHigh * 10000;
    }
    
    // Four of a kind
    for (auto& p : valueCount) {
        if (p.second == 4) {
            return 800000 + p.first * 10000;
        }
    }
    
    // Full house
    int three = -1, two = -1;
    for (auto& p : valueCount) {
        if (p.second == 3) three = max(three, p.first);
    }
    for (auto& p : valueCount) {
        if (p.second == 2 && p.first != three) two = max(two, p.first);
    }
    if (three != -1 && two != -1) {
        return 700000 + three * 10000 + two * 100;
    }
    
    // Flush
    if (flushSuit != -1) {
        return 600000;
    }
    
    // Straight
    if (isStraight) {
        return 500000 + straightHigh * 10000;
    }
    
    // Three of a kind
    if (three != -1) {
        return 400000 + three * 10000;
    }
    
    // Two pairs
    vector<int> pairs;
    for (auto& p : valueCount) {
        if (p.second == 2) pairs.push_back(p.first);
    }
    if (pairs.size() >= 2) {
        sort(pairs.rbegin(), pairs.rend());
        return 300000 + pairs[0] * 10000 + pairs[1] * 100;
    }
    
    // One pair
    if (pairs.size() == 1) {
        return 200000 + pairs[0] * 10000;
    }
    
    // High card
    return uniqueValues[0] * 10000;
}

