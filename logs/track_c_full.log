        int minx = INT_MAX, miny = INT_MAX;
        for (auto [cx, cy] : orig_pieces[i].cells) {
            minx = min(minx, cx);
            miny = min(miny, cy);
        }
        for (auto& c : orig_pieces[i].cells) {
            c.first -= minx;
            c.second -= miny;
        }
        // compute bounding box
        orig_pieces[i].minx = 0; orig_pieces[i].miny = 0;
        orig_pieces[i].w = 0; orig_pieces[i].h = 0;
        for (auto [cx, cy] : orig_pieces[i].cells) {
            orig_pieces[i].w = max(orig_pieces[i].w, cx + 1);
            orig_pieces[i].h = max(orig_pieces[i].h, cy + 1);
        }
