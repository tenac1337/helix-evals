using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    if (!(cin >> n)) return 0;
    
    // Strategy: Binary search with redundancy to handle lies.
    // For every pair of consecutive questions, at least one answer is correct.
    // We ask about overlapping ranges and track consistency.
    
    int low = 1, high = n;
    vector<pair<int, string>> answers; // store (question_type, answer)
    
    while (low < high && (int)answers.size() < 52) {
        int mid = (low + high) / 2;
        
        // Ask about [low, mid]
        cout << "? " << (mid - low + 1);
        for (int i = low; i <= mid; i++) cout << " " << i;
        cout << endl;
        string ans1;
        cin >> ans1;
        answers.push_back({1, ans1});
        
        if ((int)answers.size() >= 53) break;
        
        // Ask about [mid+1, high]
        if (mid + 1 <= high) {
            cout << "? " << (high - mid);
            for (int i = mid + 1; i <= high; i++) cout << " " << i;
            cout << endl;
            string ans2;
            cin >> ans2;
            answers.push_back({2, ans2};
        }
        
        // Process answers
        // If both answers are YES, x is in [low, mid] ∩ [mid+1, high] = empty - inconsistent
        // If both answers are NO, x is outside both - inconsistent 
        // If one YES and one NO, we can determine direction (at least one is correct)
        
        string lastAns = answers.back().second;
        string prevAns = answers[answers.size() - 2].second;
        
        if (answers.size() >= 2) {
            if (prevAns == "YES" && lastAns == "YES") {
                // Both say YES - but at least one is correct, so x is in intersection
                // Since sets are disjoint, this is inconsistent
                // But one must be lying, so we can't trust either
                // Fall back to linear search from low
                break;
            } else if (prevAns == "NO" && lastAns == "NO") {
                // Both say NO - at least one is correct, x not in either set
                // So x must be outside [low, high] - impossible, one is lying
                break;
            } else if (prevAns == "YES" && lastAns == "NO") {
                // First says YES (x in [low,mid]), second says NO (x not in [mid+1,high])
                // At least one correct, so x is in [low,mid]
                high = mid;
            } else if (prevAns == "NO" && lastAns == "YES") {
                // First says NO, second says YES
                // At least one correct, so x is in [mid+1,high]
                low = mid + 1;
            }
        }
    }
    
    // First guess: middle of current range
    int guess1 = (low + high) / 2;
    cout << "! " << guess1 << endl;
    string result;
    cin >> result;
    
    if (result == ":)") return 0;
    
    // If wrong, try another value in range
    if (low + 1 <= high) {
        int guess2 = low + 1;
        if (guess2 != guess1) {
            cout << "! " << guess2 << endl;
            cin >> result;
        }
    } else if (low - 1 >= 1) {
        int guess2 = low - 1;
        cout << "! " << guess2 << endl;
        cin >> result;
    }
    
    return 0;
}
