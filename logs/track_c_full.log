#include <vector>
#include <queue>
#include <algorithm>
#include <set>
#include <tuple>
#include <deque>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    vector<string> grid;
    for (int i = 0; i < 3; i++) {
        string line;
        getline(cin, line);
        grid.push_back(line);
    }

    if (grid.size() < 3) {
        cout << "0 0" << endl;
        return 0;
    }

    int total_rotations = 1 << 18; // 4^9 = 262144, but 1<<18 is 262144
    vector<int> best_ans(2, 0);
    int best_score = 0;

    for (int rotation_index = 0; rotation_index < total_rotations; rotation_index++) {
        vector<int> rotations;
        int temp = rotation_index;
        for (int i = 0; i < 9; i++) {
            rotations.push_back(temp % 4);
            temp /= 4;
        }

        vector<vector<int>> graph(16);
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                int tile_index = i * 3 + j;
                char tile_type = grid[i][j];
                int r = rotations[tile_index];
                if (tile_type == '1') {
                    if (r == 0 || r == 2) {
                        int node1 = i * 4 + j;
                        int node2 = (i + 1) * 4 + j;
                        graph[node1].push_back(node2);
                        graph[node2].push_back(node1);
                        int node3 = i * 4 + (j + 1);
                        int node4 = (i + 1) * 4 + (j + 1);
                        graph[node3].push_back(node4);
                        graph[node4].push_back(node3);
                    } else {
                        int node1 = i * 4 + j;
                        int node2 = i * 4 + (j + 1);
                        graph[node1].push_back(node2);
                        graph[node2].push_back(node1);
                        int node3 = (i + 1) * 4 + j;
                        int node4 = (i + 1) * 4 + (j + 1);
                        graph[node3].push_back(node4);
                        graph[node4].push_back(node3);
                    }
                } else {
                    if (r == 0) {
                        int node1 = i * 4 + j;
                        int node2 = i * 4 + (j + 1);
                        graph[node1].push_back(node2);
                        graph[node2].push_back(node1);
                        int node3 = (i + 1) * 4 + j;
                        graph[node1].push_back(node3);
                        graph[node3].push_back(node1);
                    } else if (r == 1) {
                        int node1 = i * 4 + j;
                        int node2 = i * 4 + (j + 1);
                        graph[node1].push_back(node2);
                        graph[node2].push_back(node1);
                        int node3 = (i + 1) * 4 + (j + 1);
                        graph[node2].push_back(node3);
                        graph[node3].push_back(node2);
                    } else if (r == 2) {
                        int node1 = i * 4 + j;
                        int node2 = (i + 1) * 4 + j;
                        graph[node1].push_back(node2);
                        graph[node2].push_back(node1);
                        int node3 = (i + 1) * 4 + (j + 1);
                        graph[node2].push_back(node3);
                        graph[node3].push_back(node2);
                    } else if (r == 3) {
                        int node1 = i * 4 + (j + 1);
                        int node2 = (i + 1) * 4 + (j + 1);
                        graph[node1].push_back(node2);
                        graph[node2].push_back(node1);
                        int node3 = (i + 1) * 4 + j;
                        graph[node2].push_back(node3);
                        graph[node3].push_back(node2);
                    }
                }
            }
        }

        set<tuple<int, int>> seen_edges;
        vector<int> cycle_sizes;

        for (int u = 0; u < 16; u++) {
            for (int v : graph[u]) {
                if (u >= v) continue;
                auto edge = make_tuple(u, v);
                if (seen_edges.find(edge) != seen_edges.end()) continue;
                seen_edges.insert(edge);

                vector<int> temp_graph_u = graph[u];
                vector<int> temp_graph_v = graph[v];
                graph[u].erase(remove(graph[u].begin(), graph[u].end(), v), graph[u].end());
                graph[v].erase(remove(graph[v].begin(), graph[v].end(), u), graph[v].end());

                vector<int> dist(16, -1);
                vector<int> parent(16, -1);
                queue<int> q;
                q.push(u);
                dist[u] = 0;
                bool found = false;
                while (!q.empty() && !found) {
                    int current = q.front();
                    q.pop();
                    for (int neighbor : graph[current]) {
                        if (dist[neighbor] == -1) {
                            dist[neighbor] = dist[current] + 1;
                            parent[neighbor] = current;
                            if (neighbor == v) {
                                found = true;
                                break;
                            }
                            q.push(neighbor);
                        }
                    }
                }

                if (found) {
                    set<int> cycle_nodes;
                    int temp = v;
                    while (temp != u) {
                        cycle_nodes.insert(temp);
                        temp = parent[temp];
                    }
                    cycle_nodes.insert(u);
                    size_t size = cycle_nodes.size();
                    cycle_sizes.push_back(size);
                }

                graph[u] = temp_graph_u;
                graph[v] = temp_graph_v;
            }
        }

        if (cycle_sizes.empty()) {
            if (best_score < 0) {
                best_score = 0;
                best_ans = {0, 0};
            }
        } else {
            sort(cycle_sizes.begin(), cycle_sizes.end(), greater<int>());
            int size1 = cycle_sizes[0];
            int size2 = (cycle_sizes.size() >= 2) ? cycle_sizes[1] : 0;
            int current_score = size1 + size2;
            if (current_score > best_score) {
                best_score = current_score;
                best_ans = {size1, size2};
            }
        }
    }

    cout << best_ans[0] << " " << best_ans[1] << endl;
    return 0;
}

