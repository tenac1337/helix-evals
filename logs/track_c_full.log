using namespace std;

struct Item {
    string name;
    long long q;  // quantity available
    long long v;  // value per item
    long long m;  // mass in mg
    long long l;  // volume in µL
};

const long long MAX_MASS = 20LL * 1000000;  // 20 kg = 20,000,000 mg
const long long MAX_VOL = 25LL * 1000000;   // 25 L = 25,000,000 µL

// Parse a simple JSON object with string keys and int array values
vector<Item> parseInput(const string& s) {
    vector<Item> items;
    int n = s.size();
    int i = 0;
    
    // Expect opening brace
    while (i < n && isspace(s[i])) i++;
    if (i >= n || s[i] != '{') return items;
    i++;
    
    while (i < n) {
        // Skip whitespace
        while (i < n && isspace(s[i])) i++;
        if (i >= n) break;
        
        // Expect comma or closing brace
        if (s[i] == '}') break;
        if (s[i] == ',') i++;
        
        // Skip whitespace
        while (i < n && isspace(s[i])) i++;
        
        // Parse key (string)
        if (s[i] != '"') break;
        i++;
        string key;
        while (i < n && s[i] != '"') {
            if (s[i] == '\\' && i + 1 < n) {
                i++;
                key += s[i++];
            } else {
                key += s[i++];
            }
        }
        if (i >= n || s[i] != '"') break;
        i++; // skip closing quote
        
        // Skip whitespace
        while (i < n && isspace(s[i])) i++;
        
        // Expect colon
        if (i >= n || s[i] != ':') break;
        i++;
        
        // Skip whitespace
        while (i < n && isspace(s[i])) i++;
        
        // Parse array
        if (s[i] != '[') break;
        i++;
        
        vector<long long> nums;
        while (i < n) {
            while (i < n && isspace(s[i])) i++;
            if (s[i] == ']') break;
            if (s[i] == ',') {
                i++;
                continue;
            }
            // Parse number
            string numstr;
            while (i < n && (isdigit(s[i]) || s[i] == '-')) {
                numstr += s[i++];
            }
            if (!numstr.empty()) {
                nums.push_back(stoll(numstr));
            }
            while (i < n && isspace(s[i])) i++;
            if (s[i] == ',') i++;
        }
        if (i >= n || s[i] != ']') break;
        i++; // skip closing bracket
        
        if (nums.size() >= 4) {
            Item it;
            it.name = key;
            it.q = nums[0];
            it.v = nums[1];
            it.m = nums[2];
            it.l = nums[3];
            items.push_back(it);
        }
    }
    
    return items;
}

// Solve using greedy with value/weight ratios, then refine
vector<long long> solveKnapsack(const vector<Item>& items) {
    int n = items.size();
    vector<long long> result(n, 0);
    
    if (n == 0) return result;
    
    // Create a list of all available items with their densities
    struct Candidate {
        int idx;
        long long value;
        long long mass;
        long long volume;
        long long count;
    };
    
    vector<Candidate> candidates;
    
    for (int i = 0; i < n; i++) {
        const auto& it = items[i];
        if (it.m <= 0 || it.l <= 0) continue;
        
        // Calculate value density (value per mass and per volume)
        // We'll use a combined metric
        long long mass_density = it.v * 1000000 / it.m;  // value per kg
        long long vol_density = it.v * 1000000 / it.l;  // value per liter
        
        // Use minimum of the two as a conservative estimate
        long long density = min(mass_density, vol_density);
        
        candidates.push_back({i, it.v, it.m, it.l, it.q};
    }
    
    // Sort by value density descending
    sort(candidates.begin(), candidates.end(), [](const Candidate& a, const Candidate& b) {
        long long density_a = a.value * 1000000 / max(a.mass, 1LL);
        long long density_b = b.value * 1000000 / max(b.mass, 1LL);
        // Also consider volume
        long long vol_density_a = a.value * 1000000 / max(a.volume, 1LL);
        long long vol_density_b = b.value * 1000000 / max(b.volume, 1LL);
        return max(density_a, vol_density_a) > max(density_b, vol_density_b);
    });
    
    long long totalMass = 0;
    long long totalVol = 0;
    long long totalValue = 0;
    
    // Greedy selection
    for (const auto& cand : candidates) {
        const auto& it = items[cand.idx];
        
        // Calculate how many we can fit
        long long maxByMass = (MAX_MASS - totalMass) / it.m;
        long long maxByVol = (MAX_VOL - totalVol) / it.l;
        long long maxCount = min({cand.count, maxByMass, maxByVol});
        
        if (maxCount > 0) {
            result[cand.idx] = maxCount;
            totalMass += maxCount * it.m;
            totalVol += maxCount * it.l;
            totalValue += maxCount * it.v;
        }
    }
    
    // Try to improve with simple local search
    bool improved = true;
    while (improved) {
        improved = false;
        
        // Try adding items that weren't fully taken
        for (const auto& cand : candidates) {
            int i = cand.idx;
            const auto& it = items[i];
            long long used = result[i];
            long long remaining = it.q - used;
            
            if (remaining <= 0) continue;
            
            // Can we add more?
            long long maxByMass = (MAX_MASS - totalMass) / it.m;
            long long maxByVol = (MAX_VOL - totalVol) / it.l;
            long long canAdd = min(remaining, min(maxByMass, maxByVol));
            
            if (canAdd > 0) {
                result[i] += canAdd;
                totalMass += canAdd * it.m;
                totalVol += canAdd * it.l;
                totalValue += canAdd * it.v;
                improved = true;
            }
        }
        
        // Try swapping: remove lower value density items and add higher ones
        for (int i = 0; i < n && !improved; i++) {
            if (result[i] == 0) continue;
            
            const auto& it_i = items[i];
            long long density_i = it_i.v * 1000000 / max(it_i.m, 1LL);
            long long vol_density_i = it_i.v * 1000000 / max(it_i.l, 1LL);
            density_i = max(density_i, vol_density_i);
            
            // Try removing one of item i and adding something else
            for (const auto& cand : candidates) {
                int j = cand.idx;
                if (i == j || result[j] >= cand.count) continue;
                
                const auto& it_j = items[j];
                
                // Check if we can swap
                if (totalMass - it_i.m + it_j.m <= MAX_MASS && 
                    totalVol - it_i.l + it_j.l <= MAX_VOL) {
                    
                    // Is it beneficial?
                    if (it_j.v > it_i.v) {
                        result[i]--;
                        result[j]++;
                        totalMass = totalMass - it_i.m + it_j.m;
                        totalVol = totalVol - it_i.l + it_j.l;
                        totalValue = totalValue - it_i.v + it_j.v;
                        improved = true;
                        break;
                    }
                }
            }
        }
    }
    
    return result;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    // Read entire input
    string input, line;
    while (getline(cin, line)) {
        input += line;
        input += '\n';
    }
    
    // Parse input
    vector<Item> items = parseInput(input);
    
    // Solve
    vector<long long> result = solveKnapsack(items);
    
    // Output JSON
    cout << "{";
    for (size_t i = 0; i < items.size(); i++) {
        if (i > 0) cout << ",";
        cout << "\"" << items[i].name << "\":" << result[i];
    }
    cout << "}" << endl;
    
    return 0;
