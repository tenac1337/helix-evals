using namespace std;

// Query if u and v are adjacent. Assumes S may be non-empty.
// We reset S to empty first, then add u and v, then reset again.
bool isAdjacent(int u, int v) {
    // Reset S to empty by toggling u then v (if present)
    cout << "2 " << u << " " << v << endl;
    int r1, r2;
    cin >> r1 >> r2;
    
    // S now has {u, v}. r2 tells us if u and v are adjacent.
    // Reset S to empty: toggle v then u
    cout << "2 " << v << " " << u << endl;
    int r3, r4;
    cin >> r3 >> r4;
    
    return r2 == 1;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int subtask, n;
    if (!(cin >> subtask >> n)) return 0;

    if (n == 2) {
        cout << "-1 1 2" << endl;
        return 0;
    }

    // Find neighbors of 1
    vector<int> neighbors;
    for (int v = 2; v <= n && neighbors.size() < 2; ++v) {
        if (isAdjacent(1, v)) {
            neighbors.push_back(v);
        }
    }

    if (neighbors.size() != 2) {
        // Fallback: try more thoroughly
        for (int v = 2; v <= n && neighbors.size() < 2; ++v) {
            bool found = false;
            for (int nv : neighbors) {
                if (v == nv) {
                    found = true;
                    break;
                }
            }
            if (!found && isAdjacent(1, v)) {
                neighbors.push_back(v);
            }
        }
    }

    // Reconstruct the ring
    vector<int> perm;
    perm.push_back(1);
    perm.push_back(neighbors[0]);

    vector<bool> visited(n + 1, false);
    visited[1] = true;
    visited[neighbors[0]] = true;

    while ((int)perm.size() < n) {
        int current = perm.back();
        
        // Find next neighbor not yet in permutation
        for (int v = 1; v <= n; ++v) {
            if (!visited[v] && isAdjacent(current, v)) {
                perm.push_back(v);
                visited[v] = true;
                break;
            }
        }
    }

    // Output result
    cout << "-1";
    for (int x : perm) {
        cout << " " << x;
    }
    cout << endl;

    return 0;
}
