using namespace std;

struct Piece {
    vector<pair<int,int>> cells;
    int w, h;
};

Piece normalize(const vector<pair<int,int>>& cells) {
    int minx = INT_MAX, miny = INT_MAX;
    for (auto [x,y] : cells) {
        minx = min(minx, x);
        miny = min(miny, y);
    }
    Piece p;
    for (auto [x,y] : cells) {
        p.cells.emplace_back(x - minx, y - miny);
    }
    int maxx = 0, maxy = 0;
    for (auto [x,y] : p.cells) {
        maxx = max(maxx, x);
        maxy = max(maxy, y);
    }
    p.w = maxx + 1;
    p.h = maxy + 1;
    return p;
}

Piece transform(const Piece& p, int r, int f) {
    Piece t = p;
    for (auto& cell : t.cells) {
        int x = cell.first, y = cell.second;
        // Apply reflection across y-axis if needed
        if (f) x = p.w - 1 - x;
        // Apply rotation (0, 90, 180, 270 degrees clockwise)
        for (int i = 0; i < r; i++) {
            int nx = y;
            int ny = (f ? x : p.w - 1 - x);
            x = nx;
            y = ny;
        }
        cell.first = x;
        cell.second = y;
    }
    // Re-normalize after transformation
    return normalize(t.cells);
}

