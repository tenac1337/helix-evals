Iteration 7: Proposed new text for current_candidate: #include <iostream>
#include <string>
#include <vector>
#include <map>
#include <cctype>
#include <algorithm>
#include <sstream>
#include <tuple>

using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    string input;
    string line;
    while (getline(cin, line)) {
        input += line;
    }

    map<string, vector<long long>> data;
    vector<string> keys_order;

    size_t start = input.find('{');
    if (start == string::npos) {
        return 1;
    }
    size_t end = input.find('}');
    if (end == string::npos) {
        return 1;
    }
    string content = input.substr(start+1, end - start - 1);

    size_t pos = 0;
    vector<string> entries;
    while (pos < content.size()) {
        size_t next = content.find(',', pos);
        if (next == string::npos) {
            string entry = content.substr(pos);
            if (!entry.empty()) {
                entries.push_back(entry);
            }
            break;
        }
        string entry = content.substr(pos, next - pos);
        if (!entry.empty()) {
            entries.push_back(entry);
        }
        pos = next + 1;
    }

    for (string entry : entries) {
        size_t colon = entry.find(':');
        if (colon == string::npos) continue;
        string key_part = entry.substr(0, colon);
        string value_part = entry.substr(colon+1);

        if (key_part[0] == '"' && key_part.back() == '"') {
            key_part = key_part.substr(1, key_part.size()-2);
        }

        size_t start_bracket = value_part.find('[');
        size_t end_bracket = value_part.find(']');
        if (start_bracket == string::npos || end_bracket == string::npos) continue;
        string inner = value_part.substr(start_bracket+1, end_bracket - start_bracket - 1);

        vector<long long> numbers;
        istringstream iss(inner);
        long long num;
        while (iss >> num) {
            numbers.push_back(num);
            if (iss.peek() == ',') {
                iss.ignore();
            }
        }

        if (numbers.size() == 4) {
            keys_order.push_back(key_part);
            data[key_part] = numbers;
        }
    }

