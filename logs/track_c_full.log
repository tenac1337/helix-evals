                if (tr < 0 || tr >= 6 || tc < 0 || tc >= 6 || init_state.board[tr][tc] != 0) {
                    valid = false;
                    break;
                }
            }
            if (valid) {
                vector<Vehicle> new_vehs = vehicles;
                new_vehs[vi].row = new_r;
                new_vehs[vi].col = new_c;
                State new_state = build_state(new_vehs);
                int ms = solve_bfs(new_state);
                if (ms > best_steps) {
                    best_steps = ms;
                    best_moves.clear();
                    char dir = v.horizontal ? (step > 0 ? 'L' : 'R') : (step > 0 ? 'U' : 'D');
                    best_moves.push_back({v.id, dir};
                }
            }
        }
    }
    
    // Output result
    cout << best_steps << " " << best_moves.size() << "\n";
    for (auto& m : best_moves) {
        cout << m.first << " " << m.second << "\n";
    }
    
    return 0;
