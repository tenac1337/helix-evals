Iteration 1: Proposed new text for current_candidate: #include <bits/stdc++.h>
using namespace std;

struct Card {
    int suit;  // 0-3
    int value; // 1-13 (2=2,...,10=10,11=J,12=Q,13=K,14=A)
};

int cardValue(char c) {
    if (c >= '2' && c <= '9') return c - '0';
    if (c == 'T') return 10;
    if (c == 'J') return 11;
    if (c == 'Q') return 12;
    if (c == 'K') return 13;
    if (c == 'A') return 14;
    return 0;
}

Card parseCard(const string& s) {
    Card c;
    c.suit = s[0] - '0';
    c.value = cardValue(s[1]);
    return c;
}

// Check if hand has flush
bool isFlush(const vector<Card>& hand) {
    for (int s = 0; s < 4; s++) {
        int cnt = 0;
        for (auto& c : hand) if (c.suit == s) cnt++;
        if (cnt >= 5) return true;
    }
    return false;
}

// Check for straight
bool isStraight(const vector<Card>& hand, int& highStraight) {
    vector<int> values;
    for (auto& c : hand) values.push_back(c.value);
    sort(values.begin(), values.end());
    values.erase(unique(values.begin(), values.end()), values.end());
    
    // Check regular straights
    for (int i = 0; i + 4 < (int)values.size(); i++) {
        bool straight = true;
        for (int j = 0; j < 4; j++) {
            if (values[i+j+1] != values[i+j] + 1) {
                straight = false;
                break;
            }
        }
        if (straight) {
            highStraight = values[i+4];
            return true;
        }
    }
    
    // Check A-2-3-4-5 straight (A=14, treat as 1)
    bool hasA = false, has2 = false, has3 = false, has4 = false, has5 = false;
    for (int v : values) {
        if (v == 14) hasA = true;
        if (v == 2) has2 = true;
        if (v == 3) has3 = true;
        if (v == 4) has4 = true;
        if (v == 5) has5 = true;
    }
    if (hasA && has2 && has3 && has4 && has5) {
        highStraight = 5; // A-2-3-4-5 is lowest straight
        return true;
    }
    return false;
}

// Get counts of each value
map<int,int> getCounts(const vector<Card>& hand) {
    map<int,int> cnt;
    for (auto& c : hand) cnt[c.value]++;
    return cnt;
}

// Evaluate hand: returns pair<handType, tieBreakers>
// Hand types: 9=high card, 8=pair, 7=two pair, 6=three of a kind, 5=straight,
// 4=flush, 3=full house, 2=four of a kind, 1=straight flush
pair<int, vector<int>> evaluateHand(const vector<Card>& allCards) {
    // Find best 5-card hand from 7 cards
    vector<Card> bestHand;
    pair<int, vector<int>> bestScore = {0, {}};
    
    // Try all 5-card combinations
    vector<bool> sel(allCards.size(), false);
    for (int i = 0; i < 5; i++) sel[i] = true;
    
    do {
        vector<Card> hand;
        for (size_t i = 0; i < allCards.size(); i++) {
            if (sel[i]) hand.push_back(allCards[i]);
        }
        
        int highStraight = 0;
        bool flush = isFlush(hand);
        bool straight = isStraight(hand, highStraight);
        
        map<int,int> cnt = getCounts(hand);
        
        // Check for straight flush
        if (flush && straight) {
            // Check if straight flush
            vector<int> suitCounts(4, 0);
            for (auto& c : hand) suitCounts[c.suit]++;
            for (int s = 0; s < 4; s++) {
                if (suitCounts[s] >= 5) {
                    // We have 5+ of same suit, check if straight
                    vector<int> suitVals;
                    for (auto& c : hand) if (c.suit == s) suitVals.push_back(c.value);
                    sort(suitVals.begin(), suitVals.end());
                    suitVals.erase(unique(suitVals.begin(), suitVals.end()), suitVals.end());
                    
                    // Check regular straight
                    for (int i = 0; i + 4 < (int)suitVals.size(); i++) {
                        bool str = true;
                        for (int j = 0; j < 4; j++) {
                            if (suitVals[i+j+1] != suitVals[i+j] + 1) { str = false; break; }
                        }
                        if (str) {
                            pair<int, vector<int>> score = {1, {suitVals[i+4]}};
                            if (score > bestScore) {
                                bestScore = score;
                                bestHand = hand;
                            }
                        }
                    }
                    // A-2-3-4-5 straight flush
                    bool hasA=false, has2=false, has3=false, has4=false, has5=false;
                    for (int v : suitVals) {
                        if (v==14) hasA=true; if(v==2)has2=true; if(v==3)has3=true;
                        if(v==4)has4=true; if(v==5)has5=true;
                    }
                    if (hasA && has2 && has3 && has4 && has5) {
                        pair<int, vector<int>> score = {1, {5}};
                        if (score > bestScore) { bestScore = score; bestHand = hand; }
                    }
                }
            }
            if (!bestHand.empty()) continue; // found straight flush
        }
        
        // Check four of a kind
        for (auto& p : cnt) {
            if (p.second == 4) {
                int fourVal = p.first;
                vector<int> tie = {fourVal};
                // Add kicker
                for (auto& q : cnt) if (q.first != fourVal) tie.push_back(q.first);
                sort(tie.begin()+1, tie.end(), greater<int>());
                while (tie.size() < 5) tie.push_back(0);
                pair<int, vector<int>> score = {2, tie};
                if (score > bestScore) { bestScore = score; bestHand = hand; }
            }
        }
        
        // Check full house
        int threeVal = -1, twoVal = -1;
        for (auto& p : cnt) if (p.second == 3) threeVal = max(threeVal, p.first);
        if (threeVal >= 0) {
            for (auto& p : cnt) if (p.second >= 2 && p.first != threeVal) 
                twoVal = max(twoVal, p.first);
        }
        if (threeVal >= 0 && twoVal >= 0) {
            pair<int, vector<int>> score = {3, {threeVal, twoVal}};
            if (score > bestScore) { bestScore = score; bestHand = hand; }
        }
        
        // Check flush
        if (flush) {
            vector<int> suitCounts(4, 0);
            for (auto& c : hand) suitCounts[c.suit]++;
            int flushSuit = -1;
            for (int s = 0; s < 4; s++) if (suitCounts[s] >= 5) flushSuit = s;
            if (flushSuit >= 0) {
                vector<int> flushVals;
                for (auto& c : hand) if (c.suit == flushSuit) flushVals.push_back(c.value);
                sort(flushVals.begin(), flushVals.end(), greater<int>());
                while (flushVals.size() > 5) flushVals.pop_back();
                pair<int, vector<int>> score = {4, flushVals};
                if (score > bestScore) { bestScore = score; bestHand = hand; }
            }
        }
        
        // Check straight
        if (straight) {
            pair<int, vector<int>> score = {5, {highStraight}};
            if (score > bestScore) { bestScore = score; bestHand = hand; }
        }
        
        // Check three of a kind
        if (threeVal >= 0 && twoVal < 0) {
            // Find two highest kickers
            vector<int> kickers;
            for (auto& p : cnt) if (p.first != threeVal) kickers.push_back(p.first);
            sort(kickers.begin(), kickers.end(), greater<int>());
            while (kickers.size() < 2) kickers.push_back(0);
            pair<int, vector<int>> score = {6, {threeVal, kickers[0], kickers[1]}};
            if (score > bestScore) { bestScore = score; bestHand = hand; }
        }
        
        // Check two pair
        vector<int> pairVals;
        for (auto& p : cnt) if (p.second >= 2) pairVals.push_back(p.first);
        sort(pairVals.begin(), pairVals.end(), greater<int>());
        if (pairVals.size() >= 2) {
            int kicker = 0;
            for (auto& p : cnt) if (p.first != pairVals[0] && p.first != pairVals[1]) 
                kicker = max(kicker, p.first);
            pair<int, vector<int>> score = {7, {pairVals[0], pairVals[1], kicker}};
            if (score > bestScore) { bestScore = score; bestHand = hand; }
        }
        
        // Check one pair
        if (pairVals.size() == 1) {
            vector<int> kickers;
            for (auto& p : cnt) if (p.first != pairVals[0]) kickers.push_back(p.first);
            sort(kickers.begin(), kickers.end(), greater<int>());
            while (kickers.size() < 3) kickers.push_back(0);
            pair<int, vector<int>> score = {8, {pairVals[0], kickers[0], kickers[1], kickers[2]}};
            if (score > bestScore) { bestScore = score; bestHand = hand; }
        }
        
        // High card
        vector<int> vals;
        for (auto& c : hand) vals.push_back(c.value);
        sort(vals.begin(), vals.end(), greater<int>());
        while (vals.size() < 5) vals.push_back(0);
        pair<int, vector<int>> score = {9, vals};
        if (score > bestScore) { bestScore = score; bestHand = hand; }
        
    } while (next_permutation(sel.begin(), sel.end()));
    
    return bestScore;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    vector<Card> myCards;
    vector<Card> board;
    int myStack = 100;
    int oppStack = 100;
    int pot = 10;
    int round = 0;
    
    string line;
    while (getline(cin, line)) {
        if (line.empty()) continue;
        
        // Parse message
        if (line.substr(0, 7) == "CARDS ") {
            // Get my cards
            string rest = line.substr(6);
            stringstream ss(rest);
            string c1, c2;
            ss >> c1 >> c2;
            myCards.clear();
            myCards.push_back(parseCard(c1));
            myCards.push_back(parseCard(c2));
        }
        else if (line.substr(0, 6) == "BOARD ") {
            // Get community cards
            string rest = line.substr(6);
            stringstream ss(rest);
            string c;
            board.clear();
            while (ss >> c) {
                board.push_back(parseCard(c));
            }
        }
        else if (line.substr(0, 6) == "STATE ") {
            // Full state update
            string rest = line.substr(6);
            stringstream ss(rest);
            string token;
            vector<string> toks;
            while (ss >> token) toks.push_back(token);
            
            // Parse: my_cards opp_cards board_cards my_stack opp_stack pot round
            if (toks.size() >= 7) {
                myCards.clear();
                myCards.push_back(parseCard(toks[0]));
                myCards.push_back(parseCard(toks[1]));
                
                board.clear();
                for (size_t i = 2; i < toks.size() && board.size() < 5; i++) {
                    if (toks[i].size() == 2) {
                        board.push_back(parseCard(toks[i]));
                    }
                }
                
                // Find my stack, opp stack, pot, round from remaining
                // This is simplified
            }
        }
        else if (line.substr(0, 5) == "STACK") {
            // Update stack info
            string rest = line.substr(5);
            stringstream ss(rest);
            ss >> myStack >> oppStack >> pot;
        }
        else if (line.substr(0, 5) == "POT ") {
            string rest = line.substr(4);
            stringstream ss(rest);
            ss >> pot;
        }
        else if (line.substr(0, 6) == "ROUND ") {
            string rest = line.substr(6);
            round = stoi(rest);
        }
        else if (line == "ACTION") {
            // Need to decide action
            vector<Card> allCards = myCards;
            for (auto& c : board) allCards.push_back(c);
            
            auto score = evaluateHand(allCards);
            int handType = score.first;
            
            // Simple strategy
            if (handType <= 3) {
                // Very strong hand (straight flush, 4kind, full house) - raise
                int raiseAmt = min(myStack, max(1, pot/2));
                cout << "RAISE " << raiseAmt << endl;
            }
            else if (handType <= 5) {
                // Strong hand (flush, straight) - raise or check
                if (pot < 20) {
                    int raiseAmt = min(myStack, max(1, pot/3));
                    cout << "RAISE " << raiseAmt << endl;
                } else {
                    cout << "CHECK" << endl;
                }
            }
            else if (handType <= 7) {
                // Medium hand (3ofakind, two pair) - small raise or check
                if (pot < 15) {
                    int raiseAmt = min(myStack, max(1, pot/4));
                    cout << "RAISE " << raiseAmt << endl;
                } else {
                    cout << "CHECK" << endl;
                }
            }
            else {
                // Weak hand - mostly check, sometimes fold
                if (pot > 30) {
                    cout << "FOLD" << endl;
                } else {
                    cout << "CHECK" << endl;
                }
            }
            cout.flush();
        }
        else if (line == "WIN" || line == "LOSS" || line == "TIE") {
            // Hand over, reset
            myCards.clear();
            board.clear();
            myStack = 100;
            oppStack = 100;
            pot = 10;
            round = 0;
        }
        else if (line.substr(0, 5) == "SCORE") {
            // Final score, can exit
            break;
        }
    }
    
    return 0;
