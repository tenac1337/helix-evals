        vector<int> test_p(n + 1, 0);
        test_p[1] = cand;
        
        // Check consistency with parity queries
        for (int i = 2; i <= n && valid; i++) {
            int needParity = parityWith1[i];  // 1 = same as p1, 0 = opposite
            bool found = false;
            for (int v = 1; v <= n; v++) {
                if (v == cand) continue;
                bool sameParity = ((cand % 2) == (v % 2));
                if ((needParity == 1 && sameParity) || (needParity == 0 && !sameParity)) {
                    // Check if v is already used
