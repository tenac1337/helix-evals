using namespace std;

int main() {
    int s_i, s_j, t_i, t_j;
    cin >> s_i >> s_j;
    cin >> t_i >> t_j;

    vector<string> grid(20);
    cin.ignore();
    for (int i = 0; i < 20; i++) {
        getline(cin, grid[i]);
    }

    if (s_i == t_i && s_j == t_j) {
        cout << "" << endl;
        return 0;
    }

    vector<tuple<int, int, char>> dirs = { 
        {-1, 0, 'U'}, 
        {1, 0, 'D'}, 
        {0, -1, 'L'}, 
        {0, 1, 'R'} 
    };

    vector<vector<bool>> visited(20, vector<bool>(20, false));
    vector<vector<int>> parent_i(20, vector<int>(20, -1));
    vector<vector<int>> parent_j(20, vector<int>(20, -1));
    vector<vector<char>> move_char(20, vector<char>(20, 0));

    queue<pair<int, int>> q;
    q.push({s_i, s_j});
    visited[s_i][s_j] = true;

    bool found = false;
    while (!q.empty()) {
        int i = q.front().first;
        int j = q.front().second;
        q.pop();
        if (i == t_i && j == t_j) {
            found = true;
            break;
        }
        for (auto d : dirs) {
            int ni = i + get<0>(d);
            int nj = j + get<1>(d);
            char c = get<2>(d);
            if (ni >= 0 && ni < 20 && nj >= 0 && nj < 20 && grid[ni][nj] != '#' && !visited[ni][nj]) {
                visited[ni][nj] = true;
                parent_i[ni][nj] = i;
                parent_j[ni][nj] = j;
                move_char[ni][nj] = c;
                q.push({ni, nj});
            }
        }
    }

    if (found) {
        string path = "";
        int i = t_i, j = t_j;
        while (i != s_i || j != s_j) {
            char c = move_char[i][j];
            path = c + path;
            int pi = parent_i[i][j];
            int pj = parent_j[i][j];
            i = pi;
            j = pj;
        }

        string result = "";
        for (int i = 0; i < 200; i++) {
            result += path[i % path.size()];
        }
        cout << result << endl;
    } else {
        string fixed = "UDLR";
        string result = "";
        for (int i = 0; i < 50; i++) {
            result += fixed;
        }
        cout << result << endl;
    }

    return 0;
}

