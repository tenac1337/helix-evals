using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    const int queries = 1000;
    
    for (int q = 0; q < queries; q++) {
        int si, sj, ti, tj;
        if (!(cin >> si >> sj >> ti >> tj)) break;
        
        // Output shortest path: move vertically then horizontally
        // This gives Manhattan distance which is optimal in grid graph
        string path;
        
        // Vertical movement
        if (ti > si) {
            path.append(ti - si, 'D');
        } else if (ti < si) {
            path.append(si - ti, 'U');
        }
        
        // Horizontal movement
        if (tj > sj) {
            path.append(tj - sj, 'R');
        } else if (tj < sj) {
            path.append(sj - tj, 'L');
        }
        
        cout << path << "\n";
        cout.flush();
        
        // Read feedback (the noisy path length)
        long long feedback;
        cin >> feedback;
    }
    
    return 0;
}
