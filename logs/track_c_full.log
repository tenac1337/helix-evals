using namespace std;

struct State {
    array<array<int, 6>, 6> grid;
    
    bool operator==(const State& other) const {
        return grid == other.grid;
    }
};

struct StateHash {
    size_t operator()(const State& s) const {
        size_t h = 0;
        for (int i = 0; i < 6; i++) {
            for (int j = 0; j < 6; j++) {
                h = h * 7 + s.grid[i][j];
            }
        }
        return h;
    }
};

bool can_move(const State& s, int id, int dr, int dc) {
    // Find the vehicle
    int r_min = 6, c_min = 6, r_max = -1, c_max = -1;
    for (int i = 0; i < 6; i++) {
        for (int j = 0; j < 6; j++) {
            if (s.grid[i][j] == id) {
                r_min = min(r_min, i);
                c_min = min(c_min, j);
                r_max = max(r_max, i);
                c_max = max(c_max, j);
            }
        }
    }
    
    // Determine orientation
    bool horizontal = (r_min == r_max);
    int len = horizontal ? (c_max - c_min + 1) : (r_max - r_min + 1);
    
    // Check if move is valid
    if (horizontal) {
        if (dc == 1) { // moving right
            int new_c = c_max + 1;
            if (new_c >= 6) return false;
            if (s.grid[r_min][new_c] != 0) return false;
        } else if (dc == -1) { // moving left
            int new_c = c_min - 1;
            if (new_c < 0) return false;
            if (s.grid[r_min][new_c] != 0) return false;
        }
    } else { // vertical
        if (dr == 1) { // moving down
            int new_r = r_max + 1;
            if (new_r >= 6) return false;
            if (s.grid[new_r][c_min] != 0) return false;
        } else if (dr == -1) { // moving up
            int new_r = r_min - 1;
            if (new_r < 0) return false;
            if (s.grid[new_r][c_min] != 0) return false;
        }
    }
    return true;
}

State move_vehicle(const State& s, int id, int dr, int dc) {
    State ns = s;
    
    // Find all cells of the vehicle
    vector<pair<int,int>> cells;
    for (int i = 0; i < 6; i++) {
        for (int j = 0; j < 6; j++) {
            if (s.grid[i][j] == id) {
                cells.push_back({i, j};
            }
        }
    }
    
    // Clear old positions
    for (auto [r, c] : cells) {
        ns.grid[r][c] = 0;
    }
    
    // Set new positions
    for (auto [r, c] : cells) {
        ns.grid[r + dr][c + dc] = id;
    }
    
    return ns;
}

vector<pair<int, pair<int,int>>> get_all_moves(const State& s) {
    vector<pair<int, pair<int,int>>> moves;
    set<int> ids;
    for (int i = 0; i < 6; i++) {
        for (int j = 0; j < 6; j++) {
            if (s.grid[i][j] != 0) {
                ids.insert(s.grid[i][j]);
            }
        }
    }
    
    for (int id : ids) {
        // Determine orientation
        int r_min = 6, c_min = 6, r_max = -1, c_max = -1;
        for (int i = 0; i < 6; i++) {
            for (int j = 0; j < 6; j++) {
                if (s.grid[i][j] == id) {
                    r_min = min(r_min, i);
                    c_min = min(c_min, j);
                    r_max = max(r_max, i);
                    c_max = max(c_max, j);
                }
            }
        }
        
        bool horizontal = (r_min == r_max);
        
        if (horizontal) {
            if (can_move(s, id, 0, 1)) moves.push_back({id, {0, 1}};
            if (can_move(s, id, 0, -1)) moves.push_back({id, {0, -1}};
        } else {
            if (can_move(s, id, 1, 0)) moves.push_back({id, {1, 0}};
            if (can_move(s, id, -1, 0)) moves.push_back({id, {-1, 0}};
        }
    }
    return moves;
}

bool is_solved(const State& s) {
    // Red car (id=1) has exited if it's not on the board or at the exit position
    // The exit is at row 2 (0-indexed), right side. Car exits when its front is at col 5 and moves out.
    //We check if red car can move right from col 5 (which would be off board)
    
    // Find red car position
    int r = -1, c_min = 6, c_max = -1;
    for (int i = 0; i < 6; i++) {
        for (int j = 0; j < 6; j++) {
            if (s.grid[i][j] == 1) {
                r = (r == -1) ? i : r;
                c_min = min(c_min, j);
                c_max = max(c_max, j);
            }
        }
    }
    
    // If red car not on board, it's solved
    if (r == -1) return true;
    
    // If red car is at the exit (front at col 5), it can exit in one more move
    if (c_max == 5 && r == 2) return true;
    
    return false;
}

int solve_bfs(const State& start) {
    unordered_set<State, StateHash> visited;
    queue<pair<State, int>> q;
    
    visited.insert(start);
    q.push({start, 0});
    
    while (!q.empty()) {
        auto [curr, dist] = q.front();
        q.pop();
        
        if (is_solved(curr)) {
            return dist;
        }
        
        auto moves = get_all_moves(curr);
        for (auto [id, d] : moves) {
            State next = move_vehicle(curr, id, d.first, d.second);
            if (!visited.count(next)) {
                visited.insert(next);
                q.push({next, dist + 1};
            }
        }
    }
    
    return -1; // Should not happen
}

char dir_char(int dr, int dc) {
    if (dr == -1 && dc == 0) return 'U';
    if (dr == 1 && dc == 0) return 'D';
    if (dr == 0 && dc == -1) return 'L';
    if (dr == 0 && dc == 1) return 'R';
    return '?';
}

