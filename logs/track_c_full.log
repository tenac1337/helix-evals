    vector<int> perm(n, 0);
    vector<int> used(n + 1, 0);

    // Query to find frequency of each number
    // For each value v, query with all positions = v
    // The response tells us how many positions have value v
    for (int v = 1; v <= n; v++) {
        cout << 0 << " ";
        for (int i = 0; i < n; i++) {
