using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    if(!(cin >> n)) return 0;
    
    int low = 1, high = n;
    int questions_used = 0;
    const int MAX_QUESTIONS = 53;
    
    // Binary search with redundancy to handle noisy answers
    while (low < high && questions_used < MAX_QUESTIONS - 3) {
        int mid = low + (high - low) / 2;
        
        // Ask if x is in [low, mid]
        int k1 = mid - low + 1;
        cout << "? " << k1;
        for (int i = low; i <= mid; i++) {
            cout << " " << i;
        }
        cout << endl;
        cout.flush();
        questions_used++;
        
        string ans1;
        cin >> ans1;
        
        // Ask the same question again for redundancy
        // Since at least one of every two consecutive answers is correct,
        // if both agree we can trust them (both correct or both wrong, but we take the consensus)
        cout << "? " << k1;
        for (int i = low; i <= mid; i++) {
            cout << " " << i;
        }
        cout << endl;
        cout.flush();
        questions_used++;
        
        string ans2;
        cin >> ans2;
        
        if (ans1 == ans2) {
            // Both answers agree, use this direction
            if (ans1 == "YES") {
                // x is in [low, mid]
                high = mid;
            } else {
                // x is in [mid+1, high]
                low = mid + 1;
            }
        } else {
            // Answers disagree - need to resolve with a third question
            // Ask about a smaller subset to help break the tie
            int new_mid = low + (mid - low) / 2;
            int k2 = new_mid - low + 1;
            cout << "? " << k2;
            for (int i = low; i <= new_mid; i++) {
                cout << " " << i;
            }
            cout << endl;
            cout.flush();
            questions_used++;
            
            string ans3;
            cin >> ans3;
            
            // Use the third answer to decide
            if (ans3 == "YES") {
                high = mid;
            } else {
                low = mid + 1;
            }
        }
    }
    
    // Make first guess
    cout << "! " << low << endl;
    cout.flush();
    
    string result;
    cin >> result;
    
    if (result == ":)") {
        return 0;
    }
    
    // First guess was wrong, make second guess
    if (low < high) {
        cout << "! " << high << endl;
    } else if (low > 1) {
        cout << "! " << (low - 1) << endl;
    } else {
        cout << "! " << 2 << endl;
    }
    cout.flush();
    
    return 0;
}
