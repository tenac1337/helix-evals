using namespace std;

/**
 * Problem Analysis:
 * We need to find a circular permutation p1, p2, ..., pn.
 * We can flip the state of lamp holders. If the resulting set S contains 
 * adjacent lit holders on the ring, the system returns 1, otherwise 0.
 * 
 * Strategy:
 * 1. Use O(n) queries to find neighbors of 1.
 * 2. Traverse the ring from those neighbors.
 * 
 * Key optimization: Use exactly 2 queries per adjacency test:
 * - Query "2 u v": toggles u (making S empty if u was current), then toggles v.
 *   The second report tells us if {u, v} are adjacent.
 * - Query "1 v": toggles v to remove it from S, restoring S={u} for next test.
 * 
 * This halves the query count compared to the original approach.
 */

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int subtask, n;
    if (!(cin >> subtask >> n)) return 0;

    if (n == 2) {
        cout << "-1 1 2" << endl;
        return 0;
    }

    // Initialize S to contain 1
    cout << "1 1" << endl;
    int init_res;
    cin >> init_res;

    vector<int> neighbors_of_1;
    int first_neighbor = -1;

    // Find neighbors of 1
    for (int v = 2; v <= n; ++v) {
        // Test if 1 and v are adjacent
        cout << "2 1 " << v << endl;
        int r1, r2;
        cin >> r1 >> r2;
        
        if (r2 == 1) {
            neighbors_of_1.push_back(v);
            if (first_neighbor == -1) first_neighbor = v;
        }
        
        // Reset S to {1}
        cout << "1 " << v << endl;
        int r3;
        cin >> r3;
        
        if (neighbors_of_1.size() == 2) break;
    }

    // Reconstruct the ring
    vector<int> p;
    p.push_back(1);
    p.push_back(first_neighbor);
    
    vector<bool> visited(n + 1, false);
    visited[1] = true;
    visited[first_neighbor] = true;

    // Set current to first_neighbor, ensure S = {current}
    int current = first_neighbor;
    cout << "1 " << current << endl;
    int tmp;
    cin >> tmp;

    // Find the second neighbor of 1 to continue traversal
    int second_neighbor = -1;
    for (int v = 2; v <= n; ++v) {
        if (visited[v]) continue;
        
        cout << "2 1 " << v << endl;
        int r1, r2;
        cin >> r1 >> r2;
        
        if (r2 == 1) {
            second_neighbor = v;
        }
        
        cout << "1 " << v << endl;
        int r3;
        cin >> r3;
        
        if (second_neighbor != -1) break;
    }

    // Traverse from first_neighbor
    while (p.size() < (size_t)n) {
        bool found = false;
        for (int v = 1; v <= n; ++v) {
            if (visited[v]) continue;
            
            // Test if current and v are adjacent
            cout << "2 " << current << " " << v << endl;
            int r1, r2;
            cin >> r1 >> r2;
            
            if (r2 == 1) {
                // current and v are adjacent
                p.push_back(v);
                visited[v] = true;
                
                // Update current and ensure S = {new_current}
                current = v;
                cout << "1 " << current << endl;
                int r3;
                cin >> r3;
                
                found = true;
                break;
            }
            
            // Reset S to {current} for next test
            cout << "1 " << v << endl;
            int r3;
            cin >> r3;
        }
        if (!found) break;
    }

    cout << "-1";
    for (int i = 0; i < n; ++i) {
        cout << " " << p[i];
    }
    cout << endl;

    return 0;
