int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int t;
    if(!(cin >> t)) return 0;
    
    while (t--) {
        // Query 1: send 100000 words of length 1
        // This gives us ceil(100000 / W) lines, which tells us approximately what W is
        cout << "? 100000";
        for (int i = 0; i < 100000; i++) cout << " 1";
        cout << endl;
        
        int r1;
        cin >> r1;
        
        if (r1 == -1) return 0;
        
        // If r1 == 0, it means max(ai) > W, but since all ai = 1 and W >= 1, this shouldn't happen
        // unless there's an issue, but let's handle it
        
        // Determine the range of possible W values from first query
        // r1 = ceil(100000 / W), so W is in [ceil(100000 / r1), floor(100000 / (r1-1))]
        // For r1 = 1, W must be 100000
        // For r1 = 100000, W must be 1
        
        int minW, maxW;
        if (r1 == 1) {
            minW = maxW = 100000;
        } else if (r1 > 1) {
            minW = (100000 + r1 - 1) / r1;  // ceil(100000 / r1)
            maxW = 100000 / (r1 - 1);       // floor(100000 / (r1-1))
        } else {
            // r1 == 0 shouldn't happen with ai = 1, but handle it
            minW = 1;
            maxW = 100000;
        }
        
        // If we can determine W uniquely, output it
        if (minW == maxW) {
            cout << "! " << minW << endl;
            continue;
        }
        
        // Need second query to disambiguate
        // Choose a word length L between minW and maxW to differentiate
        // If we query with length L:
        // - If L <= W: we get 1 line (word fits)
        // - If L > W: we get 0 (word doesn't fit)
        
        int L = (minW + maxW) / 2;  // pick middle value
        
        cout << "? 1 " << L << endl;
        
        int r2;
        cin >> r2;
        
        if (r2 == -1) return 0;
        
        // If r2 == 1, then L <= W, so W >= L
        // If r2 == 0, then L > W, so W < L
        if (r2 == 1) {
            cout << "! " << max(minW, L) << endl;
        } else {
            cout << "! " << min(maxW, L - 1) << endl;
        }
    }
    
    return 0;
}
