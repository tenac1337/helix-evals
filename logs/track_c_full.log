        if(comp[i] == -1) {
            queue<int> q;
            q.push(i);
            comp[i] = numComp;
            while(!q.empty()) {
                int v = q.front(); q.pop();
                for(int u : adj[v]) {
                    if(comp[u] == -1) {
                        comp[u] = numComp;
                        q.push(u);
