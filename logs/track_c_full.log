    vector<int> idx(items.size());
    iota(idx.begin(), idx.end(), 0);
    sort(idx.begin(), idx.end(), [&](int a, int b) {
        double ra = (double)items[a].v / items[a].m;
        double rb = (double)items[b].v / items[b].m;
        return ra > rb;
    });
    
    long long curMass = 0, curVol = 0, curValue = 0;
    
    // Greedy: take as many as possible of each item type in order
    for (int i : idx) {
        const Item& it = items[i];
        if (it.m == 0 || it.l == 0) continue;  // avoid division by zero
        
        // Calculate how many we can take
        long long maxByMass = (MAX_MASS - curMass) / it.m;
        long long maxByVol = (MAX_VOL - curVol) / it.l;
        long long canTake = min({maxByMass, maxByVol, it.q});
        
        if (canTake > 0) {
            result[i] = canTake;
            curMass += canTake * it.m;
            curVol += canTake * it.l;
            curValue += canTake * it.v;
        }
    }
    
