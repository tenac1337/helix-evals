using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int si, sj;
    if (!(cin >> si >> sj)) return 0;
    
    const int N = 50;
    vector<vector<int>> tile(N, vector<int>(N));
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            cin >> tile[i][j];
        }
    }
    
    vector<vector<int>> val(N, vector<int>(N));
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            cin >> val[i][j];
        }
    }
    
    // Track visited tiles
    vector<vector<bool>> tile_used(N, vector<bool>(N, false));
    int current_i = si, current_j = sj;
    tile_used[current_i][current_j] = true; // starting tile is visited
    
    string moves;
    const int di[4] = {-1, 1, 0, 0};
    const int dj[4] = {0, 0, -1, 1};
    const char dir[4] = {'U', 'D', 'L', 'R'};
    
    // Greedy: always go to best adjacent unvisited tile
    while (true) {
        int best_i = -1, best_j = -1, best_val = -1;
        int best_dir = -1;
        
        for (int d = 0; d < 4; d++) {
            int ni = current_i + di[d];
            int nj = current_j + dj[d];
            
            if (ni < 0 || ni >= N || nj < 0 || nj >= N) continue;
            if (tile_used[ni][nj]) continue;
            
            // Pick tile with highest value sum
            int tile_val = 0;
            for (int ii = 0; ii < N; ii++) {
                for (int jj = 0; jj < N; jj++) {
                    if (tile[ii][jj] == tile[ni][nj]) {
                        tile_val += val[ii][jj];
                    }
                }
            }
            
            if (tile_val > best_val) {
                best_val = tile_val;
                best_i = ni;
                best_j = nj;
                best_dir = d;
            }
        }
        
        if (best_i == -1) break; // no valid moves
        
        // Mark all cells of the chosen tile as used
        int chosen_tile = tile[best_i][best_j];
        for (int ii = 0; ii < N; ii++) {
            for (int jj = 0; jj < N; jj++) {
                if (tile[ii][jj] == chosen_tile) {
                    tile_used[ii][jj] = true;
                }
            }
        }
        
        moves.push_back(dir[best_dir]);
        current_i = best_i;
        current_j = best_j;
    }
    
    cout << moves.size() << "\n";
    cout << moves << "\n";
    
    return 0;
}
