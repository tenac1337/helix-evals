This solution has an issue - O(n^4) substring counting which will be too slow for n=1000. Let me improve it:

```cpp
#include <bits/stdc++.h>
using namespace std;

// Use suffix automaton to count distinct substrings efficiently
struct SuffixAutomaton {
    struct State {
        int next[2];
        int link;
        int len;
        State() : link(-1), len(0) {
            next[0] = next[1] = -1;
        }
    };
    
    vector<State> st;
    int last;
    
    SuffixAutomaton(int maxlen = 0) {
        st.reserve(2 * maxlen);
        st.push_back(State());
        last = 0;
    }
    
    void extend(char c) {
        int cur = st.size();
        st.push_back(State());
        st[cur].len = st[last].len + 1;
        
        int p = last;
        int bit = (c == 'X') ? 0 : 1;
        
        while (p != -1 && st[p].next[bit] == -1) {
            st[p].next[bit] = cur;
            p = st[p].link;
        }
        
        if (p == -1) {
            st[cur].link = 0;
        } else {
            int q = st[p].next[bit];
            if (st[p].len + 1 == st[q].len) {
                st[cur].link = q;
            } else {
                int clone = st.size();
                st.push_back(st[q]);
                st[clone].len = st[p].len + 1;
                st[clone].link = st[q].link;
                
                while (p != -1 && st[p].next[bit] == q) {
                    st[p].next[bit] = clone;
                    p = st[p].link;
                }
                st[q].link = st[cur].link = clone;
            }
        }
        last = cur;
    }
    
    long long distinctSubstrings() {
        long long total = 0;
        for (int i = 1; i < st.size(); i++) {
            total += st[i].len - st[st[i].link].len;
        }
        return total;
    }
};

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
