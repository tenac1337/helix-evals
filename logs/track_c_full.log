using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    // Initialize edge weights
    vector<vector<double>> horizontal_edges(30, vector<double>(29, 1.0));
    vector<vector<double>> vertical_edges(29, vector<double>(30, 1.0));

    for (int k = 0; k < 1000; k++) {
        int si, sj, ti, tj;
        cin >> si >> sj >> ti >> tj;

        // Dijkstra's algorithm to find the shortest path
        vector<vector<double>> dist(30, vector<double>(30, 1e18));
        vector<pair<int, int>> parent(30, make_pair(-1, -1));
        priority_queue<pair<double, pair<int, int>>, 
                      vector<pair<double, pair<int, int>>>, 
                      greater<pair<double, pair<int, int>>>> pq;

        dist[si][sj] = 0.0;
        pq.push({0.0, {si, sj}});

        while (!pq.empty()) {
            auto [d, node] = pq.top(); pq.pop();
            int i = node.first, j = node.second;
            if (d != dist[i][j]) continue;
            if (i == ti && j == tj) break;

            vector<pair<int, int>> neighbors;
            if (i > 0) neighbors.push_back({i-1, j});
            if (i < 29) neighbors.push_back({i+1, j});
            if (j > 0) neighbors.push_back({i, j-1});
            if (j < 29) neighbors.push_back({i, j+1});

            for (auto [ni, nj] : neighbors) {
                double cost;
                if (ni == i-1) {
                    cost = vertical_edges[ni][j];
                } else if (ni == i+1) {
                    cost = vertical_edges[i][j];
                } else if (nj == j-1) {
                    cost = horizontal_edges[i][nj];
                } else {
                    cost = horizontal_edges[i][j];
                }

                double new_d = d + cost;
                if (new_d < dist[ni][nj]) {
                    dist[ni][nj] = new_d;
                    parent[ni][nj] = {i, j};
                    pq.push({new_d, {ni, nj}});
                }
            }
        }

        // Reconstruct path and collect edge pointers
        string path_str;
        vector<double*> edges_to_update;
        int ci = ti, cj = tj;
        while (ci != si || cj != sj) {
            int pi = parent[ci][cj].first;
            int pj = parent[ci][cj].second;
            if (ci == pi+1) {
                path_str += 'D';
                edges_to_update.push_back(&vertical_edges[pi][pj]);
            } else if (ci == pi-1) {
                path_str += 'U';
                edges_to_update.push_back(&vertical_edges[ci][pj]);
            } else if (cj == pj+1) {
                path_str += 'R';
                edges_to_update.push_back(&horizontal_edges[pi][pj]);
            } else if (cj == pj-1) {
                path_str += 'L';
                edges_to_update.push_back(&horizontal_edges[pi][cj]);
            }
            ci = pi;
            cj = pj;
        }
        reverse(path_str.begin(), path_str.end());

        // Output path
        cout << path_str << endl;
        cout.flush();

        // Read feedback
        int T;
        cin >> T;

        int L = path_str.length();
        double new_avg = static_cast<double>(T) / L;

        // Update edge weights using exponential moving average
        for (auto edge_ptr : edges_to_update) {
            *edge_ptr = (*edge_ptr * k + new_avg) / (k + 1);
        }
    }

    return 0;
}

