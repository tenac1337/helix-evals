using namespace std;

struct Item {
    string name;
    long long q;  // quantity
    long long v;  // value
    long long m;  // mass in mg
    long long l;  // volume in microliters
};

long long MASS_LIMIT = 20000000;  // 20 kg = 20 million mg
long long VOL_LIMIT = 25000000;   // 25 liters = 25 million microliters

// Parse JSON input
vector<Item> parseInput() {
    string all, line;
    while (getline(cin, line)) {
        all += line + "\n";
    }
    
    vector<Item> items;
    size_t pos = 0;
    
    while (pos < all.size()) {
        // Find key (string followed by colon)
        while (pos < all.size() && all[pos] != '"') pos++;
        if (pos >= all.size()) break;
        pos++; // skip opening quote
        
        size_t end = all.find('"', pos);
        string key = all.substr(pos, end - pos);
        pos = end + 1;
        
        // Skip colon
        while (pos < all.size() && (all[pos] == ':' || all[pos] == ' ')) pos++;
        
        // Find array start
        while (pos < all.size() && all[pos] != '[') pos++;
        if (pos >= all.size()) break;
        pos++; // skip '['
        
        // Parse 4 integers
        vector<long long> nums;
        while (pos < all.size() && all[pos] != ']') {
            // Skip whitespace and commas
            while (pos < all.size() && (all[pos] == ' ' || all[pos] == ',' || all[pos] == '\n' || all[pos] == '\r' || all[pos] == '\t')) pos++;
            if (pos >= all.size() || all[pos] == ']') break;
            
            // Parse number
            long long num = 0;
            while (pos < all.size() && isdigit(all[pos])) {
                num = num * 10 + (all[pos] - '0');
                pos++;
            }
            nums.push_back(num);
        }
        
        if (nums.size() >= 4) {
            Item it;
            it.name = key;
            it.q = nums[0];
            it.v = nums[1];
            it.m = nums[2];
            it.l = nums[3];
            items.push_back(it);
        }
        
        pos = all.find(']', pos) + 1;
    }
    
    return items;
}

// DFS with branch and bound
void dfs(int idx, const vector<Item>& items, long long currMass, long long currVol, long long currVal,
         vector<long long>& chosen, vector<long long>& best, long long& bestVal,
         long long remainingMass, long long remainingVol) {
    
    if (idx == (int)items.size()) {
        if (currVal > bestVal) {
            bestVal = currVal;
            best = chosen;
        }
        return;
    }
    
    // Upper bound: assume we can take all remaining items
    long long upperBound = currVal;
    for (size_t i = idx; i < items.size(); i++) {
        const Item& it = items[i];
        long long maxTake = min(it.q, min(remainingMass / max(1LL, it.m), remainingVol / max(1LL, it.l)));
        upperBound += maxTake * it.v;
    }
    
    if (upperBound <= bestVal) {
        return; // Prune
    }
    
    const Item& it = items[idx];
    
    // Try taking 0 of this item
    chosen[idx] = 0;
    dfs(idx + 1, items, currMass, currVol, currVal, chosen, best, bestVal, remainingMass, remainingVol);
    
    // Try taking items of this type (binary decomposition for efficiency)
    long long maxTake = min(it.q, min(remainingMass / max(1LL, it.m), remainingVol / max(1LL, it.l)));
    
    // Use binary decomposition: break into powers of 2
    long long powers[20];
    int powCount = 0;
    long long remaining = maxTake;
    long long p = 1;
    while (remaining > 0) {
        long long take = min(p, remaining);
        powers[powCount++] = take;
        remaining -= take;
        p *= 2;
    }
    
    // Try different amounts using binary decomposition
    for (int j = 0; j < (1 << powCount); j++) {
        long long totalTake = 0;
        long long massAdd = 0, volAdd = 0, valAdd = 0;
        
        for (int k = 0; k < powCount; k++) {
            if (j & (1 << k)) {
                totalTake += powers[k];
                massAdd += powers[k] * it.m;
                valAdd += powers[k] * it.v;
                volAdd += powers[k] * it.l;
            }
        }
        
        if (totalTake == 0) continue;
        if (massAdd > remainingMass || volAdd > remainingVol) continue;
        
        chosen[idx] = totalTake;
        dfs(idx + 1, items, currMass + massAdd, currVol + volAdd, currVal + valAdd,
            chosen, best, bestVal, remainingMass - massAdd, remainingVol - volAdd);
    }
}

// Greedy by value/(mass+volume) ratio
vector<long long> greedySolve(const vector<Item>& items) {
    vector<pair<pair<double, long long>, int>> sorted;
    for (int i = 0; i < (int)items.size(); i++) {
        double ratio = (double)items[i].v / (items[i].m + items[i].l);
        sorted.push_back({{ratio, -items[i].v}, i});
    }
    sort(sorted.rbegin(), sorted.rend()); // descending by ratio
    
    vector<long long> result(items.size(), 0);
    long long mass = 0, vol = 0;
    
    for (auto& p : sorted) {
        int idx = p.second;
        const Item& it = items[idx];
        long long canTake = min(it.q, min((MASS_LIMIT - mass) / max(1LL, it.m), (VOL_LIMIT - vol) / max(1LL, it.l)));
        result[idx] = canTake;
        mass += canTake * it.m;
        vol += canTake * it.l;
    }
    
    return result;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    vector<Item> items = parseInput();
    
    if (items.empty()) {
        cout << "{}" << endl;
        return 0;
    }
    
    // Sort items by value density (value / (mass + volume)) for better branch and bound
    vector<pair<double, int>> sorted;
    for (int i = 0; i < (int)items.size(); i++) {
        double ratio = (double)items[i].v / (items[i].m + items[i].l);
        sorted.push_back({ratio, i};
    }
    sort(sorted.rbegin(), sorted.rend());
    
    // Reorder items
    vector<Item> orderedItems;
    vector<string> nameOrder;
    for (auto& p : sorted) {
        orderedItems.push_back(items[p.second]);
        nameOrder.push_back(items[p.second].name);
    }
    
    // Try greedy first to get initial bound
    vector<long long> greedyResult(items.size(), 0);
    long long greedyMass = 0, greedyVol = 0, greedyVal = 0;
    
    // Map back to original indices
    vector<long long> greedyOrdered(orderedItems.size(), 0);
    long long gMass = 0, gVol = 0;
    for (size_t i = 0; i < orderedItems.size(); i++) {
        const Item& it = orderedItems[i];
        long long canTake = min(it.q, min((MASS_LIMIT - gMass) / max(1LL, it.m), (VOL_LIMIT - gVol) / max(1LL, it.l)));
        greedyOrdered[i] = canTake;
        gMass += canTake * it.m;
        gVol += canTake * it.l;
        greedyVal += canTake * it.v;
    }
    
    // Convert greedyOrdered back to original indices
    for (size_t i = 0; i < orderedItems.size(); i++) {
        // Find original index
        for (size_t j = 0; j < items.size(); j++) {
            if (items[j].name == orderedItems[i].name) {
                greedyResult[j] = greedyOrdered[i];
                break;
            }
        }
    }
    
    // Now run DFS with branch and bound
    vector<long long> chosen(orderedItems.size(), 0);
    vector<long long> best(orderedItems.size(), 0);
    long long bestVal = greedyVal;
    best = greedyOrdered;
    
    dfs(0, orderedItems, 0, 0, 0, chosen, best, bestVal, MASS_LIMIT, VOL_LIMIT);
    
    // Convert best to original order
    vector<long long> finalResult(items.size(), 0);
    for (size_t i = 0; i < orderedItems.size(); i++) {
        for (size_t j = 0; j < items.size(); j++) {
            if (items[j].name == orderedItems[i].name) {
                finalResult[j] = best[i];
                break;
            }
        }
    }
    
    // Output JSON
    cout << "{";
    for (size_t i = 0; i < items.size(); i++) {
        if (i > 0) cout << ",";
        cout << "\"" << items[i].name << "\":";
        cout << finalResult[i];
    }
    cout << "}" << endl;
    
    return 0;
}
