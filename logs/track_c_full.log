using namespace std;

struct Item {
    string name;
    long long q;      // quantity available
    long long v;     // value per item
    long long m;     // mass per item
    long long l;     // volume per item
};

const long long MAX_MASS = 20000000LL;  // 20 kg in mg
const long long MAX_VOL = 25000000LL;   // 25 liters in ul

vector<Item> items;
vector<long long> bestQty;
long long bestValue = 0;

// Parse JSON input manually
void parseInput() {
    string all, line;
    while (getline(cin, line)) {
        all += line;
        all += '\n';
    }
    
    size_t pos = 0;
    // Skip opening brace
    while (pos < all.size() && all[pos] != '{') pos++;
    if (pos < all.size()) pos++;
    
    while (pos < all.size()) {
        // Skip whitespace
        while (pos < all.size() && (all[pos] == ' ' || all[pos] == '\n' || all[pos] == '\r' || all[pos] == '\t')) pos++;
        if (pos >= all.size() || all[pos] == '}') break;
        
        // Parse key (category name)
