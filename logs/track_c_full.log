using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int si, sj;
    if (!(cin >> si >> sj)) return 0;
    
    const int N = 50;
    vector<vector<int>> tile(N, vector<int>(N));
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            cin >> tile[i][j];
        }
    }
    
    vector<vector<int>> val(N, vector<int>(N));
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            cin >> val[i][j];
        }
    }
    
    // Find number of tiles and map tile id to cells
    int maxTileId = 0;
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            maxTileId = max(maxTileId, tile[i][j]);
        }
    }
    int M = maxTileId + 1;
    
    // Compute tile values (sum of cell values in each tile)
    vector<int> tileValue(M, 0);
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            tileValue[tile[i][j]] += val[i][j];
        }
    }
    
    // Find which tile contains starting position
    int startTile = tile[si][sj];
    
    // Build adjacency between tiles
    vector<vector<int>> adj(M);
    vector<vector<int>> tilePos(M); // one representative position per tile
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            int t = tile[i][j];
            if (tilePos[t].empty()) {
                tilePos[t] = {i, j};
            }
            // Check 4 directions
            if (i > 0 && tile[i-1][j] != t) {
                adj[t].push_back(tile[i-1][j]);
                adj[tile[i-1][j]].push_back(t);
            }
            if (j > 0 && tile[i][j-1] != t) {
                adj[t].push_back(tile[i][j-1]);
                adj[tile[i][j-1]].push_back(t);
            }
        }
    }
    
    // Remove duplicates in adjacency
    for (int i = 0; i < M; i++) {
        sort(adj[i].begin(), adj[i].end());
        adj[i].erase(unique(adj[i].begin(), adj[i].end()), adj[i].end());
    }
    
    // Greedy DFS to find a long path
    vector<int> bestPath;
    int bestScore = 0;
    
    function<void(int, vector<int>&, vector<char>&, int)> dfs = 
        [&](int curr, vector<int>& path, vector<char>& moves, int score) {
            if (score > bestScore) {
                bestScore = score;
                bestPath = path;
            }
            
            // Limit depth to avoid infinite recursion
            if (path.size() >= 2500) return;
            
            for (int next : adj[curr]) {
                if (find(path.begin(), path.end(), next) == path.end()) {
                    // Determine move direction
                    int ci = tilePos[curr][0], cj = tilePos[curr][1];
                    int ni = tilePos[next][0], nj = tilePos[next][1];
                    char move = 0;
                    if (ni < ci) move = 'U';
                    else if (ni > ci) move = 'D';
                    else if (nj < cj) move = 'L';
                    else if (nj > cj) move = 'R';
                    
                    path.push_back(next);
                    moves.push_back(move);
                    dfs(next, path, moves, score + tileValue[next]);
                    moves.pop_back();
                    path.pop_back();
                }
            }
        };
    
    vector<int> path = {startTile};
    vector<char> moves;
    dfs(startTile, path, moves, tileValue[startTile]);
    
    // Output the path
    cout << moves.size() << "\n";
    for (char m : moves) {
        cout << m << "\n";
    }
    
    return 0;
}
