using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    const int N = 30;
    const int di[4] = {-1, 1, 0, 0};  // U, D, L, R
    const int dj[4] = {0, 0, -1, 1};
    const char dc[4] = {'U', 'D', 'L', 'R'};
    
    for (int query = 0; query < 1000; query++) {
        int si, sj, ti, tj;
        if (!(cin >> si >> sj >> ti >> tj)) break;
        
        // BFS to find shortest path
        vector<vector<int>> dist(N, vector<int>(N, -1));
        vector<vector<pair<int,int>>> par(N, vector<pair<int,int>>(N, {-1, -1}));
        queue<pair<int,int>> q;
        
        dist[si][sj] = 0;
        q.emplace(si, sj);
        
        while (!q.empty()) {
            auto [i, j] = q.front(); q.pop();
            if (i == ti && j == tj) break;
            
            for (int d = 0; d < 4; d++) {
                int ni = i + di[d];
                int nj = j + dj[d];
                if (ni >= 0 && ni < N && nj >= 0 && nj < N && dist[ni][nj] == -1) {
                    dist[ni][nj] = dist[i][j] + 1;
                    par[ni][nj] = {i, j};
                    q.emplace(ni, nj);
                }
            }
        }
        
        // Reconstruct path from target back to source
        string path;
        int ci = ti, cj = tj;
        while (!(ci == si && cj == sj)) {
            auto [pi, pj] = par[ci][cj];
            if (pi == -1) break;  // Should not happen in connected grid
            // Determine direction from parent to child (reverse of movement)
            if (pi < ci) path.push_back('U');      // parent is above -> moved down to child
            else if (pi > ci) path.push_back('D'); // parent is below -> moved up to child
            else if (pj < cj) path.push_back('L'); // parent is left -> moved right to child
            else path.push_back('R');             // parent is right -> moved left to child
            ci = pi; cj = pj;
        }
        reverse(path.begin(), path.end());
        
        cout << path << "\n";
        cout.flush();
        
        // Read feedback (path length with noise)
        long long feedback;
        cin >> feedback;
    }
    
    return 0;
}
