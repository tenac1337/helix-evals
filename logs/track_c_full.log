using namespace std;

struct Piece {
    vector<pair<int,int>> cells;
};

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    if(!(cin >> n)) return 0;
    
    vector<Piece> pieces(n);
    long long total_cells = 0;
    
    for(int i = 0; i < n; i++) {
        int k;
        cin >> k;
        pieces[i].cells.resize(k);
        total_cells += k;
        
        for(int j = 0; j < k; j++) {
            int x, y;
            cin >> x >> y;
            pieces[i].cells[j] = {x, y};
        }
    }
    
    // Transform piece: reflection (across y-axis), then rotation (0,90,180,270), then normalize
    auto transform = [&](const Piece& piece, int rot, int refl) {
        vector<pair<int,int>> transformed;
        int min_x = INT_MAX, min_y = INT_MAX;
        
        for(auto [x, y] : piece.cells) {
            // Apply reflection across y-axis
            if(refl) x = -x;
            
            // Apply rotation (0=0°, 1=90°, 2=180°, 3=270° clockwise)
            int nx = x, ny = y;
            for(int r = 0; r < rot; r++) {
                int tmp = nx;
                nx = ny;
                ny = -tmp;
            }
            
            min_x = min(min_x, nx);
            min_y = min(min_y, ny);
            transformed.push_back({nx, ny};
        }
        
        // Normalize to start at (0,0)
        for(auto& p : transformed) {
            p.first -= min_x;
            p.second -= min_y;
        }
        
        return transformed;
    };
    
    // Try increasing rectangle sizes
    long long W = 1, H = total_cells;
    
    // Find minimal area rectangle
    while(true) {
        // Grid: grid[y][x] = piece index or -1
        vector<vector<int>> grid(H, vector<int>(W, -1));
        
        vector<pair<int,int>> pos(n);
        vector<int> rot(n), refl(n);
        
        // Sort pieces by size (largest first)
        vector<int> order(n);
        iota(order.begin(), order.end(), 0);
        sort(order.begin(), order.end(), [&](int a, int b) {
            return pieces[a].cells.size() > pieces[b].cells.size();
        });
        
        bool all_placed = true;
        
        for(int idx : order) {
            bool placed = false;
            
            for(int py = 0; py < H && !placed; py++) {
                for(int px = 0; px < W && !placed; px++) {
                    for(int r = 0; r < 4 && !placed; r++) {
                        for(int f = 0; f < 2 && !placed; f++) {
                            auto cells = transform(pieces[idx], r, f);
                            
                            // Check bounds and overlap
                            bool ok = true;
                            for(auto [cx, cy] : cells) {
                                int gx = px + cx;
                                int gy = py + cy;
                                if(gx < 0 || gx >= W || gy < 0 || gy >= H) {
                                    ok = false;
                                    break;
                                }
                                if(grid[gy][gx] != -1) {
                                    ok = false;
                                    break;
                                }
                            }
                            
                            if(ok) {
                                // Place the piece
                                for(auto [cx, cy] : cells) {
                                    grid[py + cy][px + cx] = idx;
                                }
                                pos[idx] = {px, py};
                                rot[idx] = r;
                                refl[idx] = f;
                                placed = true;
                            }
                        }
                    }
                }
            }
            
            if(!placed) {
                all_placed = false;
                break;
            }
        }
        
        if(all_placed) {
            // Output result
            cout << W << " " << H << "\n";
            for(int i = 0; i < n; i++) {
                cout << pos[i].first << " " << pos[i].second << " " << rot[i] << " " << refl[i] << "\n";
            }
            return 0;
        }
        
        // Increase rectangle size
        if(W * (H + 1) <= (W + 1) * H) {
            H++;
        } else {
            W++;
            H = (total_cells + W - 1) / W;
            if(H < 1) H = 1;
        }
        
        // Safety limit
        if(W > 10000) break;
    }
    
    // Fallback: just output a simple valid solution
    W = total_cells;
    H = 1;
    cout << W << " " << H << "\n";
    int cx = 0;
    for(int i = 0; i < n; i++) {
        cout << cx << " 0 0 0\n";
        cx += pieces[i].cells.size();
    }
    
    return 0;
