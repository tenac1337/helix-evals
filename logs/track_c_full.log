using namespace std;

struct Item {
    string name;
    long long q;
    long long v;
    long long m;
    long long l;
    double density; // value per unit mass+volume
};

long long MASS_LIMIT = 20000000LL; // 20 kg in mg
long long VOLUME_LIMIT = 25000000LL; // 25 liters in microliters

vector<Item> items;
unordered_map<string, int> name_to_idx;
vector<int> best_choice;
long long best_value = 0;

void dfs(int idx, long long cur_mass, long long cur_volume, long long cur_value, vector<int>& choice) {
    if (idx == (int)items.size()) {
        if (cur_value > best_value) {
            best_value = cur_value;
            best_choice = choice;
        }
        return;
    }
    
    // Pruning: if we cannot beat best even taking all remaining
    long long max_possible = cur_value;
    for (int i = idx; i < (int)items.size(); i++) {
        max_possible += items[i].v * items[i].q;
    }
    if (max_possible <= best_value) return;
    
    const Item& it = items[idx];
    
    // Try different quantities from 0 to q
    // Early termination: if adding more would exceed limits
    for (int cnt = 0; cnt <= it.q; cnt++) {
        long long new_mass = cur_mass + cnt * it.m;
        long long new_volume = cur_volume + cnt * it.l;
        
        if (new_mass > MASS_LIMIT || new_volume > VOLUME_LIMIT) break;
        
        choice[idx] = cnt;
        dfs(idx + 1, new_mass, new_volume, cur_value + cnt * it.v, choice);
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    // Read entire input
    string input((istreambuf_iterator<char>(cin)), istreambuf_iterator<char>());
    
    // Simple JSON parsing
    // Format: {"key": [q, v, m, l], ...}
    vector<string> keys;
    vector<array<long long, 4>> values;
    
    size_t pos = 0;
    while (pos < input.size()) {
        // Find key
        size_t key_start = input.find('"', pos);
        if (key_start == string::npos) break;
        size_t key_end = input.find('"', key_start + 1);
        string key = input.substr(key_start + 1, key_end - key_start - 1);
        
        // Find array
        size_t arr_start = input.find('[', key_end);
        size_t arr_end = input.find(']', arr_start);
        string nums = input.substr(arr_start + 1, arr_end - arr_start - 1);
        
        // Parse 4 numbers
        stringstream ss(nums);
        array<long long, 4> arr;
        char comma;
        ss >> arr[0];
        ss >> comma >> arr[1] >> comma >> arr[2] >> comma >> arr[3];
        
        keys.push_back(key);
        values.push_back(arr);
        
        pos = arr_end + 1;
    }
    
    // Build items
    int n = keys.size();
    items.resize(n);
    for (int i = 0; i < n; i++) {
        items[i].name = keys[i];
        items[i].q = values[i][0];
        items[i].v = values[i][1];
        items[i].m = values[i][2];
        items[i].l = values[i][3];
        // Use value/(mass+volume) as density heuristic for sorting
        items[i].density = (double)items[i].v / (items[i].m + items[i].l);
        name_to_idx[keys[i]] = i;
    }
    
    // Sort by density descending for better pruning
    vector<int> order(n);
    iota(order.begin(), order.end(), 0);
    sort(order.begin(), order.end(), [&](int a, int b) {
        return items[a].density > items[b].density;
    });
    
    // Reorder items
    vector<Item> sorted_items(n);
    for (int i = 0; i < n; i++) {
        sorted_items[i] = items[order[i]];
    }
    items = sorted_items;
    
    // Update name_to_idx for reordered items
    for (int i = 0; i < n; i++) {
        name_to_idx[items[i].name] = i;
    }
    
    // Initialize
    vector<int> choice(n, 0);
    best_value = 0;
    best_choice.resize(n, 0);
    
    // Run DFS
    dfs(0, 0, 0, 0, choice);
    
    // Output JSON
    cout << "{";
    for (int i = 0; i < n; i++) {
        if (i > 0) cout << ",";
        cout << "\"" << items[i].name << "\": " << best_choice[i];
    }
    cout << "}";
    
    return 0;
}
