using namespace std;

/**
 * Problem Analysis:
 * We need to find a circular permutation p1, p2, ..., pn.
 * We can flip the state of lamp holders. If the resulting set S contains 
 * adjacent holders on the ring, the system returns 1, otherwise 0.
 * 
 * Strategy:
 * 1. Find neighbors of element 1.
 * 2. Traverse the ring from both neighbors to reconstruct the full permutation.
 * 
 * To test if {u, v} are adjacent:
 * - Query: L=2, {u, v}
 * - Result: [r1, r2] where r2=1 iff u and v are adjacent
 * - Reset: Query: L=2, {v, u} to empty S
 */

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int subtask, n;
    if (!(cin >> subtask >> n)) return 0;

    if (n == 2) {
        cout << "-1 1 2" << endl;
        return 0;
    }

    if (n == 1) {
        cout << "-1 1" << endl;
        return 0;
    }

    vector<int> neighbors_of_1;

    // Find neighbors of 1
    for (int v = 2; v <= n; ++v) {
        // Query: flip 1, then flip v
        cout << "2 1 " << v << endl;
        cout.flush();
        
        int r1, r2;
        cin >> r1 >> r2;
        
        if (r2 == 1) {
            neighbors_of_1.push_back(v);
        }
        
        // Reset S to empty by flipping v, then flipping 1
        cout << "2 " << v << " 1" << endl;
        cout.flush();
        
        int r3, r4;
        cin >> r3 >> r4;
        
        if (neighbors_of_1.size() == 2) break;
    }

    // Ensure we found exactly 2 neighbors
    if (neighbors_of_1.size() != 2) {
        // This should not happen for valid input
        // But handle gracefully by continuing with what we have
    }

    int left = neighbors_of_1[0];
    int right = neighbors_of_1[1];

    // Build permutation starting from 1
    vector<int> p;
    p.push_back(1);
    
    vector<bool> visited(n + 1, false);
    visited[1] = true;

    // Traverse in one direction (left)
    int current = left;
    while (current != 1) {
        p.push_back(current);
        visited[current] = true;
        
        // Find next neighbor of current that isn't the previous node
        int prev = p[p.size() - 2];
        
        bool found = false;
        for (int v = 1; v <= n; ++v) {
            if (visited[v] || v == prev) continue;
            
            // Check if current and v are adjacent
            cout << "2 " << current << " " << v << endl;
            cout.flush();
            
            int r1, r2;
            cin >> r1 >> r2;
            
            // Reset S
            cout << "2 " << v << " " << current << endl;
            cout.flush();
            
            int r3, r4;
            cin >> r3 >> r4;
            
            if (r2 == 1) {
                current = v;
                found = true;
                break;
            }
        }
        if (!found) break;
    }

    // Traverse in the other direction (right)
    current = right;
    vector<int> rightBranch;
    while (current != 1) {
        rightBranch.push_back(current);
        visited[current] = true;
        
        // Find next neighbor that isn't the previous node
        int prev = (rightBranch.size() == 1) ? 1 : rightBranch[rightBranch.size() - 2];
        
        bool found = false;
        for (int v = 1; v <= n; ++v) {
            if (visited[v] || v == prev) continue;
            
            // Check if current and v are adjacent
            cout << "2 " << current << " " << v << endl;
            cout.flush();
            
            int r1, r2;
            cin >> r1 >> r2;
            
            // Reset S
            cout << "2 " << v << " " << current << endl;
            cout.flush();
            
            int r3, r4;
            cin >> r3 >> r4;
            
            if (r2 == 1) {
                current = v;
                found = true;
                break;
            }
        }
        if (!found) break;
    }

    // Append right branch in reverse (since we traversed from 1 outward)
    for (int i = rightBranch.size() - 1; i >= 0; --i) {
        p.push_back(rightBranch[i]);
    }

    // If we haven't found all elements, try alternative traversal
    if (p.size() < (size_t)n) {
        p.clear();
        visited.assign(n + 1, false);
        
        // Start fresh: build from 1 in both directions
        p.push_back(1);
        visited[1] = true;
        
        // Go left
        current = left;
        while (true) {
            p.push_back(current);
            visited[current] = true;
            
            if (p.size() == n) break;
            
