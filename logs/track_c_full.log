using namespace std;

struct SuffixAutomaton {
    struct State {
        int next[2];
        int link;
        int len;
        long long occ; // number of end positions
        long long subs; // number of distinct substrings
        State() : next{-1, -1}, link(-1), len(0), occ(0), subs(0) {}
    };
    vector<State> st;
    int last;
    
    SuffixAutomaton(int maxlen = 0) {
        st.reserve(2 * maxlen + 5);
        st.push_back(State());
        st[0].len = 0;
        st[0].link = -1;
        last = 0;
    }
    
    void extend(char c) {
        int cur = st.size();
        st.push_back(State());
        st[cur].len = st[last].len + 1;
        st[cur].occ = 1;
        
        int p = last;
        int ch = c - 'A'; // map X->'X'-'A'=23, O->'O'-'A'=14... wait
        
        // Let's use 0/1
        ch = (c == 'X') ? 0 : 1;
        
        while (p != -1 && st[p].next[ch] == -1) {
            st[p].next[ch] = cur;
            p = st[p].link;
        }
        if (p == -1) {
            st[cur].link = 0;
        } else {
            int q = st[p].next[ch];
            if (st[p].len + 1 == st[q].len) {
                st[cur].link = q;
            } else {
                int clone = st.size();
                st.push_back(st[q]);
                st[clone].len = st[p].len + 1;
                st[clone].occ = 0;
                while (p != -1 && st[p].next[ch] == q) {
                    st[p].next[ch] = clone;
                    p = st[p].link;
                }
                st[q].link = st[cur].link = clone;
            }
        }
        last = cur;
    }
    
    long long countDistinctSubstrings() {
        long long total = 0;
        for (int i = 1; i < (int)st.size(); i++) {
            total += st[i].len - st[st[i].link].len;
        }
        return total;
    }
    
    static SuffixAutomaton build(const string& s) {
        SuffixAutomaton sa(s.length());
        for (char c : s) {
            sa.extend(c);
        }
        return sa;
    }
};

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    if (!(cin >> n)) return 0;
    
    // Generate words using a systematic approach
    // We'll use powers of 2 lengths plus some structure to ensure uniqueness
    vector<string> words;
    words.reserve(n);
    
    // Strategy: Use words that are prefixes of a de Bruijn-like sequence
    // This ensures good distribution of substrings
    // For binary alphabet, use all-ones patterns with increasing lengths
    
    // Use increasing lengths: 1, 2, 3, ..., up to n (or close)
    // With binary strings, we need to ensure distinct substrings
    // Use pattern: X, XX, XXX, ... then O, OO, OOO...
    
    // Actually, let's use a de Bruijn sequence approach
    // Generate a sequence with good coverage
    string base;
    // Create base sequence with both characters well distributed
    for (int i = 0; i < 30 * n; i++) {
        base += (i % 2 == 0) ? 'X' : 'O';
    }
    
    // Now create words of different lengths from this base
    // Use geometric lengths to minimize collisions: 1, 2, 4, 8, ...
    int len = 1;
    int pos = 0;
    for (int i = 0; i < n; i++) {
        if (pos + len > (int)base.length()) {
            // Extend base or wrap
            base += (base[pos % base.length()] == 'X') ? 'O' : 'X';
        }
        string w = base.substr(pos % base.length(), min(len, (int)base.length()));
        // Make sure it's distinct
        while ((int)w.length() < len) {
            w += base[(pos + w.length()) % base.length()];
        }
        words.push_back(w);
        pos = (pos + len * 7) % (base.length() + 100); // different offsets
        len = min(len * 2 + 1, 30 * n); // geometric growth
    }
    
    // Ensure all words are distinct and fix length constraints
    for (int i = 0; i < n; i++) {
        if (words[i].empty() || words[i].length() > 30 * n) {
            // Regenerate
            int l = i + 1;
            string w;
            for (int j = 0; j < l; j++) {
                w += (j % 2 == 0) ? 'X' : 'O';
            }
            words[i] = w;
        }
    }
    
    // Make them truly distinct by adding unique suffixes
    for (int i = 0; i < n; i++) {
        bool unique = true;
        for (int j = 0; j < i; j++) {
            if (words[i] == words[j]) {
                unique = false;
                break;
            }
        }
        if (!unique) {
            // Add distinguishing character
            words[i] += (i % 2 == 0) ? 'X' : 'O';
        }
    }
    
    // Output words
    for (const string& w : words) {
        cout << w << "\n";
    }
    cout.flush();
    
    // Precompute all pair powers and build reverse map
    unordered_map<long long, pair<int,int>> powerToPair;
    powerToPair.reserve(n * n * 2);
    
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            string concat = words[i] + words[j];
            SuffixAutomaton sa = SuffixAutomaton::build(concat);
            long long power = sa.countDistinctSubstrings();
            powerToPair[power] = {i+1, j+1}; // 1-indexed
        }
    }
    
    // Now handle queries
    int q;
    cin >> q;
    for (int qi = 0; qi < q; qi++) {
        long long p;
        cin >> p;
        auto it = powerToPair.find(p);
        if (it != powerToPair.end()) {
            cout << it->second.first << " " << it->second.second << "\n";
        } else {
            // Fallback: output something (shouldn't happen if all powers are in map)
            cout << 1 << " " << 1 << "\n";
        }
        cout.flush();
    }
    
    return 0;
}
