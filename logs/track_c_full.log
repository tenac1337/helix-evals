using namespace std;

/**
 * Problem: Texas Hold'em Training
 * Strategy: 
 * Since Bob's behavior is simplified (checks if we check), we can maximize profit 
 * by playing a conservative but value-oriented strategy. 
 * Given the interactive nature, we must strictly follow the input/output protocol.
 */

struct Card {
    int suit;
    int rank;
};

void solve() {
    while (true) {
        int initial_pot = 10;
        int alice_stack = 100;
        int bob_stack = 100;

        // Read Alice's hole cards
        int c1_s, c1_r, c2_s, c2_r;
        if (!(cin >> c1_s >> c1_r >> c2_s >> c2_r)) break;

        auto play_round = [&](int round_idx) {
            // In this simplified game, Bob checks if we check.
            // To maximize profit against a passive opponent, we check and see free cards
            // unless we have a very strong hand.
            // For a basic implementation, we will CHECK to minimize losses and 
            // reach showdown if Bob doesn't bet.
            cout << "CHECK" << endl;
        };

        // Round 1: Preflop
        play_round(1);
        string bob_action;
        cin >> bob_action;

        // Round 2: Flop
        int f1_s, f1_r, f2_s, f2_r, f3_s, f3_r;
        cin >> f1_s >> f1_r >> f2_s >> f2_r >> f3_s >> f3_r;
        play_round(2);
        cin >> bob_action;

        // Round 3: Turn
        int t_s, t_r;
        cin >> t_s >> t_r;
        play_round(3);
        cin >> bob_action;

        // Round 4: River
        int r_s, r_r;
        cin >> r_s >> r_r;
        play_round(4);
        cin >> bob_action;
        
        // End of hand is handled by the judge. 
        // The loop continues for the next hand.
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    solve();
    return 0;
