int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    vector<int> perm(n, -1);
    vector<int> remaining; // values we haven't placed yet

    // First, find all positions with value 1 by querying with all 1s
    cout << 0 << " ";
    for (int i = 0; i < n; i++) {
        cout << 1 << (i + 1 == n ? "\n" : " ");
    }
    cout.flush();

    int count1;
    cin >> count1;

    // Mark positions with value 1
    // We need to find which positions have 1 by checking each one
    // For each position i, query with value 1 at position i and some dummy elsewhere
    // Actually, let's use a different approach: query with 1 at position i and 2 elsewhere
    // Wait, that might have issues too.

    // Better approach: After finding count1, we know how many positions have 1.
    // For each remaining value v (from 2 to n), we find its position by testing each position.
    // Query with v at position i, and 1 at all other positions.
    // If response > count1, then position i has value v.

    // First, mark all positions that could have 1 - we need to identify them
    // Let's query each position with value 1 at that position and 2 elsewhere
    vector<int> pos1; // positions where value is 1
    for (int i = 0; i < n; i++) {
        cout << 0 << " ";
        for (int j = 0; j < n; j++) {
            cout << (j == i ? 1 : 2) << (j + 1 == n ? "\n" : " ");
        }
        cout.flush();
        int resp;
        cin >> resp;
        if (resp > 0) {
            pos1.push_back(i);
        }
    }

    // Mark these positions as having value 1
    for (int idx : pos1) {
        perm[idx] = 1;
    }

    // Now find remaining values (2 to n)
    for (int v = 2; v <= n; v++) {
        // Skip if we already found this value (shouldn't happen since each value appears once)
        bool alreadyFound = false;
        for (int i = 0; i < n; i++) {
            if (perm[i] == v) {
                alreadyFound = true;
                break;
            }
        }
        if (alreadyFound) continue;

        // Find position of value v
        for (int i = 0; i < n; i++) {
            if (perm[i] != -1) continue; // already determined

            cout << 0 << " ";
            for (int j = 0; j < n; j++) {
                cout << (j == i ? v : 1) << (j + 1 == n ? "\n" : " ");
            }
            cout.flush();
            int resp;
            cin >> resp;

            // If resp > count1, then position i has value v
            // (because we get count1 matches from positions with value 1, plus 1 more if position i has v)
            if (resp > count1) {
                perm[i] = v;
                break;
            }
        }
    }

    // If any positions are still unfilled (could happen if count1 = n, i.e., all positions are 1, but that's impossible for n > 1)
    // Fill remaining with unused values
    vector<int> unused;
    vector<bool> used(n + 1, false);
    for (int i = 0; i < n; i++) {
        if (perm[i] != -1) used[perm[i]] = true;
    }
    for (int v = 1; v <= n; v++) {
        if (!used[v]) unused.push_back(v);
    }
    int idx = 0;
    for (int i = 0; i < n; i++) {
        if (perm[i] == -1 && idx < (int)unused.size()) {
            perm[i] = unused[idx++];
        }
    }

    // Output final guess
    cout << 1 << " ";
    for (int i = 0; i < n; i++) {
        cout << perm[i] << (i + 1 == n ? "\n" : " ");
    }
    cout.flush();

    return 0;
}
