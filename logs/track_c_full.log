using namespace std;

struct Node {
    long long val;
    int row;
    int col;
    bool operator>(const Node& other) const {
        return val > other.val;
    }
};

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    long long n, k;
    if(!(cin >> n >> k)) {
        return 0;
    }
    
    vector<vector<long long>> cache(n + 1, vector<long long>(n + 1, -1));
    
    auto query = [&](int x, int y) -> long long {
        if(x < 1 || x > n || y < 1 || y > n) {
            return -1;
        }
        if(cache[x][y] == -1) {
            cout << "QUERY " << x << " " << y << endl;
            long long val;
            cin >> val;
            cache[x][y] = val;
        }
        return cache[x][y];
    };
    
    // Use a min-heap to find k smallest elements efficiently
    // Start with first column elements (n queries)
    // Then each pop adds the next element from that row (k queries)
    // Total: n + k queries (much better than binary search)
    
    priority_queue<Node, vector<Node>, greater<Node>> pq;
    
    // Initialize with first column
    for (int row = 1; row <= n; row++) {
        long long val = query(row, 1);
        pq.push({val, row, 1});
    }
    
    long long answer = 0;
    for (long long i = 0; i < k; i++) {
        Node curr = pq.top();
        pq.pop();
        
        if (i == k - 1) {
            answer = curr.val;
        }
        
        // Add next element from this row if exists
        if (curr.col < n) {
            long long nextVal = query(curr.row, curr.col + 1);
            pq.push({nextVal, curr.row, curr.col + 1};
        }
    }
    
    cout << "DONE " << answer << endl;
    
    return 0;
}
