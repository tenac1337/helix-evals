using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    // Read n
    int n;
    if (!(cin >> n)) return 0;
    
    // Generate n distinct magic words: word k = "X" repeated k times
    // This ensures each word has unique length, and concatenation power = sum of lengths
    vector<string> words(n + 1);
    for (int i = 1; i <= n; i++) {
        words[i] = string(i, 'X');
        cout << words[i] << "\n";
    }
    cout.flush();
    
    // Precompute power for each ordered pair (u, v)
    // For string of all X's, number of distinct substrings = length
    // So power(w_u + w_v) = u + v
    unordered_map<int, pair<int, int>> powerToPair;
    for (int u = 1; u <= n; u++) {
        for (int v = 1; v <= n; v++) {
            int power = u + v;
            powerToPair[power] = {u, v};
        }
    }
    
    // Read q
    int q;
    cin >> q;
    
    // Process each query
    for (int i = 0; i < q; i++) {
        int p;
        cin >> p;
        auto it = powerToPair.find(p);
        if (it != powerToPair.end()) {
            cout << it->second.first << " " << it->second.second << "\n";
        } else {
            // Should not happen if input is valid
            cout << "1 1\n";
        }
        cout.flush();
    }
    
    return 0;
}
