using namespace std;

struct Card {
    int value; // 1-13 (2=1, 3=2, ..., A=13)
    int suit;  // 0-3
};

int cardValue(char c) {
    if (c >= '2' && c <= '9') return c - '0';
    if (c == 'T') return 10;
    if (c == 'J') return 11;
    if (c == 'Q') return 12;
    if (c == 'K') return 13;
    if (c == 'A') return 14; // Use 14 for Ace
    return 0;
}

int cardSuit(char c) {
    if (c == 'c') return 0;
    if (c == 'd') return 1;
    if (c == 'h') return 2;
    if (c == 's') return 3;
    return 0;
}

char suitChar(int s) {
    if (s == 0) return 'c';
    if (s == 1) return 'd';
    if (s == 2) return 'h';
    return 's';
}

char valueChar(int v) {
    if (v >= 2 && v <= 9) return '0' + v;
    if (v == 10) return 'T';
    if (v == 11) return 'J';
    if (v == 12) return 'Q';
    if (v == 13) return 'K';
    return 'A';
}

// Check for flush (5+ cards same suit)
bool isFlush(const vector<Card>& cards) {
    int suitCount[4] = {0};
    for (auto& c : cards) suitCount[c.suit]++;
    for (int i = 0; i < 4; i++) if (suitCount[i] >= 5) return true;
    return false;
}

// Check for straight, return highest card or 0 if no straight
int getStraight(const vector<Card>& cards) {
    set<int> values;
    for (auto& c : cards) values.insert(c.value);
    // Handle A-2-3-4-5 straight (A=14, treat as 1)
    if (values.count(14) && values.count(2) && values.count(3) && values.count(4) && values.count(5)) {
        return 5; // 5-high straight
    }
    // Check regular straights
    for (auto it = values.rbegin(); it != values.rend(); ++it) {
        int high = *it;
        if (values.count(high-1) && values.count(high-2) && values.count(high-3) && values.count(high-4)) {
            return high;
        }
    }
    return 0;
}

// Count pairs, trips, quads
void countMultiples(const vector<Card>& cards, int& pairs, int& trips, int& quads) {
    map<int, int> counts;
    for (auto& c : cards) counts[c.value]++;
    pairs = trips = quads = 0;
    for (auto& p : counts) {
        if (p.second == 2) pairs++;
        else if (p.second == 3) trips++;
        else if (p.second == 4) quads++;
    }
}

// Evaluate hand strength (simplified)
int evaluateHand(const vector<Card>& allCards) {
    if (allCards.size() < 5) return 0;
    
    // Try all 5-card combinations
    int bestScore = 0;
    int n = allCards.size();
    
    // For each 5-card combination
    for (int i = 0; i < n; i++) {
        for (int j = i+1; j < n; j++) {
            for (int k = j+1; k < n; k++) {
                for (int l = k+1; l < n; l++) {
                    for (int m = l+1; m < n; m++) {
                        vector<Card> hand = {allCards[i], allCards[j], allCards[k], allCards[l], allCards[m]};
                        
                        // Check for straight flush
                        int straightHigh = getStraight(hand);
                        if (isFlush(hand) && straightHigh > 0) {
                            bestScore = max(bestScore, 8000000 + straightHigh * 10000);
                            continue;
                        }
                        
                        // Check for quads
                        map<int, int> counts;
                        for (auto& c : hand) counts[c.value]++;
                        int maxCount = 0, maxValue = 0;
                        for (auto& p : counts) {
                            if (p.second > maxCount) {
                                maxCount = p.second;
                                maxValue = p.value;
                            }
                        }
                        if (maxCount == 4) {
                            int kicker = 0;
                            for (auto& p : counts) if (p.first != maxValue) kicker = max(kicker, p.first);
                            bestScore = max(bestScore, 7000000 + maxValue * 10000 + kicker);
                            continue;
                        }
                        
                        // Check for full house
                        bool hasTrips = false, hasPair = false;
                        int tripsValue = 0, pairValue = 0;
                        for (auto& p : counts) {
                            if (p.second == 3) { hasTrips = true; tripsValue = max(tripsValue, p.first); }
                            if (p.second == 2) { hasPair = true; pairValue = max(pairValue, p.first); }
                        }
                        if (hasTrips && hasPair) {
                            bestScore = max(bestScore, 6000000 + tripsValue * 10000 + pairValue);
                            continue;
                        }
                        
                        // Flush
                        if (isFlush(hand)) {
                            vector<int> vals;
                            for (auto& c : hand) vals.push_back(c.value);
                            sort(vals.rbegin(), vals.rend());
                            bestScore = max(bestScore, 5000000 + vals[0]*100000 + vals[1]*10000 + vals[2]*1000 + vals[3]*100 + vals[4]);
                            continue;
                        }
                        
                        // Straight
                        if (straightHigh > 0) {
                            bestScore = max(bestScore, 4000000 + straightHigh * 10000);
                            continue;
                        }
                        
                        // Trips
                        if (hasTrips) {
                            int kicker1 = 0, kicker2 = 0;
                            for (auto& p : counts) if (p.first != tripsValue) {
                                if (p.first > kicker1) { kicker2 = kicker1; kicker1 = p.first; }
                                else if (p.first > kicker2) kicker2 = p.first;
                            }
                            bestScore = max(bestScore, 3000000 + tripsValue * 10000 + kicker1 * 100 + kicker2);
                            continue;
                        }
                        
                        // Two pair
                        vector<pair<int,int>> pairs;
                        for (auto& p : counts) if (p.second == 2) pairs.push_back({p.first, p.first});
                        if (pairs.size() >= 2) {
                            sort(pairs.rbegin(), pairs.rend());
                            int kicker = 0;
                            for (auto& p : counts) if (p.first != pairs[0].first && p.first != pairs[1].first) 
                                kicker = max(kicker, p.first);
                            bestScore = max(bestScore, 2000000 + pairs[0].first * 10000 + pairs[1].first * 100 + kicker);
                            continue;
                        }
                        
                        // One pair
                        if (pairs.size() == 1) {
                            int kicker1 = 0, kicker2 = 0, kicker3 = 0;
                            for (auto& p : counts) if (p.first != pairs[0].first) {
                                if (p.first > kicker1) { kicker3 = kicker2; kicker2 = kicker1; kicker1 = p.first; }
                                else if (p.first > kicker2) { kicker3 = kicker2; kicker2 = p.first; }
                                else if (p.first > kicker3) kicker3 = p.first;
                            }
                            bestScore = max(bestScore, 1000000 + pairs[0].first * 100000 + kicker1 * 10000 + kicker2 * 100 + kicker3);
                            continue;
                        }
                        
                        // High card
                        vector<int> vals;
                        for (auto& c : hand) vals.push_back(c.value);
                        sort(vals.rbegin(), vals.rend());
                        bestScore = max(bestScore, vals[0]*100000 + vals[1]*10000 + vals[2]*1000 + vals[3]*100 + vals[4]);
                    }
                }
            }
        }
    }
    return bestScore;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    vector<Card> myHand;
    vector<Card> board;
    int myStack = 100;
    int oppStack = 100;
    int pot = 10;
    int round = 0; // 0=preflop, 1=flop, 2=turn, 3=river
    
    string word;
    while (cin >> word) {
        if (word == "NEWGAME") {
            myHand.clear();
            board.clear();
            myStack = 100;
            oppStack = 100;
            pot = 10;
            round = 0;
        }
        else if (word == "YOURHAND") {
            myHand.clear();
            string card1, card2;
            cin >> card1 >> card2;
            myHand.push_back({cardValue(card1[0]), cardSuit(card1[1])};
            myHand.push_back({cardValue(card2[0]), cardSuit(card2[1])};
        }
        else if (word == "BOARD") {
            board.clear();
            int num;
            cin >> num;
            for (int i = 0; i < num; i++) {
                string card;
                cin >> card;
                board.push_back({cardValue(card[0]), cardSuit(card[1])};
            }
            if (num == 3) round = 1;
            else if (num == 4) round = 2;
            else if (num == 5) round = 3;
        }
        else if (word == "POT") {
            cin >> pot;
        }
        else if (word == "STACKS") {
            cin >> myStack >> oppStack;
        }
        else if (word == "ACTION") {
            string action;
            cin >> action;
            if (action == "RAISE") {
                int amount;
                cin >> amount;
                pot += amount;
                oppStack -= amount;
            }
        }
        else if (word == "YOURTURN") {
            // Make decision
            vector<Card> allCards = myHand;
            allCards.insert(allCards.end(), board.begin(), board.end());
            
            int handStrength = evaluateHand(allCards);
            
            // Simple strategy based on hand strength and pot odds
            // Preflop: play tight
            bool shouldPlay = true;
            int raiseAmount = 0;
            
            if (round == 0) {
                // Preflop - only play good hands
                int hv = max(myHand[0].value, myHand[1].value);
                int lv = min(myHand[0].value, myHand[1].value);
                bool suited = (myHand[0].suit == myHand[1].suit);
                
                // Good preflop hands: high pairs, high suited connectors
                if (hv >= 13) shouldPlay = true; // KK, AA
                else if (hv >= 12 && lv >= 11) shouldPlay = true; // AQ, AK
                else if (hv >= 12 && suited) shouldPlay = true; // AQs, AKs
                else if (hv >= 11 && lv >= 10) shouldPlay = true; // JT
                else if (hv >= 10 && lv >= 9 && suited) shouldPlay = true; // T9s
                else shouldPlay = false;
                
                if (shouldPlay) raiseAmount = min(20, myStack);
            }
            else {
                // Postflop - play based on hand strength
                // Normalize strength to 0-100 scale
                int strength = handStrength / 100000;
                
                if (strength >= 70) shouldPlay = true; // Quads+
                else if (strength >= 60) shouldPlay = true; // Full house
                else if (strength >= 50) shouldPlay = true; // Flush
                else if (strength >= 40) shouldPlay = true; // Straight
                else if (strength >= 30) shouldPlay = true; // Trips
                else if (strength >= 20) shouldPlay = true; // Two pair
                else if (strength >= 10) shouldPlay = (pot > 20); // Pair
                else shouldPlay = (pot > 30); // Weak
                
                if (shouldPlay) raiseAmount = min(max(pot/2, 5), myStack);
            }
            
            if (!shouldPlay) {
                cout << "FOLD" << endl;
            }
            else if (raiseAmount > 0 && raiseAmount <= myStack) {
                cout << "RAISE " << raiseAmount << endl;
            }
            else {
                cout << "CHECK" << endl;
            }
            cout.flush();
        }
        else if (word == "WIN" || word == "LOSE" || word == "TIE") {
            // Hand over, reset for next
            if (word == "WIN") {
                int amount;
                cin >> amount;
                myStack += amount;
            }
            else if (word == "LOSE") {
                int amount;
                cin >> amount;
            }
            myHand.clear();
            board.clear();
            round = 0;
        }
    }
    
    return 0;
