int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    long long n, k;
    if (!(cin >> n >> k)) {
        cout << "DONE 0" << endl;
        return 0;
    }
    
    auto query = [&](long long x, long long y) -> long long {
        cout << "QUERY " << x << " " << y << endl;
        long long val;
        cin >> val;
        return val;
    };
    
    // Query corners to get value range
    long long lo = query(1, 1);
    long long hi = query(n, n);
    
    // Binary search for k-th smallest
    long long ans = hi;
    while (lo <= hi) {
        long long mid = lo + (hi - lo) / 2;
        
        // Count elements <= mid in sorted matrix
        long long cnt = 0;
        long long i = 0, j = n - 1;
        while (i < n && j >= 0) {
            long long val = query(i + 1, j + 1);
            if (val <= mid) {
                // All elements in column j from row 0 to i are <= mid
                cnt += (i + 1);
                j--;
            } else {
                // All elements in row i from column 0 to j-1 might be <= mid
                cnt += j;
                i++;
            }
        }
        
        if (cnt >= k) {
            ans = mid;
            hi = mid - 1;
        } else {
            lo = mid + 1;
        }
    }
    
    cout << "DONE " << ans << endl;
    
    return 0;
}
