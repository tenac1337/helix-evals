    vector<vector<int>> t(50, vector<int>(50));
    for (int i = 0; i < 50; i++) {
        for (int j = 0; j < 50; j++) {
            cin >> t[i][j];
        }
    }

    vector<vector<int>> p(50, vector<int>(50));
    for (int i = 0; i < 50; i++) {
        for (int j = 0; j < 50; j++) {
            cin >> p[i][j];
        }
    }

    int max_tile = 0;
    for (int i = 0; i < 50; i++) {
        for (int j = 0; j < 50; j++) {
            if (t[i][j] > max_tile) {
                max_tile = t[i][j];
            }
        }
    }
    int M = max_tile + 1;
    vector<bool> visited(M, false);

    visited[t[si][sj]] = true;
    string moves = "";
    int i = si, j = sj;

    while (true) {
        vector<tuple<int, char, int, int>> candidates;
        vector<tuple<int, char>> directions = {{-1, 0, 'U'}, {1, 0, 'D'}, {0, -1, 'L'}, {0, 1, 'R'}};

        for (auto [di, dj, move_char] : directions) {
            int ni = i + di;
            int nj = j + dj;
            if (ni >= 0 && ni < 50 && nj >= 0 && nj < 50 && !visited[t[ni][nj]]) {
                candidates.emplace_back(p[ni][nj], move_char, ni, nj);
            }
        }

        if (candidates.empty()) break;

        sort(candidates.begin(), candidates.end(), greater<tuple<int, char, int, int>>());
        auto [val, move_char, ni, nj] = candidates[0];
        moves += move_char;
        visited[t[ni][nj]] = true;
        i = ni;
        j = nj;
    }

    cout << moves << endl;
    return 0;
}

