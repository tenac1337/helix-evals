    vector<int> compIsSmall(numComp, -1);
    
    // Query element 1 with one element from each component to determine component type
    for(int c = 0; c < numComp; c++) {
        // Find any element in this component
        int representative = -1;
        for(int i = 1; i <= n; i++) {
            if(comp[i] == c) {
