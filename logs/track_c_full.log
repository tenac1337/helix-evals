using namespace std;

struct Card {
    int suit; // 0-3
    int value; // 1-13 (2-A)
};

vector<Card> parseCards(const string& s) {
    vector<Card> cards;
    for (size_t i = 0; i + 1 < s.size(); i += 2) {
        char c = s[i];
        char d = s[i + 1];
        Card card;
        if (c >= '2' && c <= '9') card.value = c - '0';
        else if (c == 'T') card.value = 10;
        else if (c == 'J') card.value = 11;
        else if (c == 'Q') card.value = 12;
        else if (c == 'K') card.value = 13;
        else if (c == 'A') card.value = 14;
        
        if (d >= '0' && d <= '3') card.suit = d - '0';
        cards.push_back(card);
    }
    return cards;
}

int handType(const vector<Card>& hand) {
    // Returns hand type: 9=high card, 8=pair, 7=two pair, 6=three of a kind, 5=straight, 4=flush, 3=full house, 2=four of a kind, 1=straight flush
    if (hand.size() < 5) return 9;
    
    // Count values and suits
    map<int, int> valueCount;
    map<int, int> suitCount;
    vector<int> values;
    for (const auto& c : hand) {
        valueCount[c.value]++;
        suitCount[c.suit]++;
        values.push_back(c.value);
    }
    
    // Check flush
    bool isFlush = false;
    for (auto& p : suitCount) {
        if (p.second >= 5) {
            isFlush = true;
            break;
        }
    }
    
    // Check straight
    sort(values.begin(), values.end());
    values.erase(unique(values.begin(), values.end()), values.end());
    bool isStraight = false;
    int straightHigh = 0;
    for (size_t i = 0; i + 4 < values.size(); i++) {
        if (values[i + 4] - values[i] == 4) {
            isStraight = true;
            straightHigh = values[i + 4];
            break;
        }
    }
    // Check A-2-3-4-5 straight (wheel)
    if (!isStraight) {
        bool hasA = false, has2 = false, has3 = false, has4 = false, has5 = false;
        for (int v : values) {
            if (v == 14) hasA = true;
            if (v == 2) has2 = true;
            if (v == 3) has3 = true;
            if (v == 4) has4 = true;
            if (v == 5) has5 = true;
        }
        if (hasA && has2 && has3 && has4 && has5) {
            isStraight = true;
            straightHigh = 5; // A-2-3-4-5 is lowest straight
        }
    }
    
    if (isFlush && isStraight) return 1; // Straight flush
    if (isFlush) return 4; // Flush
    if (isStraight) return 5; // Straight
    
    // Check pairs, trips, quads
    int maxCount = 0;
    for (auto& p : valueCount) {
        maxCount = max(maxCount, p.second);
    }
    
    if (maxCount == 4) return 2; // Four of a kind
    if (maxCount == 3) {
        // Check for full house
        int pairs = 0;
        for (auto& p : valueCount) {
            if (p.second == 2) pairs++;
        }
        if (pairs >= 1) return 3; // Full house
        return 6; // Three of a kind
    }
    if (maxCount == 2) {
        int pairs = 0;
        for (auto& p : valueCount) {
            if (p.second == 2) pairs++;
        }
        if (pairs >= 2) return 7; // Two pair
        return 8; // One pair
    }
    
    return 9; // High card
}

int evaluateHand(const vector<Card>& allCards) {
    if (allCards.size() < 5) return 0;
    
    // Find best 5-card hand from 7 cards
    int bestType = 10;
    vector<Card> bestHand;
    
    // Generate all 5-card combinations from 7 cards
    vector<int> idx(allCards.size(), 0);
    for (int i = 0; i < 5; i++) idx[i] = 1;
    
    do {
        vector<Card> hand;
        for (size_t i = 0; i < allCards.size(); i++) {
            if (idx[i]) hand.push_back(allCards[i]);
        }
        int t = handType(hand);
        if (t < bestType) {
            bestType = t;
            bestHand = hand;
        }
    } while (next_permutation(idx.begin(), idx.end()));
    
    return bestType;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    string input;
    vector<Card> myCards;
    vector<Card> board;
    int myStack = 100;
    int oppStack = 100;
    int pot = 10;
    int round = 0; // 0=preflop, 1=after flop, 2=after turn, 3=after river
    
    while (cin >> input) {
        if (input == "SHOWDOWN") {
            // Game over, evaluate result
            break;
        }
        else if (input == "YOURTURN") {
            // Need to decide action
            // Read current state
            int myBet = 0, oppBet = 0;
            string state;
            cin >> state; // Read state info
            
            // Parse state: "myCards:XX|board:XXX|myStack:N|oppStack:N|pot:N|round:N"
            myCards.clear();
            board.clear();
            
            size_t pos = 0;
            while (pos < state.size()) {
                size_t colon = state.find(':', pos);
                if (colon == string::npos) break;
                string key = state.substr(pos, colon - pos);
                size_t bar = state.find('|', colon);
                if (bar == string::npos) bar = state.size();
                string val = state.substr(colon + 1, bar - colon - 1);
                
                if (key == "myCards") {
                    myCards = parseCards(val);
                } else if (key == "board") {
                    board = parseCards(val);
                } else if (key == "myStack") {
                    myStack = stoi(val);
                } else if (key == "oppStack") {
                    oppStack = stoi(val);
                } else if (key == "pot") {
                    pot = stoi(val);
                } else if (key == "round") {
                    round = stoi(val);
                }
                
                pos = bar + 1;
            }
            
            // Simple strategy: evaluate hand strength and decide
            vector<Card> allCards = myCards;
            allCards.insert(allCards.end(), board.begin(), board.end());
            
            int handStrength = evaluateHand(allCards);
            
            // Decide action
            if (round == 0) {
                // Preflop - play tight
                if (handStrength <= 6) { // Good hand (three of a kind or better in evaluation)
                    if (myStack > 10) {
                        cout << "RAISE " << min(20, myStack) << endl;
                    } else {
                        cout << "CHECK" << endl;
                    }
                } else {
                    cout << "CHECK" << endl;
                }
            } else if (round == 1 || round == 2) {
                // Post-flop
                if (handStrength <= 5) { // Good hand
                    if (myStack > 5) {
                        cout << "RAISE " << min(15, myStack) << endl;
                    } else {
                        cout << "CHECK" << endl;
                    }
                } else if (handStrength >= 8) {
                    // Weak hand - might fold if raised against
                    cout << "CHECK" << endl;
                } else {
                    cout << "CHECK" << endl;
                }
            } else {
                // River
                if (handStrength <= 4) {
                    if (myStack > 5) {
                        cout << "RAISE " << min(25, myStack) << endl;
                    } else {
                        cout << "CHECK" << endl;
                    }
                } else {
                    cout << "CHECK" << endl;
                }
            }
            cout.flush();
        }
        else if (input == "WIN" || input == "LOSS" || input == "TIE") {
            // Hand result
            string amount;
            cin >> amount;
            // Read remaining line
            break;
        }
    }
    
    return 0;
