        }
        polys[i] = pts;
    }

    vector<tuple<int, int, int, int>> polys_processed;
    for (int i = 0; i < n; i++) {
        const auto &pts = polys[i];
        int best_area = INT_MAX;
        int best_w = INT_MAX;
        int best_h = INT_MAX;
        int best_r = 0;
        int best_f = 0;
        
        for (int f = 0; f < 2; f++) {
            for (int r = 0; r < 4; r++) {
                vector<pair<int, int>> transformed;
                for (const auto &p : pts) {
                    int x = p.first;
                    int y = p.second;
                    if (f) {
                        x = -x;
                    }
                    for (int j = 0; j < r; j++) {
                        int nx = y;
                        int ny = -x;
                        x = nx;
                        y = ny;
                    }
                    transformed.push_back({x, y});
                }
                
                int min_x = INT_MAX, min_y = INT_MAX;
                for (const auto &p : transformed) {
                    min_x = min(min_x, p.first);
                    min_y = min(min_y, p.second);
                }
                int max_x = INT_MIN, max_y = INT_MIN;
                for (const auto &p : transformed) {
                    int x = p.first - min_x;
                    int y = p.second - min_y;
                    max_x = max(max_x, x);
                    max_y = max(max_y, y);
                }
                int w = max_x + 1;
                int h = max_y + 1;
                int area = w * h;
                
                if (area < best_area || (area == best_area && (h < best_h || (h == best_h && w < best_w)))) {
                    best_area = area;
                    best_w = w;
                    best_h = h;
                    best_r = r;
                    best_f = f;
                }
            }
        }
        polys_processed.push_back({best_w, best_h, best_r, best_f});
    }

    vector<tuple<int, int, int, int, int>> rects;
    for (int i = 0; i < n; i++) {
        rects.push_back({get<0>(polys_processed[i]), get<1>(polys_processed[i]), i, get<2>(polys_processed[i]), get<3>(polys_processed[i])});
    }

    sort(rects.begin(), rects.end(), [](const auto &a, const auto &b) {
        if (get<1>(a) != get<1>(b)) {
            return get<1>(a) > get<1>(b);
        }
        return get<0>(a) > get<0>(b);
    });

    vector<tuple<int, int, int>> shelves;
    int total_height = 0;
    int current_max_width = 0;
    vector<tuple<int, int, int, int>> ans(n);

    for (const auto &rect : rects) {
        int w = get<0>(rect);
        int h = get<1>(rect);
        int idx = get<2>(rect);
        int r = get<3>(rect);
        int f = get<4>(rect);
        
        bool placed = false;
        for (auto &shelf : shelves) {
            int &shelf_current_x = get<0>(shelf);
            int shelf_y = get<1>(shelf);
            int shelf_height = get<2>(shelf);
            if (h <= shelf_height) {
                ans[idx] = {shelf_current_x, shelf_y, r, f};
                shelf_current_x += w;
