using namespace std;

struct State {
    int next[2];
    int link;
    int len;
    State() {
        next[0] = next[1] = -1;
        link = -1;
        len = 0;
    }
};

struct SuffixAutomaton {
    vector<State> st;
    int last;
    
    SuffixAutomaton(int maxlen = 0) {
        st.reserve(2 * maxlen + 5);
        st.push_back(State());
        st[0].len = 0;
        st[0].link = -1;
        last = 0;
    }
    
    void extend(char c) {
        int cur = st.size();
        st.push_back(State());
        st[cur].len = st[last].len + 1;
        int p = last;
        int x = (c == 'X') ? 0 : 1;
        
        while (p != -1 && st[p].next[x] == -1) {
            st[p].next[x] = cur;
            p = st[p].link;
        }
        
        if (p == -1) {
            st[cur].link = 0;
        } else {
            int q = st[p].next[x];
            if (st[p].len + 1 == st[q].len) {
                st[cur].link = q;
            } else {
                int clone = st.size();
                st.push_back(st[q]);
                st[clone].len = st[p].len + 1;
                while (p != -1 && st[p].next[x] == q) {
                    st[p].next[x] = clone;
                    p = st[p].link;
                }
                st[q].link = st[cur].link = clone;
            }
        }
        last = cur;
    }
    
    long long countDistinctSubstrings() {
        long long result = 0;
        for (size_t i = 1; i < st.size(); i++) {
            result += st[i].len - st[st[i].link].len;
        }
        return result;
    }
};

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    if (!(cin >> n)) return 0;
    
    // Generate first n primes (each <= 30*n for length constraint)
    vector<int> primes;
    vector<bool> is_prime(30 * n + 1, true);
    is_prime[0] = is_prime[1] = false;
    for (int i = 2; i <= 30 * n; i++) {
        if (is_prime[i]) {
            primes.push_back(i);
            if ((int)primes.size() >= n) break;
            for (int j = i * 2; j <= 30 * n; j += i) {
                is_prime[j] = false;
            }
        }
    }
    
    // If we don't have enough primes, extend search
    while ((int)primes.size() < n) {
        int start = 30 * n + 1;
        // Just use consecutive numbers beyond the limit
        for (int i = start; ; i++) {
            bool ok = true;
            for (int p : primes) {
                if (p * p > i) break;
                if (i % p == 0) { ok = false; break; }
            }
            if (ok) {
                primes.push_back(i);
                if ((int)primes.size() >= n) break;
            }
        }
    }
    
    // Generate words with prime lengths using alternating X/O pattern
    vector<string> words(n);
    for (int i = 0; i < n; i++) {
        int len = primes[i];
        words[i].reserve(len);
        for (int j = 0; j < len; j++) {
            words[i] += (j % 2 == 0) ? 'X' : 'O';
        }
    }
    
    // Output words
    for (int i = 0; i < n; i++) {
        cout << words[i] << "\n";
    }
    cout.flush();
    
    // Precompute power for all pairs using suffix automaton
    unordered_map<long long, pair<int, int>> power_to_pair;
    power_to_pair.reserve(n * n * 2);
    
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            string concat = words[i] + words[j];
            SuffixAutomaton sam(concat.length());
            for (char c : concat) {
                sam.extend(c);
            }
            long long power = sam.countDistinctSubstrings();
            power_to_pair[power] = {i + 1, j + 1};
        }
    }
    
    int q;
    cin >> q;
    for (int qi = 0; qi < q; qi++) {
        long long p;
        cin >> p;
        auto it = power_to_pair.find(p);
        if (it != power_to_pair.end()) {
            cout << it->second.first << " " << it->second.second << "\n";
        } else {
            // Fallback (should not happen if problem is valid)
            cout << 1 << " " << 1 << "\n";
        }
        cout.flush();
    }
    
    return 0;
