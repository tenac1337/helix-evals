    cin.tie(NULL);
    
    int n;
    if(!(cin >> n)) return 0;
    
    int low = 1, high = n;
    
    // Use binary search with verification when answers conflict
    while (low < high) {
        int mid = low + (high - low) / 2;
        
        // Query lower half [low, mid]
        vector<int> left;
        for (int i = low; i <= mid; i++) left.push_back(i);
        string ansL = ask(left);
        
        if (low == high) break;
        
        // Query upper half [mid+1, high]
        vector<int> right;
        for (int i = mid + 1; i <= high; i++) right.push_back(i);
        string ansR = ask(right);
        
        // At least one of ansL, ansR is correct (consecutive questions)
        if (ansL == "YES" && ansR == "YES") {
            // Both can't be correct - one is lying
            // Verify by asking about a single element
            vector<int> single = {low};
            string ansV = ask(single);
            
            if (ansV == "YES") {
                high = mid;
            } else {
                low = mid + 1;
            }
        } else if (ansL == "YES") {
            high = mid;
        } else if (ansR == "YES") {
            low = mid + 1;
        } else {
            // Both NO - contradiction, one is lying
            // Verify using a single element
            vector<int> single = {low};
            string ansV = ask(single);
            
            if (ansV == "YES") {
                high = mid;
            } else {
                low = mid + 1;
            }
        }
    }
    
