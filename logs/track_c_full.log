        parityWith1[i] = resp;  // 1 means p[1]+p[i] even, 0 means odd
    }
    
    // Now we know the parity of p[i] relative to p[1]
    // If p[1]+p[i] is even, p[i] has same parity as p[1]
    // If odd, p[i] has opposite parity
    
