using namespace std;

struct State {
    int next[2];
    int link;
    int len;
    State() {
        next[0] = next[1] = -1;
        link = -1;
        len = 0;
    }
};

struct SuffixAutomaton {
    vector<State> st;
    int last;
    
    SuffixAutomaton(int maxlen = 0) {
        st.reserve(2 * maxlen + 5);
        st.push_back(State());
        st[0].len = 0;
        st[0].link = -1;
        last = 0;
    }
    
    void extend(char c) {
        int cur = st.size();
        st.push_back(State());
        st[cur].len = st[last].len + 1;
        
        int p = last;
        int ch = c == 'X' ? 0 : 1;
        
        while (p != -1 && st[p].next[ch] == -1) {
            st[p].next[ch] = cur;
            p = st[p].link;
        }
        
        if (p == -1) {
            st[cur].link = 0;
        } else {
            int q = st[p].next[ch];
            if (st[p].len + 1 == st[q].len) {
                st[cur].link = q;
            } else {
                int clone = st.size();
                st.push_back(st[q]);
                st[clone].len = st[p].len + 1;
                st[clone].link = st[q].link;
                
                while (p != -1 && st[p].next[ch] == q) {
                    st[p].next[ch] = clone;
                    p = st[p].link;
                }
                st[q].link = st[cur].link = clone;
            }
        }
        last = cur;
    }
    
    long long countDistinctSubstrings() {
        long long result = 0;
        for (int i = 1; i < (int)st.size(); i++) {
            result += st[i].len - st[st[i].link].len;
        }
        return result;
    }
};

long long countDistinctSubstrings(const string& s) {
    SuffixAutomaton sam(s.size());
    for (char c : s) {
        sam.extend(c);
    }
    return sam.countDistinctSubstrings();
}

