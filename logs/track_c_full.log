                cout << "2 " << current << " " << v << endl;
                cout.flush();
                int r1, r2;
                cin >> r1 >> r2;
                
                cout << "2 " << v << " " << current << endl;
                cout.flush();
                int r3, r4;
                cin >> r3 >> r4;
                
                if (r2 == 1) {
                    current = v;
                    found = true;
                    break;
                }
            }
            if (!found) break;
        }
        
        // If not complete, try from right
        if (p.size() < (size_t)n) {
            p.clear();
            visited.assign(n + 1, false);
            p.push_back(1);
            visited[1] = true;
            
            current = right;
            while (true) {
                p.push_back(current);
                visited[current] = true;
                
                if (p.size() == n) break;
                
                int prev = p[p.size() - 2];
                bool found = false;
                
                for (int v = 1; v <= n; ++v) {
                    if (visited[v] || v == prev) continue;
                    
                    cout << "2 " << current << " " << v << endl;
                    cout.flush();
                    int r1, r2;
                    cin >> r1 >> r2;
                    
                    cout << "2 " << v << " " << current << endl;
                    cout.flush();
                    int r3, r4;
                    cin >> r3 >> r4;
                    
                    if (r2 == 1) {
                        current = v;
                        found = true;
                        break;
                    }
                }
                if (!found) break;
            }
        }
    }

    // Output the answer
    cout << "-1";
    for (int i = 0; i < n; ++i) {
        cout << " " << p[i];
    }
    cout << endl;

    return 0;
}
