using namespace std;

struct Piece {
    vector<pair<int,int>> cells;
    int minx, maxx, miny, maxy;
    int w, h;
};

Piece normalize(const vector<pair<int,int>>& cells, int rot, int flip) {
    Piece p;
    p.cells.reserve(cells.size());
    for (auto [x, y] : cells) {
        int nx = x, ny = y;
        if (flip) nx = -nx;
        if (rot == 0) { /* no rotation */ }
        else if (rot == 1) { int t = nx; nx = -ny; ny = t; }
        else if (rot == 2) { nx = -nx; ny = -ny; }
        else if (rot == 3) { int t = nx; nx = ny; ny = -t; }
        p.cells.push_back({nx, ny});
    }
    p.minx = INT_MAX, p.maxx = INT_MIN;
    p.miny = INT_MAX, p.maxy = INT_MIN;
    for (auto [x, y] : p.cells) {
        p.minx = min(p.minx, x);
        p.maxx = max(p.maxx, x);
        p.miny = min(p.miny, y);
        p.maxy = max(p.maxy, y);
    }
    // Shift to origin
    for (auto& c : p.cells) {
        c.first -= p.minx;
        c.second -= p.miny;
    }
    p.w = p.maxx - p.minx + 1;
    p.h = p.maxy - p.miny + 1;
    return p;
}

