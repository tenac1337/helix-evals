            pos++;
        }
        if (pos < all.size()) pos++;
        
        // Skip colon
        while (pos < all.size() && (all[pos] == ' ' || all[pos] == '\t')) pos++;
        if (pos < all.size() && all[pos] == ':') pos++;
        
        // Skip whitespace
        while (pos < all.size() && (all[pos] == ' ' || all[pos] == '\t')) pos++;
        
        // Parse array [q, v, m, l]
        if (all[pos] != '[') break;
        pos++;
        
        long long vals[4];
        for (int i = 0; i < 4; i++) {
            while (pos < all.size() && (all[pos] == ' ' || all[pos] == '\t' || all[pos] == '\n')) pos++;
            string num;
            while (pos < all.size() && (isdigit(all[pos]) || all[pos] == '-')) {
                num += all[pos];
                pos++;
            }
            vals[i] = stoll(num);
            while (pos < all.size() && (all[pos] == ' ' || all[pos] == '\t')) pos++;
            if (pos < all.size() && all[pos] == ',') pos++;
        }
        
        // Skip closing bracket
        while (pos < all.size() && all[pos] != ']') pos++;
        if (pos < all.size()) pos++;
        
        // Skip comma
        while (pos < all.size() && (all[pos] == ' ' || all[pos] == ',')) pos++;
        
        Item it;
        it.name = key;
        it.q = vals[0];
        it.v = vals[1];
        it.m = vals[2];
        it.l = vals[3];
        items.push_back(it);
    }
}

// Sort by value density (value/mass) descending
bool cmpByDensity(const Item& a, const Item& b) {
    double da = (double)a.v / a.m;
    double db = (double)b.v / b.m;
    return da > db;
}

// Branch and bound DFS
void dfs(int idx, long long curMass, long long curVol, long long curValue) {
    if (idx == (int)items.size()) {
        if (curValue > bestValue) {
            bestValue = curValue;
            // Store current quantities - need to track this
        }
        return;
    }
    
    // Pruning: if even taking all remaining can't beat best, skip
    long long maxPossibleValue = curValue;
    for (size_t i = idx; i < items.size(); i++) {
        maxPossibleValue += items[i].v * items[i].q;
    }
    if (maxPossibleValue <= bestValue) return;
    
    const Item& it = items[idx];
    
    // Try different quantities
    // Use binary splitting-like approach: try 0, and some key quantities
    // Start with taking as many as possible within constraints
    long long maxTakeByMass = (MAX_MASS - curMass) / it.m;
    long long maxTakeByVol = (MAX_VOL - curVol) / it.l;
    long long maxTake = min({it.q, maxTakeByMass, maxTakeByVol});
    
    // Try a few strategic quantities: 0, max possible, and some intermediate
    // Use geometric progression for efficiency
    vector<long long> toTry;
    toTry.push_back(0);
    if (maxTake > 0) {
        toTry.push_back(maxTake);
        // Add some intermediate points
        for (long long k = 1; k < maxTake; k *= 2) {
            if (k < maxTake) toTry.push_back(k);
            if (k * 2 < maxTake && k * 2 > k) toTry.push_back(k * 2);
        }
    }
    
    // Sort and remove duplicates
    sort(toTry.begin(), toTry.end());
    toTry.erase(unique(toTry.begin(), toTry.end()), toTry.end());
    
    // Limit iterations for performance
    if (toTry.size() > 20) {
        vector<long long> reduced;
        reduced.push_back(0);
        reduced.push_back(maxTake);
        for (int i = 1; i < 19; i++) {
            reduced.push_back((maxTake * i) / 20);
        }
        toTry = reduced;
        sort(toTry.begin(), toTry.end());
        toTry.erase(unique(toTry.begin(), toTry.end()), toTry.end());
    }
    
    for (long long take : toTry) {
        if (take > maxTake) continue;
        long long newMass = curMass + take * it.m;
        long long newVol = curVol + take * it.l;
        long long newValue = curValue + take * it.v;
        
        // Quick pruning
        if (newMass > MAX_MASS || newVol > MAX_VOL) continue;
        
        // Estimate if this path can be promising
        long long optimisticValue = newValue;
        for (size_t i = idx + 1; i < items.size(); i++) {
            optimisticValue += items[i].v * items[i].q;
        }
        if (optimisticValue <= bestValue) continue;
        
        dfs(idx + 1, newMass, newVol, newValue);
    }
}

// Alternative: greedy with optimization
void greedySolve() {
    // Sort by value density
    sort(items.begin(), items.end(), cmpByDensity);
    
    vector<long long> qty(items.size(), 0);
    long_t curMass = 0, curVol = 0, curValue = 0;
    
    // Take items greedily
    for (size_t i = 0; i < items.size(); i++) {
        const Item& it = items[i];
        long long maxTake = min(it.q, (MAX_MASS - curMass) / it.m);
        maxTake = min(maxTake, (MAX_VOL - curVol) / it.l);
        qty[i] = maxTake;
        curMass += maxTake * it.m;
        curVol += maxTake * it.l;
        curValue += maxTake * it.v;
    }
    
    // Try to improve by swapping
    bool improved = true;
    while (improved) {
        improved = false;
        for (size_t i = 0; i < items.size(); i++) {
            for (size_t j = 0; j < items.size(); j++) {
                if (i == j) continue;
                // Try to reduce item i and increase item j
                for (long long delta = 1; delta <= qty[i] && !improved; delta++) {
                    long long newMass = curMass - delta * items[i].m + delta * items[j].m;
                    long long newVol = curVol - delta * items[i].l + delta * items[j].l;
                    if (newMass > MAX_MASS || newVol > MAX_VOL) continue;
                    long long newValue = curValue - delta * items[i].v + delta * items[j].v;
                    if (newValue > curValue) {
                        qty[i] -= delta;
                        qty[j] += delta;
                        curMass = newMass;
                        curVol = newVol;
                        curValue = newValue;
                        improved = true;
                        break;
                    }
                }
            }
        }
    }
    
    if (curValue > bestValue) {
        bestValue = curValue;
        bestQty = qty;
    }
}

int main() {
