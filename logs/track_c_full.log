            for (int r = 0; r < 4; r++) {
                orientations[i][f*4 + r] = transform(base, r, f);
            }
        }
    }
    
    // Greedy packing with rows
    const int MAX_WIDTH = 1000;  // Reasonable bound for width
    
    struct PlacedPiece {
