    cin.tie(NULL);
    
    int si, sj;
    if (!(cin >> si >> sj)) return 0;
    
    const int N = 50;
    vector<vector<int>> tile(N, vector<int>(N));
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            cin >> tile[i][j];
        }
    }
    
    vector<vector<int>> val(N, vector<int>(N));
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            cin >> val[i][j];
        }
    }
    
    // Track visited tiles
    vector<vector<bool>> visitedTile(2500, false);
    
    // DFS with greedy best-first: always try highest value neighbors first
    string path;
    int ci = si, cj = sj;
    long long totalScore = val[ci][cj];
    visitedTile[tile[ci][cj]] = true;
    
    const int di[4] = {-1, 1, 0, 0};
    const int dj[4] = {0, 0, -1, 1};
    const char dirs[4] = {'U', 'D', 'L', 'R'};
    
    // Limit steps to avoid infinite loops and timeouts
    int maxSteps = 2500;
    int steps = 0;
    
    while (steps < maxSteps) {
        // Find best valid neighbor
        pair<int, pair<int, int>> best = {-1, {-1, -1}}; // (value, position)
        
        for (int d = 0; d < 4; d++) {
            int ni = ci + di[d];
            int nj = cj + dj[d];
            
            if (ni < 0 || ni >= N || nj < 0 || nj >= N) continue;
            if (visitedTile[tile[ni][nj]]) continue;
            
            int v = val[ni][nj];
            if (v > best.first) {
                best = {v, {ni, nj}};
            }
        }
        
        if (best.first < 0) break; // No valid moves
        
        // Move to best neighbor
        int ni = best.second.first;
        int nj = best.second.second;
        
        // Determine direction
        for (int d = 0; d < 4; d++) {
            if (ci + di[d] == ni && cj + dj[d] == nj) {
                path.push_back(dirs[d]);
                break;
            }
        }
        
        ci = ni;
        cj = nj;
        totalScore += val[ci][cj];
        visitedTile[tile[ci][cj]] = true;
        steps++;
    }
    
    cout << path.size() << "\n";
    cout << path << "\n";
    
    return 0;
}
