            cin >> initial.grid[i][j];
        }
    }
    
    // First compute the solve time for the initial state
    int initial_solve = solve_bfs(initial);
    
    // Now find the best move(s) to maximize solve time
    // We'll try single moves first
    auto moves = get_all_moves(initial);
    
    int best_solve = -1;
    pair<int, pair<int,int>> best_move = {0, {0, 0}};
    State best_state = initial;
    
    for (auto [id, d] : moves) {
        State next = move_vehicle(initial, id, d.first, d.second);
