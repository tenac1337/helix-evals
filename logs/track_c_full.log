#include <vector>
#include <map>
#include <algorithm>
#include <sstream>
#include <string>
#include <cctype>
#include <climits>

using namespace std;

struct Item {
    string name;
    long long q;
    long long v;
    long long m;
    long long l;
    int index;
};

vector<int> greedy(const vector<Item>& items) {
    vector<int> counts(items.size(), 0);
    long long current_mass = 0;
    long long current_volume = 0;
    for (int i = 0; i < items.size(); i++) {
        long long m_i = items[i].m;
        long long l_i = items[i].l;
        long long q_i = items[i].q;
        long long max_by_mass = (20000000 - current_mass) / m_i;
        long long max_by_vol = (25000000 - current_volume) / l_i;
        long long k = min(q_i, max_by_mass);
        k = min(k, max_by_vol);
        counts[i] = k;
        current_mass += k * m_i;
        current_volume += k * l_i;
    }
    return counts;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    string input_json;
    string line;
    while (getline(cin, line)) {
        input_json += line;
    }

    vector<Item> items;
    vector<string> key_order;
    int pos = 1;
    int n = input_json.size();
    while (pos < n-1) {
        int start_key = input_json.find('"', pos);
        if (start_key == string::npos) break;
        int end_key = input_json.find('"', start_key+1);
        string key = input_json.substr(start_key+1, end_key - start_key - 1);
        key_order.push_back(key);

        int colon = input_json.find(':', end_key);
        if (colon == string::npos) break;
        int start_arr = input_json.find('[', colon);
        int end_arr = input_json.find(']', start_arr);
        string value_str = input_json.substr(start_arr+1, end_arr - start_arr - 1);
        vector<long long> values;
        stringstream ss(value_str);
        string token;
        while (getline(ss, token, ',')) {
            while (!token.empty() && isspace(token.back())) token.pop_back();
            while (!token.empty() && isspace(token.front())) token.erase(0, 1);
            if (!token.empty()) {
                values.push_back(stoll(token));
            }
        }
        Item item;
        item.name = key;
        item.q = values[0];
        item.v = values[1];
        item.m = values[2];
        item.l = values[3];
        item.index = items.size();
        items.push_back(item);
        pos = end_arr + 1;
    }

    vector<vector<Item>> sorted_items(3);
    sorted_items[0] = items;
    sorted_items[1] = items;
    sorted_items[2] = items;

    auto by_mass_density = [](const Item& a, const Item& b) {
        double a_density = (double)a.v / a.m;
        double b_density = (double)b.v / b.m;
        return a_density > b_density;
    };

    auto by_volume_density = [](const Item& a, const Item& b) {
        double a_density = (double)a.v / a.l;
        double b_density = (double)b.v / b.l;
        return a_density > b_density;
    };

    auto by_combined_density = [](const Item& a, const Item& b) {
        double a_density = (double)a.v / a.m + (double)a.v / a.l;
        double b_density = (double)b.v / b.m + (double)b.v / b.l;
        return a_density > b_density;
    };

    sort(sorted_items[0].begin(), sorted_items[0].end(), by_mass_density);
    sort(sorted_items[1].begin(), sorted_items[1].end(), by_volume_density);
    sort(sorted_items[2].begin(), sorted_items[2].end(), by_combined_density);

    vector<vector<int>> all_counts(3);
    vector<long long> values(3, 0);

    for (int i = 0; i < 3; i++) {
        all_counts[i] = greedy(sorted_items[i]);
        long long total_value = 0;
        for (int j = 0; j < sorted_items[i].size(); j++) {
            total_value += all_counts[i][j] * sorted_items[i][j].v;
        }
        values[i] = total_value;
    }

    int best_method = 0;
    for (int i = 1; i < 3; i++) {
        if (values[i] > values[best_method]) {
            best_method = i;
        }
    }

    vector<int> best_counts = all_counts[best_method];
    vector<int> counts_by_original_index(items.size(), 0);
    for (int i = 0; i < sorted_items[best_method].size(); i++) {
        int orig_idx = sorted_items[best_method][i].index;
        counts_by_original_index[orig_idx] = best_counts[i];
    }

    cout << "{";
    for (int i = 0; i < key_order.size(); i++) {
        if (i > 0) {
            cout << ",";
        }
        cout << "\"" << key_order[i] << "\":" << counts_by_original_index[i];
    }
    cout << "}" << endl;

    return 0;
}

