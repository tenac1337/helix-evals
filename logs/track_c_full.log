    vector<string> words;
    words.reserve(n);
    for (int i = 0; i < n; i++) {
        string s;
        // Word of length i+1 with alternating X andO
        for (int j = 0; j <= i; j++) {
            s += (j % 2 == 0) ? 'X' : 'O';
        }
        words.push_back(s);
        cout << s << "\n";
    }
    cout.flush();
    
    // Compute power for each pair (u, v)
    vector<vector<long long>> power(n, vector<long long>(n));
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            SuffixAutomaton sam;
            for (char c : words[i]) sam.extend(c);
            for (char c : words[j]) sam.extend(c);
            power[i][j] = sam.countDistinctSubstrings();
        }
    }
    
    // Build map from power to pair (u, v)
    unordered_map<long long, pair<int, int>> powerToPair;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            powerToPair[power[i][j]] = {i + 1, j + 1};  // 1-indexed
        }
    }
    
    // Read q and answer queries
