using namespace std;

struct Item {
    string name;
    long long q;
    long long v;
    long long m;
    long long l;
};

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    // Read entire input
    string input((istreambuf_iterator<char>(cin)), istreambuf_iterator<char>());
    
    // Parse JSON - extract keys and values
    vector<Item> items;
    vector<string> order;
    
    size_t pos = 0;
    while (pos < input.size()) {
        // Find a key (string before colon)
        if (input[pos] == '"') {
            size_t key_start = pos + 1;
            size_t key_end = input.find('"', key_start);
            string key = input.substr(key_start, key_end - key_start);
            
            // Find the array after the key
            size_t arr_start = input.find('[', key_end);
            size_t arr_end = input.find(']', arr_start);
            string arr_content = input.substr(arr_start + 1, arr_end - arr_start - 1);
            
            // Parse 4 integers from array
            stringstream ss(arr_content);
            vector<long long> nums;
            string num_str;
            while (getline(ss, num_str, ',')) {
                // Trim whitespace
                size_t start = num_str.find_first_not_of(" \n\t");
                if (start != string::npos) {
                    size_t end = num_str.find_last_not_of(" \n\t");
                    nums.push_back(stoll(num_str.substr(start, end - start + 1)));
                }
            }
            
            if (nums.size() >= 4) {
                Item it;
                it.name = key;
                it.q = nums[0];
                it.v = nums[1];
                it.m = nums[2];
                it.l = nums[3];
                items.push_back(it);
                order.push_back(key);
            }
            
            pos = arr_end + 1;
        } else {
            pos++;
        }
    }
    
    const long long MAX_MASS = 20000000;  // 20 kg in mg
    const long long MAX_VOL = 25000000;   // 25 L in µL
    
    // Greedy by value density (value / mass) first, then adjust for volume
    // Calculate value per unit mass and volume
    struct ScoredItem {
        int idx;
        double density; // value per mass
        double volDensity; // value per volume
    };
    
    vector<ScoredItem> scored;
    for (int i = 0; i < items.size(); i++) {
        if (items[i].m > 0 && items[i].l > 0) {
            ScoredItem si;
            si.idx = i;
            si.density = (double)items[i].v / items[i].m;
            si.volDensity = (double)items[i].v / items[i].l;
            scored.push_back(si);
        }
    }
    
    // Sort by value density (descending)
    sort(scored.begin(), scored.end(), [&](const ScoredItem& a, const ScoredItem& b) {
        return a.density > b.density;
    });
    
    vector<long long> result(items.size(), 0);
    long long totalMass = 0, totalVol = 0, totalValue = 0;
    
    // Greedy selection
    for (const auto& si : scored) {
        const Item& it = items[si.idx];
        
        // Calculate how many we can take
        long long maxByMass = (MAX_MASS - totalMass) / it.m;
        long long maxByVol = (MAX_VOL - totalVol) / it.l;
        long long canTake = min({it.q, maxByMass, maxByVol});
        
        if (canTake > 0) {
            result[si.idx] = canTake;
            totalMass += canTake * it.m;
            totalVol += canTake * it.l;
            totalValue += canTake * it.v;
        }
    }
    
    // Try to improve with volume-constrained items
    // Sort by volume density for remaining capacity
    sort(scored.begin(), scored.end(), [&](const ScoredItem& a, const ScoredItem& b) {
        return a.volDensity > b.volDensity;
    });
    
    for (const auto& si : scored) {
        if (result[si.idx] >= items[si.idx].q) continue;
        
        const Item& it = items[si.idx];
        long long maxByMass = (MAX_MASS - totalMass) / it.m;
        long long maxByVol = (MAX_VOL - totalVol) / it.l;
        long long canTake = min({it.q - result[si.idx], maxByMass, maxByVol});
        
        if (canTake > 0) {
            result[si.idx] += canTake;
            totalMass += canTake * it.m;
            totalVol += canTake * it.l;
            totalValue += canTake * it.v;
        }
    }
    
    // Output JSON
    cout << "{\n";
    for (size_t i = 0; i < order.size(); i++) {
        // Find the item index for this order
        int idx = -1;
        for (int j = 0; j < items.size(); j++) {
            if (items[j].name == order[i]) {
                idx = j;
                break;
            }
        }
        cout << "    \"" << order[i] << "\": " << (idx >= 0 ? result[idx] : 0);
        if (i < order.size() - 1) cout << ",";
        cout << "\n";
    }
    cout << "}\n";
    
    return 0;
}
