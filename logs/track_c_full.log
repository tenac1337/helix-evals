using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    cin >> n;
    
    vector<vector<int>> inv(n + 2, vector<int>(n + 2, 0));
    
    for (int i = 1; i <= n; i++) {
        for (int j = i + 1; j <= n; j++) {
            cout << 0 << " " << i << " " << j << endl;
            cout.flush();
            int resp;
            cin >> resp;
            inv[i][j] = resp;
        }
    }
    
    // Compute p[i] using the formula: p[i] = i + sum_{j > i} inv[i][j] - sum_{j < i} inv[j][i]
    // This is because p[i] = 1 + (number of elements smaller than p[i])
    // = 1 + (right smaller) + (left smaller)
    // = 1 + sum_{j > i} inv[i][j] + sum_{j < i} (1 - inv[j][i])
    // = i + sum_{j > i} inv[i][j] - sum_{j < i} inv[j][i]
    vector<int> ans(n + 1);
    for (int i = 1; i <= n; i++) {
        int right_smaller = 0;
        for (int j = i + 1; j <= n; j++) {
            right_smaller += inv[i][j];
        }
        int left_smaller = 0;
        for (int j = 1; j < i; j++) {
            left_smaller += inv[j][i];
        }
        ans[i] = i + right_smaller - left_smaller;
    }
    
    // Output the answer
    cout << 1;
    for (int i = 1; i <= n; i++) {
        cout << " " << ans[i];
    }
    cout << endl;
    
    return 0;
}
