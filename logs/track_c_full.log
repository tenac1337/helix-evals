```cpp
#include <bits/stdc++.h>
using namespace std;

struct SuffixAutomaton {
    struct State {
        int next[3]; // 0='X', 1='O', 2='#'
        int link;
        int len;
        State() : link(-1), len(0) {
            next[0] = next[1] = next[2] = -1;
        }
    };
    
    vector<State> st;
    int last;
    
    SuffixAutomaton() {
        st.reserve(100000);
        st.push_back(State());
        st[0].len = 0;
        st[0].link = -1;
        last = 0;
    }
    
    void init(const string& str) {
        st.clear();
        st.reserve(str.size() * 2 + 5);
        st.push_back(State());
        st[0].len = 0;
        st[0].link = -1;
        last = 0;
        for (char ch : str) {
            int c;
            if (ch == 'X') c = 0;
            else if (ch == 'O') c = 1;
            else c = 2; // '#'
            extend(c);
        }
    }
    
    void extend(int c) {
        int cur = (int)st.size();
        st.push_back(State());
        st[cur].len = st[last].len + 1;
        int p = last;
        while (p != -1 && st[p].next[c] == -1) {
            st[p].next[c] = cur;
            p = st[p].link;
        }
        if (p == -1) {
            st[cur].link = 0;
        } else {
            int q = st[p].next[c];
            if (st[p].len + 1 == st[q].len) {
                st[cur].link = q;
            } else {
                int clone = (int)st.size();
                st.push_back(st[q]);
                st[clone].len = st[p].len + 1;
                while (p != -1 && st[p].next[c] == q) {
                    st[p].next[c] = clone;
                    p = st[p].link;
                }
                st[q].link = st[cur].link = clone;
            }
        }
        last = cur;
    }
    
    long long countDistinctSubstrings() {
        long long total = 0;
        for (int i = 1; i < (int)st.size(); i++) {
            total += st[i].len - st[st[i].link].len;
        }
        return total;
    }
};

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    if (!(cin >> n)) return 0;
    
    // Generate n distinct words
    // Strategy: use word_i = X^(2^i) + O^(i) to ensure distinct lengths and patterns
    vector<string> words;
    words.reserve(n);
    
    for (int i = 0; i < n; i++) {
        int x_len;
        if (i < 14) {
            x_len = 1 << i; // 2^i for i=0..13
        } else {
            x_len = (1 << 13) + (i - 13) * 100; // grow linearly after that
        }
        if (x_len > 30 * n) x_len = 30 * n; // cap at max length
        
        int o_len = i + 1;
        
        string w;
        w.append(x_len, 'X');
        w.append(o_len, 'O');
        words.push_back(w);
    }
    
    // Output words
    for (int i = 0; i < n; i++) {
        cout << words[i] << "\n";
    }
    cout.flush();
    
    // Read q
    int q;
    cin >> q;
    
    // Precompute all pair results
    unordered_map<long long, vector<pair<int,int>>> powerToPairs;
    
    SuffixAutomaton sa;
    
    // Reserve capacity to avoid rehashing
    powerToPairs.reserve(n * n * 2);
    
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            // Build SA for words[i] + "#" + words[j]
            string concat = words[i] + "#" + words[j];
            sa.init(concat);
            long long power = sa.countDistinctSubstrings();
            powerToPairs[power].push_back({i, j});
        }
    }
    
    // Answer queries
    for (int qi = 0; qi < q; qi++) {
        long long p;
