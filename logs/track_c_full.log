using namespace std;

struct Card {
    int suit;  // 0-3
    int value; // 1-13 (2=1,3=2,...,A=13)
};

vector<Card> myCards;
vector<Card> board;
int myStack = 100;
int pot = 10;
int currentBet = 0;
bool myTurn = false;

Card parseCard(int suit, int value) {
    return {suit, value};
}

// Check if we have a flush (5+ cards same suit)
bool isFlush(const vector<Card>& cards) {
    int counts[4] = {0};
    for (auto& c : cards) counts[c.suit]++;
    for (int i = 0; i < 4; i++) if (counts[i] >= 5) return true;
    return false;
}

// Get flush suit if we have one, -1 otherwise
int getFlushSuit(const vector<Card>& cards) {
    int counts[4] = {0};
    for (auto& c : cards) counts[c.suit]++;
    for (int i = 0; i < 4; i++) if (counts[i] >= 5) return i;
    return -1;
}

// Check for straight and return highest card (1-13), 0 if no straight
int getStraight(const vector<Card>& cards) {
    // Count unique values
    bool has[14] = {false}; // index 1-13
    for (auto& c : cards) has[c.value] = true;
    
    // Check A-2-3-4-5 (wheel)
    if (has[1] && has[2] && has[3] && has[4] && has[5]) return 5;
    
    // Check other straights
    for (int high = 13; high >= 5; high--) {
        bool straight = true;
        for (int v = high; v > high - 5; v--) {
            if (!has[v]) { straight = false; break; }
        }
        if (straight) return high;
    }
    return 0;
}

// Count multiplicities (pairs, trips, quads)
array<int, 14> getMultiplicities(const vector<Card>& cards) {
    array<int, 14> mult = {0};
    for (auto& c : cards) mult[c.value]++;
    return mult;
}

// Evaluate hand: returns pair<handType, tiebreaker>
// handType: 1=SF,2=4kind,3=full house,4=flush,5=straight,6=3kind,7=2pair,8=pair,9=high
pair<int, int> evaluateHand(const vector<Card>& allCards) {
    if (allCards.size() < 5) return {9, 0};
    
    // Check flush
    int flushSuit = getFlushSuit(allCards);
    
    // Check straight
    int straightHigh = getStraight(allCards);
    
    // Straight flush
    if (flushSuit >= 0 && straightHigh > 0) {
        // Check if straight is in flush suit
        vector<Card> flushCards;
        for (auto& c : allCards) if (c.suit == flushSuit) flushCards.push_back(c);
        bool has[14] = {false};
        for (auto& c : flushCards) has[c.value] = true;
        
        bool isSF = false;
        if (straightHigh == 5 && has[1] && has[2] && has[3] && has[4] && has[5]) isSF = true;
        else {
            bool ok = true;
            for (int v = straightHigh; v > straightHigh - 5; v--) if (!has[v]) ok = false;
            if (ok) isSF = true;
        }
        if (isSF) return {1, straightHigh};
    }
    
    // Four of a kind
    array<int,14> mult = getMultiplicities(allCards);
    for (int v = 13; v >= 1; v--) {
        if (mult[v] >= 4) {
            // Find kicker
            int kicker = 0;
            for (int w = 13; w >= 1; w--) {
                if (w != v && mult[w] >= 1) { kicker = w; break; }
            }
            return {2, v * 14 + kicker};
        }
    }
    
    // Full house
    int tripVal = -1, pairVal = -1;
    for (int v = 13; v >= 1; v--) {
        if (mult[v] >= 3) tripVal = v;
    }
    if (tripVal >= 0) {
        for (int v = 13; v >= 1; v--) {
            if (v != tripVal && mult[v] >= 2) { pairVal = v; break; }
        }
    }
    if (tripVal >= 0 && pairVal >= 0) {
        return {3, tripVal * 14 + pairVal};
    }
    
    // Flush
    if (flushSuit >= 0) {
        vector<int> values;
        for (auto& c : allCards) if (c.suit == flushSuit) values.push_back(c.value);
        sort(values.begin(), values.end(), greater<int>());
        int tie = 0;
        for (int i = 0; i < 5; i++) tie = tie * 14 + values[i];
        return{4, tie};
    }
    
    // Straight
    if (straightHigh > 0) {
        return{5, straightHigh};
    }
    
    // Three of a kind
    if (tripVal >= 0) {
        vector<int> kickers;
        for (int v = 13; v >= 1; v--) {
            if (v != tripVal) {
                for (int i = 0; i < mult[v]; i++) kickers.push_back(v);
            }
        }
        int tie = tripVal * 14 * 14 + kickers[0] * 14 + kickers[1];
        return{6, tie};
    }
    
    // Two pair
    int highPair = -1, lowPair = -1;
    for (int v = 13; v >= 1; v--) {
        if (mult[v] >= 2) {
            if (highPair == -1) highPair = v;
            else if (lowPair == -1) { lowPair = v; break; }
        }
    }
    if (highPair >= 0 && lowPair >= 0) {
        // Find kicker
        int kicker = 0;
        for (int v = 13; v >= 1; v--) {
            if (v != highPair && v != lowPair && mult[v] >= 1) { kicker = v; break; }
        }
        int tie = highPair * 14 * 14 + lowPair * 14 + kicker;
        return{7, tie};
    }
    
    // One pair
    if (highPair >= 0) {
        vector<int> kickers;
        for (int v = 13; v >= 1; v--) {
            if (v != highPair) {
                for (int i = 0; i < mult[v]; i++) kickers.push_back(v);
            }
        }
        int tie = highPair * 14 * 14 * 14 + kickers[0] * 14 * 14 + kickers[1] * 14 + kickers[2];
        return{8, tie};
    }
    
