    // rank[i] = 1 + sum of inv[i][j] for all j > i
    vector<int> rank(n + 1);
    for (int i = 1; i <= n; i++) {
        rank[i] = 1;
        for (int j = i + 1; j <= n; j++) {
            rank[i] += inv[i][j];
        }
    }
    
    // Build the permutation: position with rank k gets value k
    vector<int> ans(n + 1);
    for (int i = 1; i <= n; i++) {
        ans[rank[i]] = i;
    }
    
    // Output the answer
    cout << 1;
    for (int i = 1; i <= n; i++) {
        cout << " " << ans[i];
    }
