                int clone = st.size();
                st.push_back(st[q]);
                st[clone].len = st[p].len + 1;
                st[clone].occ = 0;
                while (p != -1 && st[p].next[ch] == q) {
                    st[p].next[ch] = clone;
                    p = st[p].link;
                }
                st[q].link = st[cur].link = clone;
            }
        }
        last = cur;
    }
    
    // Number of distinct non-empty substrings
    long long distinctSubstrings() {
        long long sum = 0;
        for (int i = 1; i < (int)st.size(); i++) {
            sum += st[i].len - st[st[i].link].len;
        }
        return sum;
    }
};

long long countDistinctSubstrings(const string& s) {
    SuffixAutomaton sa(s.size());
    for (char c : s) {
        sa.extend(c);
    }
    return sa.distinctSubstrings();
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    if (!(cin >> n)) return 0;
    
    // Generate n distinct magic words
    // Strategy: use strings of different lengths with different patterns
    // to maximize chances of unique pair powers
    vector<string> words;
    words.reserve(n);
    
    // Generate words with increasing lengths and different patterns
    for (int i = 0; i < n; i++) {
        string w;
        int len = i + 1; // start with length 1, 2, 3, ...
        
        // Create a word with pattern based on i
        // Use alternating patterns and all X's, all O's
        if (i % 3 == 0) {
            // Alternating XO
            for (int j = 0; j < len; j++) {
                w += (j % 2 == 0) ? 'X' : 'O';
            }
        } else if (i % 3 == 1) {
            // All X then O
            for (int j = 0; j < len; j++) {
                w += (j < len/2) ? 'X' : 'O';
            }
        } else {
            // All O then X
            for (int j = 0; j < len; j++) {
                w += (j < len/2) ? 'O' : 'X';
            }
        }
        words.push_back(w);
    }
    
    // Output words
    for (const string& w : words) {
        cout << w << "\n";
    }
    cout.flush();
    
    // Precompute power for all pairs
    vector<vector<long long>> power(n, vector<long long>(n, 0));
    unordered_map<long long, pair<int,int>> powerToPair;
    
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            string concat = words[i] + words[j];
            long long p = countDistinctSubstrings(concat);
            power[i][j] = p;
            // Store (i,j) - will keep last if collision (but we need unique)
            // For now store anyway, we'll handle collisions
            powerToPair[p] = {i, j};
        }
    }
    
    // Read q and answer queries
    int q;
    cin >> q;
    
    for (int qi = 0; qi < q; qi++) {
        long long p;
        cin >> p;
        
        // Look up the pair
        if (powerToPair.find(p) != powerToPair.end()) {
            auto [u, v] = powerToPair[p];
            cout << u+1 << " " << v+1 << "\n";
        } else {
            // Fallback: search exhaustively
            bool found = false;
            for (int i = 0; i < n && !found; i++) {
                for (int j = 0; j < n && !found; j++) {
                    if (power[i][j] == p) {
                        cout << i+1 << " " << j+1 << "\n";
                        found = true;
                    }
                }
            }
            if (!found) {
                // Should not happen in valid tests
                cout << "1 1\n";
            }
        }
        cout.flush();
    }
    
    return 0;
