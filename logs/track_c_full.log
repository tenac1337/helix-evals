using namespace std;

struct Item {
    string name;
    int q;
    long long v;
    long long m;
    long long l;
};

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    // Read entire input
    string input((istreambuf_iterator<char>(cin)), istreambuf_iterator<char>());
    
    // Parse JSON manually - extract keys and values
    vector<Item> items;
    map<string, Item> itemMap;
    
    // Find all key-value pairs in the JSON
    size_t pos = 0;
    while (pos < input.size()) {
        // Find a key (string before colon)
        if (input[pos] == '"') {
            size_t keyStart = pos + 1;
            size_t keyEnd = input.find('"', keyStart);
            if (keyEnd == string::npos) break;
            string key = input.substr(keyStart, keyEnd - keyStart);
            
            // Find the array after the key
            size_t arrStart = input.find('[', keyEnd);
            if (arrStart == string::npos) break;
            size_t arrEnd = input.find(']', arrStart);
            if (arrEnd == string::npos) break;
            
            string arrContent = input.substr(arrStart + 1, arrEnd - arrStart - 1);
            
            // Parse the 4 integers
            vector<long long> nums;
            string num;
            for (char c : arrContent) {
                if (isdigit(c)) {
                    num += c;
                } else if (!num.empty()) {
                    nums.push_back(stoll(num));
                    num.clear();
                }
            }
            if (!num.empty()) {
                nums.push_back(stoll(num));
            }
            
            if (nums.size() >= 4) {
                Item it;
                it.name = key;
                it.q = (int)nums[0];
                it.v = nums[1];
                it.m = nums[2];
                it.l = nums[3];
                items.push_back(it);
                itemMap[key] = it;
            }
            
            pos = arrEnd + 1;
        } else {
            pos++;
        }
    }
    
    const long long MAX_MASS = 20000000;  // 20 kg in mg
    const long long MAX_VOL = 25000000;   // 25 L in microliters
    
    // Greedy approach: sort by value/mass ratio and value/volume ratio
    // Take items greedily, but also try a few combinations
    
    // First, try simple greedy by value/(mass+volume) ratio
    struct GreedyItem {
        int idx;
        long long ratio;
    };
    
    vector<GreedyItem> greedyItems;
    for (int i = 0; i < (int)items.size(); i++) {
        long long ratio = items[i].v * 1000000 / (items[i].m + items[i].l);
        greedyItems.push_back({i, ratio};
    }
    sort(greedyItems.begin(), greedyItems.end(), [](const GreedyItem& a, const GreedyItem& b) {
        return a.ratio > b.ratio;
    });
    
    vector<int> bestSolution(items.size(), 0);
    long long bestValue = 0;
    
    // Try greedy approach
    long long currMass = 0, currVol = 0;
    vector<int> currSolution(items.size(), 0);
    for (auto& gi : greedyItems) {
        int i = gi.idx;
        // Take as many as possible
        long long maxByMass = (MAX_MASS - currMass) / items[i].m;
        long long maxByVol = (MAX_VOL - currVol) / items[i].l;
        long long take = min<long long>(items[i].q, min(maxByMass, maxByVol));
        if (take > 0) {
            currSolution[i] = (int)take;
            currMass += take * items[i].m;
            currVol += take * items[i].l;
        }
    }
    long long currValue = 0;
    for (int i = 0; i < (int)items.size(); i++) {
        currValue += (long long)currSolution[i] * items[i].v;
    }
    if (currValue > bestValue) {
        bestValue = currValue;
        bestSolution = currSolution;
    }
    
    // Try a few variations - for each item type, try taking different amounts
    // Use a simple local search: try to improve by swapping
    
    // Try each item type with different quantities
    for (int iter = 0; iter < 3; iter++) {
        for (int i = 0; i < (int)items.size(); i++) {
            // Try adding one more of this item if possible
            long long currMass = 0, currVol = 0;
            for (int j = 0; j < (int)items.size(); j++) {
                currMass += (long long)bestSolution[j] * items[j].m;
                currVol += (long long)bestSolution[j] * items[j].l;
            }
            
            if (bestSolution[i] < items[i].q) {
                long long needMass = items[i].m;
                long long needVol = items[i].l;
                if (currMass + needMass <= MAX_MASS && currVol + needVol <= MAX_VOL) {
                    // Try to remove some other items to make room
                    vector<int> testSol = bestSolution;
                    testSol[i]++;
                    
                    // Try removing items with worst ratio
                    vector<pair<long long, int>> ratios;
                    for (int j = 0; j < (int)items.size(); j++) {
                        if (testSol[j] > 0) {
                            long long r = items[j].v * 1000000 / (items[j].m + items[j].l);
                            ratios.push_back({r, j});
                        }
                    }
                    sort(ratios.begin(), ratios.end());
                    
                    // Calculate current usage
                    longlong tMass = 0, tVol = 0;
                    for (int j = 0; j < (int)items.size(); j++) {
                        tMass += (long long)testSol[j] * items[j].m;
                        tVol += (long long)testSol[j] * items[j].l;
                    }
                    
                    // Remove items with lowest ratio if over capacity
                    for (auto& pr : ratios) {
                        int j = pr.second;
                        while (testSol[j] > 0 && (tMass > MAX_MASS || tVol > MAX_VOL)) {
                            tMass -= items[j].m;
                            tVol -= items[j].l;
                            testSol[j]--;
                        }
                    }
                    
                    if (tMass <= MAX_MASS && tVol <= MAX_VOL) {
                        long long newValue = 0;
                        for (int j = 0; j < (int)items.size(); j++) {
                            newValue += (long long)testSol[j] * items[j].v;
                        }
                        if (newValue > bestValue) {
                            bestValue = newValue;
                            bestSolution = testSol;
                        }
                    }
                }
            }
        }
    }
    
    // Output JSON
    cout << "{";
    for (int i = 0; i < (int)items.size(); i++) {
        if (i > 0) cout << ",";
        cout << "\"" << items[i].name << "\":" << bestSolution[i];
    }
    cout << "}";
    
    return 0;
}
