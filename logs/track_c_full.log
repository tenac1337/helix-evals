using namespace std;

struct State {
    int next[2];
    int link;
    int len;
    State() : next{-1, -1}, link(-1), len(0) {}
};

class SuffixAutomaton {
    vector<State> st;
    int last;
public:
    SuffixAutomaton() {
        st.emplace_back();
        st[0].link = -1;
        st[0].len = 0;
        last = 0;
    }
    
    void extend(char c) {
        int cIdx = (c == 'X') ? 0 : 1;
        int cur = st.size();
        st.emplace_back();
        st[cur].len = st[last].len + 1;
        int p = last;
        while (p != -1 && st[p].next[cIdx] == -1) {
            st[p].next[cIdx] = cur;
            p = st[p].link;
        }
        if (p == -1) {
            st[cur].link = 0;
        } else {
            int q = st[p].next[cIdx];
            if (st[p].len + 1 == st[q].len) {
                st[cur].link = q;
            } else {
                int clone = st.size();
                st.push_back(st[q]);
                st[clone].len = st[p].len + 1;
                while (p != -1 && st[p].next[cIdx] == q) {
                    st[p].next[cIdx] = clone;
                    p = st[p].link;
                }
                st[q].link = st[cur].link = clone;
            }
        }
        last = cur;
    }
    
    long long countDistinctSubstrings() {
        long long sum = 0;
        for (int i = 1; i < (int)st.size(); i++) {
            sum += st[i].len - st[st[i].link].len;
        }
        return sum;
    }
};

