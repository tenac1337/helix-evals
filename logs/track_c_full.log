using namespace std;

struct SuffixAutomaton {
    struct State {
        int next[2];
        int link;
        int len;
        unordered_set<int> occ; // positions where this state appears
        State() : link(-1), len(0) {
            next[0] = next[1] = -1;
        }
    };
    
    vector<State> st;
    int last;
    string s;
    
    SuffixAutomaton(const string& str = "") {
        s = str;
        st.reserve(str.size() * 2 + 5);
        st.push_back(State());
        st[0].len = 0;
        st[0].link = -1;
        last = 0;
        for (int i = 0; i < (int)str.size(); i++) {
            extend(str[i] == 'X' ? 0 : 1);
        }
    }
    
    void extend(int c) {
        int cur = st.size();
        st.push_back(State());
        st[cur].len = st[last].len + 1;
        int p = last;
        while (p != -1 && st[p].next[c] == -1) {
            st[p].next[c] = cur;
            p = st[p].link;
        }
        if (p == -1) {
            st[cur].link = 0;
        } else {
            int q = st[p].next[c];
            if (st[p].len + 1 == st[q].len) {
                st[cur].link = q;
            } else {
                int clone = st.size();
                st.push_back(st[q]);
                st[clone].len = st[p].len + 1;
                st[clone].occ.clear();
                while (p != -1 && st[p].next[c] == q) {
                    st[p].next[c] = clone;
                    p = st[p].link;
                }
                st[q].link = st[cur].link = clone;
            }
        }
        last = cur;
    }
    
    long long countDistinctSubstrings() {
        long long total = 0;
        for (int i = 1; i < (int)st.size(); i++) {
            total += st[i].len - st[st[i].link].len;
        }
        return total;
    }
};

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    if (!(cin >> n)) return 0;
    
    // Generate n distinct random words over {X, O}
    vector<string> words;
    words.reserve(n);
    unordered_set<string> wordSet;
    
    // Use a deterministic approach: generate all possible strings of certain lengths
    // to ensure we have enough distinct ones
    vector<string> candidates;
    // Generate strings of length 1 to min(30, 30*n/n) = 30
    for (int len = 1; len <= 30 && (int)candidates.size() < n; len++) {
        int total = 1 << len; // 2^len strings
        if (total > 5000) total = 5000; // limit
        for (int mask = 0; mask < total && (int)candidates.size() < n; mask++) {
            string s;
            for (int i = 0; i < len; i++) {
                s += (mask & (1 << i)) ? 'O' : 'X';
            }
            candidates.push_back(s);
        }
