int getHandStrength() {
    vector<Card> all = myCards;
    all.insert(all.end(), board.begin(), board.end());
    auto [ht, tie] = evaluateHand(all);
    return ht;
}

// Simple decision logic
string getAction() {
    int strength = getHandStrength();
    int toCall = currentBet;
    
    // Preflop: only have 2 cards
    if (board.empty()) {
        // Check if we can check
        if (toCall == 0) {
            if (strength <= 3) return "CHECK";  // Good cards, check to see cheap flop
            return "CHECK";  // Just check
        }
        // Facing a bet
        if (strength <= 2) {
            // Call or raise if have good cards
            if (myStack > toCall + 10) {
                int raiseAmt = min(myStack, toCall + 20);
                return "RAISE " + to_string(raiseAmt);
            }
            if (myStack >= toCall) return "CALL";
        }
        // Weak hand, might fold
        if (strength >= 6 && toCall > 5) return "FOLD";
        if (myStack >= toCall) return "CALL";
        return "FOLD";
    }
    
    // Post-flop
    if (toCall == 0) {
        // Can check
        if (strength <= 4) {
            // Good hand, consider betting for value
            int bet = min(pot / 2, myStack);
            if (bet >= 1) return "RAISE " + to_string(bet);
        }
        return "CHECK";
    }
    
    // Facing a bet
    if (strength <= 3) {
        // Strong hand, raise
        int raiseAmt = min(myStack, toCall * 2);
        if (raiseAmt >= 1) return "RAISE " + to_string(raiseAmt);
        if (myStack >= toCall) return "CALL";
    }
    if (strength <= 5) {
        // Medium strength, call if reasonable
        if (myStack >= toCall && toCall <= pot / 3) return "CALL";
    }
    // Weak hand
    if (toCall > pot / 2) return "FOLD";
    if (myStack >= toCall) return "CALL";
    return "FOLD";
}

