using namespace std;

struct Piece {
    vector<pair<int,int>> cells;
    int k;
    int minx, maxx, miny, maxy;
    int w, h;
};

Piece normalize_piece(const vector<pair<int,int>>& cells) {
    Piece p;
    p.cells = cells;
    p.k = cells.size();
    p.minx = INT_MAX; p.maxx = INT_MIN;
    p.miny = INT_MAX; p.maxy = INT_MIN;
    for (auto [x,y] : cells) {
        p.minx = min(p.minx, x);
        p.maxx = max(p.maxx, x);
        p.miny = min(p.miny, y);
        p.maxy = max(p.maxy, y);
    }
    p.w = p.maxx - p.minx + 1;
    p.h = p.maxy - p.miny + 1;
    return p;
}

