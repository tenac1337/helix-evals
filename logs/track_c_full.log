        }
        cout.flush();
        int resp;
        cin >> resp;
        freq[v] = resp;
    }

    // Greedy assignment: for each position, find which value belongs there
    for (int pos = 0; pos < n; pos++) {
        // Try values that still have remaining frequency
        for (int v = 1; v <= n; v++) {
            if (freq[v] <= 0 || used[v]) continue;

            // Create query with v at current position, 1 elsewhere
            cout << 0 << " ";
            for (int i = 0; i < n; i++) {
                if (i == pos) {
                    cout << v << (i + 1 == n ? "\n" : " ");
                } else {
                    cout << 1 << (i + 1 == n ? "\n" : " ");
                }
            }
            cout.flush();
            int resp;
            cin >> resp;

            // If we get more matches than before, v is at this position
            // We had 0 matches before (since we haven't placed anything correctly yet)
            // Actually, we need to track current match count
            // Let's simplify: if resp > 0, we found a match
            if (resp > 0) {
                perm[pos] = v;
                used[v] = 1;
                freq[v]--;
                break;
            }
        }
    }

    // Output the guess
    cout << 1 << " ";
    for (int i = 0; i < n; i++) {
        cout << perm[i] << (i + 1 == n ? "\n" : " ");
    }
    cout.flush();

    return 0;
}
