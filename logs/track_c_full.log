    auto query = [&](int x, int y) -> long long {
        if(x < 1 || x > n || y < 1 || y > n) {
            return -1;
        }
        if(cache[x][y] == -1) {
            cout << "QUERY " << x << " " << y << endl;
            long long val;
            cin >> val;
            cache[x][y] = val;
        }
        return cache[x][y];
