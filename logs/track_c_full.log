                neighbor_degrees.push_back(deg);
                neighbor_flags.push_back(flag);
            }
            
            // Strategy:
            // 1. If there are unvisited neighbors (flag=0), always pick one
            //    - Prefer leaves (degree 1) first, then lowest degree
            //    - This handles dead-ends early to avoid returning later
            // 2. If ALL neighbors are visited (flag=1), we need to be smarter:
            //    - Check if any neighbor has UNVISITED neighbors itself
            //    - A neighbor has unvisited neighbors if it shows flag=0 on any edge
            //    - Since we only see our current vertex's perspective, we need to infer:
            //      If a neighbor is visited but has degree > 1, it might have unvisited neighbors
            //    - Prefer neighbors with higher degree (more likely to have unvisited neighbors)
            //    - Also prefer neighbors that are leaves (degree 1) if all else equal - 
            //      they won't lead us astray
            
            int choice = 1;
            
            // First, check if there are any unvisited neighbors
            bool has_unvisited = false;
            for (int flag : neighbor_flags) {
                if (flag == 0) {
                    has_unvisited = true;
                    break;
                }
            }
            
            if (has_unvisited) {
                // Find unvisited neighbor
                // Priority: degree 1 (leaf) first, then lowest degree
                int best_idx = -1;
                int best_score = INT_MAX; // lower is better: prefer degree 1, then lower degree
                
                for (int i = 0; i < d; ++i) {
                    if (neighbor_flags[i] == 0) {
                        int score = neighbor_degrees[i];
                        if (score < best_score) {
                            best_score = score;
                            best_idx = i;
                        }
                    }
                }
                choice = best_idx + 1;
            } else {
                // All neighbors are visited
                // Strategy: we want to find a path to unvisited vertices
                // Look for neighbors that are likely to lead to unvisited areas
                //
                // Key insight: A visited vertex with higher degree is more likely 
                // to have unvisited neighbors (edges to vertices we haven't reached)
                // A visited leaf (degree 1) is a dead-end - all its neighbors are visited
                //
                // Also, prefer neighbors with degree > 1 as they may have paths to unvisited vertices
                
                int best_idx = -1;
                int best_score = -1; // higher is better: prefer degree > 1, then higher degree
                
                for (int i = 0; i < d; ++i) {
