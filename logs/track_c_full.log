                int length;
                if (len > lenDown) {
                    orientation = 'H';
                    length = len;
                } else {
                    orientation = 'V';
                    length = lenDown;
                }
                
                vehicles.push_back({id, i, j, length, orientation};
                
                // Mark cells as visited
                if (orientation == 'H') {
                    for (int k = 0; k < length; k++) {
                        visited[i][j+k] = true;
                    }
                } else {
                    for (int k = 0; k < length; k++) {
                        visited[i+k][j] = true;
                    }
