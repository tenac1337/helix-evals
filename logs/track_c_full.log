    // Minimum is at (1,1), maximum is at (n,n)
    long long lo = query(1, 1);
    long long hi = query(n, n);
    
    // Sample some diagonal elements to tighten bounds further
    // This helps when min/max are far apart
    int sampleStep = max(1, (int)n / 50);  // Sample ~50 diagonal elements
    for (int i = 1; i <= n; i += sampleStep) {
        long long val = query(i, i);
        lo = min(lo, val);
        hi = max(hi, val);
    }
    
