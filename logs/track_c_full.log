        if (solve_time > best_solve) {
            best_solve = solve_time;
            best_move = {id, d};
            best_state = next;
        }
    }
    
    // If no move improves, try two moves
    if (best_solve <= initial_solve) {
        // Try depth-2 search
        for (auto [id1, d1] : moves) {
