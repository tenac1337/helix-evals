            while (curr < input.size() && (input[curr] == ' ' || input[curr] == '\t' || input[curr] == '\n' || input[curr] == ',' || input[curr] == ']')) {
                if (input[curr] == ']') break;
                curr++;
            }
            if (curr >= input.size() || input[curr] == ']') break;
            
            // Parse number
            size_t numStart = curr;
            while (curr < input.size() && (isdigit(input[curr]) || input[curr] == '-')) {
                curr++;
            }
            if (curr > numStart) {
                string numStr = input.substr(numStart, curr - numStart);
                nums.push_back(stoll(numStr));
            }
