        if (nums.size() >= 4) {
            Item it;
            it.name = key;
            it.q = nums[0];
            it.v = nums[1];
            it.m = nums[2];
            it.l = nums[3];
            items.push_back(it);
            nameToIdx[key] = items.size() - 1;
        }
        
        pos = curr;
    }
    
    const long long MAX_MASS = 20LL * 1000000;   // 20 kg in mg
    const long long MAX_VOL = 25LL * 1000000;    // 25 L in µL
    
