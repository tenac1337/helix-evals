};

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    // Read entire input
    string input((istreambuf_iterator<char>(cin)), istreambuf_iterator<char>());
    
    vector<Item> items;
    map<string, int> name_to_idx;
    
    size_t pos = 0;
    while (pos < input.size()) {
        if (input[pos] == '"') {
            size_t start = pos + 1;
            size_t end = input.find('"', start);
            string key = input.substr(start, end - start);
            
            size_t arr_start = input.find('[', end);
            size_t arr_end = input.find(']', arr_start);
            string arr_str = input.substr(arr_start + 1, arr_end - arr_start - 1);
            
            stringstream ss(arr_str);
            vector<long long> nums;
            string num;
            while (getline(ss, num, ',')) {
                nums.push_back(stoll(num));
            }
            
            if (nums.size() >= 4) {
                Item it;
                it.name = key;
                it.q = nums[0];
                it.v = nums[1];
                it.m = nums[2];
                it.l = nums[3];
                items.push_back(it);
                name_to_idx[key] = items.size() - 1;
            }
            
            pos = arr_end + 1;
        } else {
            pos++;
        }
    }
    
    const long long MAX_MASS = 20000000LL;
    const long long MAX_VOL = 25000000LL;
    
    int n = items.size();
    
    // Binary decomposition of quantities
    struct SplitItem {
        int orig_idx;
        long long count;
        long long value;
        long long mass;
        long long volume;
    };
    
    vector<SplitItem> split_items;
    
    for (int i = 0; i < n; i++) {
        long long q = items[i].q;
        long long v = items[i].v;
        long long m = items[i].m;
        long long l = items[i].l;
        
        long long pow = 1;
        while (q > 0) {
            long long take = min(pow, q);
            split_items.push_back({i, take, take * v, take * m, take * l};
            q -= take;
            pow <<= 1;
        }
    }
    
    int total_items = split_items.size();
    
    // Meet-in-the-middle
    int mid = total_items / 2;
    
    struct State {
        long long mass;
        long long volume;
        long long value;
        int mask_first;
        int mask_second;
    };
    
    vector<State> first_states;
    vector<State> second_states;
    
    // Generate first half subsets
    int first_count = mid;
    for (int mask = 0; mask < (1 << first_count); mask++) {
        long long mass = 0, vol = 0, val = 0;
        for (int i = 0; i < first_count; i++) {
            if (mask & (1 << i)) {
                const auto& si = split_items[i];
                mass += si.mass;
                vol += si.volume;
                val += si.value;
            }
        }
        if (mass <= MAX_MASS && vol <= MAX_VOL) {
            first_states.push_back({mass, vol, val, mask, 0});
        }
    }
    
    // Generate second half subsets
    int second_count = total_items - mid;
    for (int mask = 0; mask < (1 << second_count); mask++) {
        long long mass = 0, vol = 0, val = 0;
        for (int i = 0; i < second_count; i++) {
            if (mask & (1 << i)) {
                const auto& si = split_items[mid + i];
                mass += si.mass;
                vol += si.volume;
                val += si.value;
            }
        }
        if (mass <= MAX_MASS && vol <= MAX_VOL) {
            second_states.push_back({mass, vol, val, 0, mask});
        }
    }
    
    // Sort second_states by volume for efficient searching
    sort(second_states.begin(), second_states.end(), [](const State& a, const State& b) {
        return a.volume < b.volume;
    });
    
    // For each first state, find best matching second state
    long long best_value = 0;
    int best_first_mask = 0;
    int best_second_mask = 0;
    
    for (const auto& fs : first_states) {
        long long remaining_mass = MAX_MASS - fs.mass;
        long long remaining_vol = MAX_VOL - fs.volume;
        
        // Binary search for best second state that fits
        int lo = 0, hi = second_states.size() - 1, best_idx = -1;
        while (lo <= hi) {
            int mid_idx = (lo + hi) / 2;
            const auto& ss = second_states[mid_idx];
            if (ss.mass <= remaining_mass && ss.volume <= remaining_vol) {
                best_idx = mid_idx;
                lo = mid_idx + 1;
            } else {
                hi = mid_idx - 1;
            }
        }
        
        if (best_idx >= 0) {
            const auto& best_ss = second_states[best_idx];
            long long total_val = fs.value + best_ss.value;
            if (total_val > best_value) {
                best_value = total_val;
                best_first_mask = fs.mask_first;
                best_second_mask = best_ss.mask_second;
            }
        }
    }
    
    // Reconstruct solution
    vector<long long> take(n, 0);
    
    // Process first half
    for (int i = 0; i < first_count; i++) {
        if (best_first_mask & (1 << i)) {
            const auto& si = split_items[i];
            take[si.orig_idx] += si.count;
        }
    }
    
    // Process second half
    for (int i = 0; i < second_count; i++) {
        if (best_second_mask & (1 << i)) {
            const auto& si = split_items[mid + i];
            take[si.orig_idx] += si.count;
        }
    }
    
    // Output JSON
    cout << "{";
    for (int i = 0; i < n; i++) {
        if (i > 0) cout << ",";
        cout << "\"" << items[i].name << "\":" << take[i];
    }
    cout << "}";
    
    return 0;
