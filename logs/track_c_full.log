int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    cin >> n;
    
    // For each position i, we need to find how many elements to the right are smaller.
    // Query only adjacent pairs (i, i+1) to get whether p[i] > p[i+1].
    // This gives us enough info to determine the rank of each element.
    
    // Vector to store the rank (number of smaller elements to the right + 1) for each position
    vector<int> rank(n + 1, 1);
    
    // Track which positions have been processed
    vector<int> processed(n + 1, 0);
    
    // Query adjacent pairs to determine relative ordering
    for (int i = 1; i < n; i++) {
        cout << 0 << " " << i << " " << i + 1 << endl;
        cout.flush();
        int resp;
        cin >> resp;
        
        // If resp = 1, then p[i] > p[i+1], so p[i+1] is smaller
        // If resp = 0, then p[i] < p[i+1], so p[i] is smaller
        if (resp == 1) {
            // p[i] > p[i+1], meaning p[i+1] is smaller than p[i]
            // Increment rank of position i (it has one more smaller element to its right)
            rank[i]++;
        } else {
            // p[i] < p[i+1], meaning p[i] is smaller than p[i+1]
            // Increment rank of position i+1 (it has one more smaller element to its right)
            rank[i + 1]++;
        }
    }
    
    // Now we have the rank of each position
    // rank[i] = number of elements smaller than p[i] that appear after position i, plus 1
    // This is equivalent to: the value at position i is the rank[i]-th smallest
    
    // Build the permutation: position with rank k gets value k
    vector<int> ans(n + 1);
    for (int i = 1; i <= n; i++) {
        ans[rank[i]] = i;
    }
    
    // Output the answer
    cout << 1;
    for (int i = 1; i <= n; i++) {
        cout << " " << ans[i];
    }
    cout << endl;
    
    return 0;
}
