int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    double p;
    while (cin >> p) {
        int s_i, s_j, t_i, t_j;
        cin >> s_i >> s_j;
        cin >> t_i >> t_j;

        vector<string> H(19);
        for (int i = 0; i < 19; i++) {
            cin >> H[i];
        }

        vector<string> V(20);
        for (int i = 0; i < 20; i++) {
            cin >> V[i];
        }

        if (s_i == t_i && s_j == t_j) {
            cout << endl;
            continue;
        }

        vector<vector<bool>> visited(20, vector<bool>(20, false));
        vector<vector<pair<int, int>>> parent(20, vector<pair<int, int>>(20, {-1, -1}));
        vector<vector<char>> move_used(20, vector<char>(20, 0));

        queue<pair<int, int>> q;
        q.push({s_i, s_j});
        visited[s_i][s_j] = true;

        int di[4] = {-1, 1, 0, 0};
        int dj[4] = {0, 0, -1, 1};
        char dir[4] = {'U', 'D', 'L', 'R'};

        bool found = false;
        while (!q.empty()) {
            int i = q.front().first;
            int j = q.front().second;
            q.pop();

            if (i == t_i && j == t_j) {
                found = true;
                break;
            }

            for (int d = 0; d < 4; d++) {
                int ni = i + di[d];
                int nj = j + dj[d];
                bool can_move = false;

                if (d == 0) { // U
                    if (i > 0) {
                        if (H[i-1][j] == '0') {
                            can_move = true;
                        }
                    }
                } else if (d == 1) { // D
                    if (i < 19) {
                        if (H[i][j] == '0') {
                            can_move = true;
                        }
                    }
                } else if (d == 2) { // L
                    if (j > 0) {
                        if (V[i][j-1] == '0') {
                            can_move = true;
                        }
                    }
                } else if (d == 3) { // R
                    if (j < 19) {
                        if (V[i][j] == '0') {
                            can_move = true;
                        }
                    }
                }

                if (!can_move) continue;
                if (ni < 0 || ni >= 20 || nj < 0 || nj >= 20) continue;
                if (visited[ni][nj]) continue;

                visited[ni][nj] = true;
                parent[ni][nj] = {i, j};
                move_used[ni][nj] = dir[d];
                q.push({ni, nj});
            }
        }

        if (!found) {
            cout << endl;
            continue;
        }

        string path = "";
        int i = t_i, j = t_j;
        while (i != s_i || j != s_j) {
            path = move_used[i][j] + path;
            int pi = parent[i][j].first;
            int pj = parent[i][j].second;
            i = pi;
            j = pj;
        }

        int L = path.length();
        if (L == 0) {
            cout << endl;
            continue;
        }
        int k = 200 / L;
        string result = "";
        for (int i = 0; i < k; i++) {
            result += path;
        }
        cout << result << endl;
    }

    return 0;
}
