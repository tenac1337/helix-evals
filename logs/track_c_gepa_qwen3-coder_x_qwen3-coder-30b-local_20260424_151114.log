using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    int n;
    if (!(cin >> n)) return 0;
    
    vector<vector<pair<int,int>>> pieces(n);
    vector<int> widths(n), heights(n);
    int total_cells = 0;
    
    for (int i = 0; i < n; ++i) {
        int k; cin >> k;
        total_cells += k;
        int mnx=INT_MAX, mxx=INT_MIN, mny=INT_MAX, mxy=INT_MIN;
        pieces[i].resize(k);
        for (int j = 0; j < k; ++j) {
            int x, y; cin >> x >> y;
            pieces[i][j] = {x, y};
            mnx=min(mnx,x); mxx=max(mxx,x);
            mny=min(mny,y); mxy=max(mxy,y);
        }
        widths[i] = mxx - mnx + 1;
        heights[i] = mxy - mny + 1;
    }
    
    // Try different arrangements to find a good packing
    // Simple greedy approach: place in a row, but try rotations and reflections
    vector<vector<pair<int,int>>> all_transforms;
    vector<pair<int,int>> placements(n);
    vector<int> rotations(n);
    vector<int> flips(n);
    
    // Precompute all 8 transformations for each piece
    vector<vector<vector<pair<int,int>>>> all_forms(n);
    for (int i = 0; i < n; ++i) {
        vector<vector<pair<int,int>>> forms(8);
        for (int r = 0; r < 4; ++r) {
            for (int f = 0; f < 2; ++f) {
                int idx = r * 2 + f;
                forms[idx].clear();
                for (auto& p : pieces[i]) {
                    int x = p.first, y = p.second;
                    if (f) x = -x;
                    for (int rot = 0; rot < r; ++rot) {
                        int tmp = x;
                        x = y;
                        y = -tmp;
                    }
                    forms[idx].push_back({x, y});
                }
            }
        }
        all_forms[i] = forms;
    }
    
    // Simple greedy packing in a row
    int cur_x = 0, cur_y = 0;
    int max_w = 0, max_h = 0;
    vector<vector<bool>> grid(1000, vector<bool>(1000, false));
    vector<pair<int,int>> pos(n);
    vector<int> rot(n), flip(n);
    
    for (int i = 0; i < n; ++i) {
        int best_w = INT_MAX, best_h = INT_MAX;
        int best_rot = 0, best_flip = 0;
        int best_x = 0, best_y = 0;
        
        // Try all rotations and reflections
        for (int r = 0; r < 4; ++r) {
            for (int f = 0; f < 2; ++f) {
                int idx = r * 2 + f;
                int minx = INT_MAX, maxx = INT_MIN;
                int miny = INT_MAX, maxy = INT_MIN;
                for (auto& p : all_forms[i][idx]) {
                    minx = min(minx, p.first);
                    maxx = max(maxx, p.first);
                    miny = min(miny, p.second);
                    maxy = max(maxy, p.second);
                }
                int w = maxx - minx + 1;
                int h = maxy - miny + 1;
                if (w * h < best_w * best_h) {
                    best_w = w;
                    best_h = h;
                    best_rot = r;
                    best_flip = f;
                }
            }
        }
        
        // Place it at current position
        rot[i] = best_rot;
        flip[i] = best_flip;
        int minx = INT_MAX, maxx = INT_MIN;
        int miny = INT_MAX, maxy = INT_MIN;
        for (auto& p : all_forms[i][best_rot * 2 + best_flip]) {
            minx = min(minx, p.first);
            maxx = max(maxx, p.first);
            miny = min(miny, p.second);
            maxy = max(maxy, p.second);
        }
        int x = cur_x - minx;
        int y = cur_y - miny;
        pos[i] = {x, y};
        cur_x += best_w;
        max_w = max(max_w, cur_x);
        max_h = max(max_h, y + best_h);
    }
    
    // Output the result
    cout << max_w << " " << max_h << "\n";
    for (int i = 0; i < n; ++i) {
        cout << pos[i].first << " " << pos[i].second << " " << rot[i] << " " << flip[i] << "\n";
    }
    
    return 0;
}
