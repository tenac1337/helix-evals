        for (int r = 0; r < 4; ++r) {
            vector<pair<int,int>> form;
            for (auto& p : shape) {
                int x = p.first, y = p.second;
                for (int _ = 0; _ < r; ++_) {
                    tie(x, y) = make_pair(y, -x);
                }
                form.push_back({x, y});
            }
            rotations[r] = form;
        }
        
        // Original and reflected versions
        for (int r = 0; r < 4; ++r) {
            forms.push_back(rotations[r]);
            vector<pair<int,int>> reflected = rotations[r];
            for (auto& p : reflected) {
                p.first = -p.first;
            }
            forms.push_back(reflected);
        }
        
        // Normalize each form to start at (0,0)
        for (auto& form : forms) {
            int minx = INT_MAX, miny = INT_MAX;
            for (auto& p : form) {
