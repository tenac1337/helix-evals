    int row_h = max_height;
    if (row_w * row_h < best_w * best_h || (row_w * row_h == best_w * best_h && row_h < best_h)) {
        best_w = row_w;
        best_h = row_h;
        for (int i = 0; i < n; ++i) {
            get<0>(best_placement[i]) = (i == 0) ? 0 : get<0>(best_placement[i-1]) + widths[i-1];
