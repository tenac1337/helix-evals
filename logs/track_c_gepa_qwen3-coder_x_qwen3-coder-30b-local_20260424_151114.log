int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    int n;
    if (!(cin >> n)) return 0;
    
    vector<vector<pair<int,int>>> pieces(n);
    vector<int> widths(n), heights(n);
    int total_cells = 0;
    
    for (int i = 0; i < n; ++i) {
        int k; cin >> k;
        total_cells += k;
        int mnx=INT_MAX, mxx=INT_MIN, mny=INT_MAX, mxy=INT_MIN;
        pieces[i].resize(k);
        for (int j = 0; j < k; ++j) {
            int x, y; cin >> x >> y;
            pieces[i][j] = {x, y};
            mnx=min(mnx,x); mxx=max(mxx,x);
            mny=min(mny,y); mxy=max(mxy,y);
        }
        widths[i] = mxx - mnx + 1;
        heights[i] = mxy - mny + 1;
    }
    
    // Try different arrangements to find a good packing
    // Start with a simple row-wise arrangement and try to improve
    
    vector<pair<int,int>> dims(n); // width, height for each piece
    for (int i = 0; i < n; ++i) {
        dims[i] = {widths[i], heights[i]};
    }
    
    // Create all rotations and reflections of each piece
    vector<vector<vector<pair<int,int>>>> all_forms(n);
    for (int i = 0; i < n; ++i) {
        vector<vector<pair<int,int>>> forms;
        vector<pair<int,int>>& shape = pieces[i];
        
        // Original shape
        vector<pair<int,int>> form = shape;
        forms.push_back(form);
        
        // 90° clockwise
        vector<pair<int,int>> form90;
        for (auto& p : shape) {
            form90.push_back({p.second, -p.first});
        }
        forms.push_back(form90);
        
        // 180°
        vector<pair<int,int>> form180;
        for (auto& p : shape) {
            form180.push_back({-p.first, -p.second});
        }
        forms.push_back(form180);
        
        // 270° clockwise
        vector<pair<int,int>> form270;
        for (auto& p : shape) {
            form270.push_back({-p.second, p.first});
        }
        forms.push_back(form270);
        
        // Reflected versions
        for (int r = 0; r < 4; ++r) {
            vector<pair<int,int>> reflected = forms[r];
            for (auto& p : reflected) {
                p.first = -p.first;
            }
            forms.push_back(reflected);
        }
        
        // Normalize each form to start at (0,0)
        for (auto& form : forms) {
            int minx = INT_MAX, miny = INT_MAX;
            for (auto& p : form) {
                minx = min(minx, p.first);
                miny = min(miny, p.second);
            }
            for (auto& p : form) {
                p.first -= minx;
                p.second -= miny;
            }
        }
        
        all_forms[i] = forms;
    }
    
    // Simple greedy approach: place pieces in a row
    int cur_x = 0, cur_y = 0;
    int max_h = 0;
    vector<pair<int,int>> positions(n);
    vector<int> rotations(n);
    vector<int> flips(n);
    vector<pair<int,int>> piece_sizes(n);
    
    for (int i = 0; i < n; ++i) {
        piece_sizes[i] = {widths[i], heights[i]};
    }
    
    // Place in a row
    int total_width = 0;
    int max_height = 0;
    cur_x = 0;
    cur_y = 0;
    vector<pair<int,int>> row_positions(n);
    vector<int> row_rotations(n);
    vector<int> row_flips(n);
    
    // Try placing all pieces in a single row
    int row_width = 0;
    int row_height = 0;
    for (int i = 0; i < n; ++i) {
        row_width += widths[i];
        row_height = max(row_height, heights[i]);
    }
    
    // Try placing pieces in a column
    int col_width = 0;
    int col_height = 0;
    for (int i = 0; i < n; ++i) {
        col_width = max(col_width, widths[i]);
        col_height += heights[i];
    }
    
    // Choose better orientation
    int best_w = row_width;
    int best_h = row_height;
    int best_area = best_w * best_h;
    bool use_row = true;
    
    if (col_width * col_height < best_area) {
        best_w = col_width;
        best_h = col_height;
        best_area = best_w * best_h;
        use_row = false;
    }
    
    // Place pieces
    if (use_row) {
        int x = 0;
        int max_h = 0;
        for (int i = 0; i < n; ++i) {
            positions[i] = {x, 0};
            rotations[i] = 0;
            flips[i] = 0;
            x += widths[i];
            max_h = max(max_h, heights[i]);
        }
        best_h = max_h;
    } else {
        int y = 0;
        int max_w = 0;
        for (int i = 0; i < n; ++i) {
            positions[i] = {0, y};
            rotations[i] = 0;
            flips[i] = 0;
            y += heights[i];
            max_w = max(max_w, widths[i]);
        }
        best_w = max_w;
    }
    
    cout << best_w << " " << best_h << "\n";
    for (int i = 0; i < n; ++i) {
        cout << positions[i].first << " " << positions[i].second << " " << rotations[i] << " " << flips[i] << "\n";
    }
    
    return 0;
}
