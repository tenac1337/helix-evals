        int best_area = INT_MAX;
        int best_r = 0, best_f = 0;
        int best_x = 0, best_y = 0;
        
        // Try each transformation of the current piece
        for (size_t t = 0; t < all_transforms[i].size(); ++t) {
            const auto& cells = all_transforms[i][t];
            auto [min_x, min_y] = piece_bboxes[i][t];
            
            // Try placing it at (cur_x, cur_y) with this transformation
            int x = cur_x - min_x;
            int y = cur_y - min_y;
            
            // Check if it overlaps with existing pieces
            if (check_overlap(placed_cells, cells, x, y)) continue;
            
            // Compute area of bounding box
            int max_x_t = x + 0, max_y_t = y + 0;
            for (const auto& p : cells) {
                max_x_t = max(max_x_t, x + p.first);
                max_y_t = max(max_y_t, y + p.second);
            }
            
            int area = max_x_t * max_y_t;
            if (area < best_area) {
                best_area = area;
                best_r = t % 4;
                best_f = t >= 4;
                best_x = x;
                best_y = y;
            }
        }
        
        // Place the piece
        positions[i] = {best_x, best_y};
        rotations[i] = best_r;
        flips[i] = best_f;
        
        // Add cells to placed_cells
        const auto& cells = all_transforms[i][best_r + (best_f ? 4 : 0)];
        for (const auto& p : cells) {
            placed_cells.push_back({best_x + p.first, best_y + p.second});
        }
        
        // Update current position for next piece
        int min_x, min_y;
        tie(min_x, min_y) = piece_bboxes[i][best_r + (best_f ? 4 : 0)];
        cur_x += (min_x < 0 ? -min_x : 0) + 1;
    }
    
    // Final bounding box
    int final_max_x = 0, final_max_y = 0;
    for (const auto& p : placed_cells) {
        final_max_x = max(final_max_x, p.first);
        final_max_y = max(final_max_y, p.second);
    }
    
