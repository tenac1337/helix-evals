using namespace std;

struct Polyomino {
    vector<pair<int,int>> cells;
    int min_x, max_x, min_y, max_y;
    int width, height;
    
    Polyomino(const vector<pair<int,int>>& c) : cells(c) {
        min_x = min_y = INT_MAX;
        max_x = max_y = INT_MIN;
        for (auto& p : cells) {
            min_x = min(min_x, p.first);
            max_x = max(max_x, p.first);
            min_y = min(min_y, p.second);
            max_y = max(max_y, p.second);
        }
        width = max_x - min_x + 1;
        height = max_y - min_y + 1;
    }
    
    vector<pair<int,int>> get_transformed_cells(int x, int y, int rot, bool flip) const {
        vector<pair<int,int>> result;
        for (auto& p : cells) {
            int px = p.first, py = p.second;
            if (flip) px = -px;
            for (int i = 0; i < rot; ++i) {
                int tmp = px;
                px = py;
                py = -tmp;
            }
            result.push_back({px + x, py + y});
        }
        return result;
    }
};

