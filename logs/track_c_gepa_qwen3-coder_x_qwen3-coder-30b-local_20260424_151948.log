        for (auto& p : rotations[r]) {
            int x = p.first, y = p.second;
            p = {y, -x}; // Rotate 90° clockwise
        }
    }
    
    // Generate 8 transformations: 4 rotations × 2 reflections (including identity)
    for (int i = 0; i < 4; ++i) {
        transformations.push_back(rotations[i]);
        vector<pair<int,int>> reflected = rotations[i];
        for (auto& p : reflected) p.first = -p.first;
        transformations.push_back(reflected);
    }
    
    // Remove duplicates
    set<vector<pair<int,int>>> unique_transforms(transformations.begin(), transformations.end());
    transformations.assign(unique_transforms.begin(), unique_transforms.end());
    
    return transformations;
}

// Function to compute bounding box of a set of cells
pair<int,int> get_min_max(const vector<pair<int,int>>& cells) {
    int min_x = INT_MAX, max_x = INT_MIN;
    int min_y = INT_MAX, max_y = INT_MIN;
    for (const auto& p : cells) {
        min_x = min(min_x, p.first);
        max_x = max(max_x, p.first);
        min_y = min(min_y, p.second);
        max_y = max(max_y, p.second);
    }
    return {min_x, min_y};
}

// Function to check if placing a polyomino at (x,y) with given rotation/reflection causes overlap
bool check_overlap(const vector<pair<int,int>>& placed_cells, const vector<pair<int,int>>& new_cells, int x, int y) {
    set<pair<int,int>> placed_set(placed_cells.begin(), placed_cells.end());
    for (const auto& p : new_cells) {
        int px = p.first + x;
        int py = p.second + y;
        if (placed_set.count({px, py})) return true;
    }
    return false;
}

