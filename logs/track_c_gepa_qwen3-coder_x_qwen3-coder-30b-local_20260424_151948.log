using namespace std;

struct Polyomino {
    vector<pair<int, int>> cells;
    int min_x, max_x, min_y, max_y;
    int area;
    
    Polyomino() : min_x(0), max_x(0), min_y(0), max_y(0), area(0) {}
    
    void init(const vector<pair<int, int>>& input_cells) {
        cells = input_cells;
        area = input_cells.size();
        min_x = max_x = input_cells[0].first;
        min_y = max_y = input_cells[0].second;
        for (const auto& p : input_cells) {
            min_x = min(min_x, p.first);
            max_x = max(max_x, p.first);
            min_y = min(min_y, p.second);
            max_y = max(max_y, p.second);
        }
    }
    
    vector<vector<pair<int, int>>> get_transforms() const {
        vector<vector<pair<int, int>>> transforms;
        // 4 rotations + 4 rotations with reflection
        vector<vector<pair<int, int>>> rotations = {
            {{1, 0}, {0, 1}},   // 0°
            {{0, -1}, {1, 0}},  // 90°
            {{-1, 0}, {0, -1}}, // 180°
            {{0, 1}, {-1, 0}}   // 270°
        };
        
        for (int r = 0; r < 4; ++r) {
            vector<pair<int, int>> rotated;
            for (const auto& p : cells) {
                int x = p.first * rotations[r][0].first + p.second * rotations[r][0].second;
                int y = p.first * rotations[r][1].first + p.second * rotations[r][1].second;
                rotated.push_back({x, y});
            }
            transforms.push_back(rotated);
        }
        
        for (int r = 0; r < 4; ++r) {
            vector<pair<int, int>> reflected_rotated;
            for (const auto& p : cells) {
                int x = p.first * rotations[r][0].first + p.second * rotations[r][0].second;
                int y = p.first * rotations[r][1].first + p.second * rotations[r][1].second;
                reflected_rotated.push_back({-x, y});
            }
            transforms.push_back(reflected_rotated);
        }
        
        return transforms;
    }
};

