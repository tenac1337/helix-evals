using namespace std;

struct Polyomino {
    vector<pair<int,int>> cells;
    int minx, maxx, miny, maxy;
    int area;
    
    Polyomino() : minx(0), maxx(0), miny(0), maxy(0), area(0) {}
    
    void init(const vector<pair<int,int>>& input_cells) {
        cells = input_cells;
        area = cells.size();
        minx = miny = INT_MAX;
        maxx = maxy = INT_MIN;
        for (auto& p : cells) {
            minx = min(minx, p.first);
            maxx = max(maxx, p.first);
            miny = min(miny, p.second);
            maxy = max(maxy, p.second);
        }
    }
    
    vector<pair<int,int>> get_transformed_cells(int dx, int dy, int rot, bool flip) const {
        vector<pair<int,int>> result;
        for (auto& p : cells) {
            int x = p.first, y = p.second;
            if (flip) x = -x;
            for (int i = 0; i < rot; ++i) {
                int nx = y, ny = -x;
                x = nx; y = ny;
            }
            result.emplace_back(x + dx, y + dy);
        }
        return result;
    }
};

bool check_overlap(const vector<pair<int,int>>& a, const vector<pair<int,int>>& b) {
    set<pair<int,int>> set_a(a.begin(), a.end());
    for (auto& p : b) {
        if (set_a.count(p)) return true;
    }
    return false;
}

