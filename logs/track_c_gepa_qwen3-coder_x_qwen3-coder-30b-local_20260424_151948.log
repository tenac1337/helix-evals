        int k; cin >> k;
        sizes[i] = k;
        shapes[i].resize(k);
        int mnx=INT_MAX, mxx=INT_MIN, mny=INT_MAX, mxy=INT_MIN;
        for (int j = 0; j < k; ++j) {
            int x, y; cin >> x >> y;
            shapes[i][j] = {x, y};
            mnx=min(mnx,x); mxx=max(mxx,x);
            mny=min(mny,y); mxy=max(mxy,y);
        }
    }
    
    // Generate all 8 transformations for each shape
    vector<vector<vector<pair<int,int>>>> all_transforms(n);
    for (int i = 0; i < n; ++i) {
        vector<vector<pair<int,int>>> transforms;
        // 4 rotations without reflection
        vector<pair<int,int>> shape = shapes[i];
        for (int rot = 0; rot < 4; ++rot) {
            vector<pair<int,int>> rotated(shape.size());
            for (int j = 0; j < shape.size(); ++j) {
                int x = shape[j].first, y = shape[j].second;
                if (rot == 0) rotated[j] = {x, y};
                else if (rot == 1) rotated[j] = {y, -x};
                else if (rot == 2) rotated[j] = {-x, -y};
                else rotated[j] = {-y, x};
            }
            transforms.push_back(rotated);
            shape = rotated;
        }
        
        // 4 rotations with reflection
        shape = shapes[i];
        for (int rot = 0; rot < 4; ++rot) {
            vector<pair<int,int>> reflected(shape.size());
            for (int j = 0; j < shape.size(); ++j) {
                int x = shape[j].first, y = shape[j].second;
                if (rot == 0) reflected[j] = {-x, y};
                else if (rot == 1) reflected[j] = {y, x};
                else if (rot == 2) reflected[j] = {x, -y};
                else reflected[j] = {-y, -x};
            }
            transforms.push_back(reflected);
            shape = reflected;
        }
        
        all_transforms[i] = transforms;
    }
    
    // Simple greedy approach: place each shape in order with best fit
    vector<tuple<int,int,int,int>> final_placement(n); // x, y, rot, flip
    
    vector<int> widths(n), heights(n);
    for (int i = 0; i < n; ++i) {
        int w = 0, h = 0;
        for (auto& p : shapes[i]) {
            w = max(w, p.first);
            h = max(h, p.second);
        }
        widths[i] = w + 1;
        heights[i] = h + 1;
    }
    
    // Try placing them in a row with minimal height
    int total_width = 0;
    int max_height = 0;
    for (int i = 0; i < n; ++i) {
        total_width += widths[i];
        max_height = max(max_height, heights[i]);
    }
    
    int W = total_width;
    int H = max_height;
    
    // Place in a row starting from (0,0)
    int cur_x = 0;
    for (int i = 0; i < n; ++i) {
        final_placement[i] = {cur_x - shapes[i][0].first, 0 - shapes[i][0].second, 0, 0};
        cur_x += widths[i];
    }
    
    cout << W << " " << H << "\n";
    for (int i = 0; i < n; ++i) {
        cout << get<0>(final_placement[i]) << " " << get<1>(final_placement[i]) << " " << get<2>(final_placement[i]) << " " << get<3>(final_placement[i]) << "\n";
    }
    
    return 0;
}
