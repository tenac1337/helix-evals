using namespace std;

struct Polyomino {
    vector<pair<int, int>> cells;
    int min_x, max_x, min_y, max_y;
    int area;
    
    Polyomino() : min_x(0), max_x(0), min_y(0), max_y(0), area(0) {}
    
    void init(const vector<pair<int, int>>& input_cells) {
        cells = input_cells;
        area = cells.size();
        min_x = max_x = cells[0].first;
        min_y = max_y = cells[0].second;
        for (const auto& p : cells) {
            min_x = min(min_x, p.first);
            max_x = max(max_x, p.first);
            min_y = min(min_y, p.second);
            max_y = max(max_y, p.second);
        }
    }
    
    vector<pair<int, int>> get_rotated_cells(int rot, bool flip) const {
        vector<pair<int, int>> result;
        for (const auto& p : cells) {
            int x = p.first, y = p.second;
            if (flip) x = -x;
            for (int i = 0; i < rot; ++i) {
                int nx = y, ny = -x;
                x = nx; y = ny;
            }
            result.emplace_back(x, y);
        }
        return result;
    }
    
    vector<pair<int, int>> get_transformed_cells(int rot, bool flip, int tx, int ty) const {
        vector<pair<int, int>> result;
        for (const auto& p : get_rotated_cells(rot, flip)) {
            result.emplace_back(p.first + tx, p.second + ty);
        }
        return result;
    }
    
    int width() const { return max_x - min_x + 1; }
    int height() const { return max_y - min_y + 1; }
};

bool check_overlap(const vector<pair<int, int>>& cells1, const vector<pair<int, int>>& cells2) {
    unordered_set<pair<int, int>, hash<pair<int, int>>> s1(cells1.begin(), cells1.end());
    for (const auto& p : cells2) {
        if (s1.count(p)) return true;
    }
    return false;
}

bool can_place(const vector<Polyomino>& pieces, const vector<int>& rotations, const vector<bool>& flips, const vector<pair<int, int>>& placements, int W, int H) {
    vector<vector<pair<int, int>>> all_cells(pieces.size());
    for (int i = 0; i < pieces.size(); ++i) {
        all_cells[i] = pieces[i].get_transformed_cells(rotations[i], flips[i], placements[i].first, placements[i].second);
    }
    
    for (int i = 0; i < pieces.size(); ++i) {
        for (const auto& p : all_cells[i]) {
            if (p.first < 0 || p.first >= W || p.second < 0 || p.second >= H) {
                return false;
            }
        }
    }
    
    for (int i = 0; i < pieces.size(); ++i) {
        for (int j = i + 1; j < pieces.size(); ++j) {
            if (check_overlap(all_cells[i], all_cells[j])) {
                return false;
            }
        }
    }
    return true;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    int n;
    if (!(cin >> n)) return 0;
    
    vector<Polyomino> pieces(n);
    for (int i = 0; i < n; ++i) {
        int k; cin >> k;
        vector<pair<int, int>> cells(k);
        for (int j = 0; j < k; ++j) {
            cin >> cells[j].first >> cells[j].second;
        }
        pieces[i].init(cells);
    }
    
    // Simple greedy approach: place in a grid
    int max_width = 0;
    int max_height = 0;
    for (const auto& p : pieces) {
        max_width = max(max_width, p.width());
        max_height = max(max_height, p.height());
    }
    
    int W = max_width;
    int H = max_height;
    
    // Try different arrangements to find a better one
    vector<pair<int, int>> placements(n);
    vector<int> rotations(n, 0);
    vector<bool> flips(n, false);
    
    // Try placing in a grid pattern
    int x = 0, y = 0;
    int max_x = 0;
    int max_y = 0;
    
    vector<int> widths(n);
    vector<int> heights(n);
    
    for (int i = 0; i < n; ++i) {
        widths[i] = pieces[i].width();
        heights[i] = pieces[i].height();
    }
    
    // Simple column-wise arrangement
    int cur_x = 0;
    int cur_y = 0;
    int max_cur_y = 0;
    int row_height = 0;
    
    for (int i = 0; i < n; ++i) {
        if (cur_x + widths[i] > max_width) {
            cur_x = 0;
            cur_y += row_height;
            row_height = 0;
        }
        placements[i] = {cur_x, cur_y};
        cur_x += widths[i];
        row_height = max(row_height, heights[i]);
        max_cur_y = max(max_cur_y, cur_y + heights[i]);
    }
    
    W = max_width;
    H = max_cur_y;
    
    // Try to reduce height by rotating pieces
    bool improved = true;
    while (improved) {
        improved = false;
        vector<int> new_rotations = rotations;
        vector<bool> new_flips = flips;
        vector<pair<int, int>> new_placements = placements;
        int new_W = W;
        int new_H = H;
        
        for (int i = 0; i < n; ++i) {
            // Try all rotations and flips
            for (int rot = 0; rot < 4; ++rot) {
                for (int flip = 0; flip < 2; ++flip) {
                    // Check if we can rotate piece i and see if it helps
                    int new_w = pieces[i].width();
                    int new_h = pieces[i].height();
                    if (flip) {
                        // After flip, width and height may change
                        int tmp = new_w;
                        new_w = new_h;
                        new_h = tmp;
                    }
                    for (int r = 0; r < rot; ++r) {
                        int tmp = new_w;
                        new_w = new_h;
                        new_h = tmp;
                    }
                    
                    // See if placing this piece with new orientation improves area
                    int test_W = max(W, new_w);
                    int test_H = max(H, new_h);
                    if (test_W * test_H < new_W * new_H) {
                        new_W = test_W;
                        new_H = test_H;
                        new_rotations[i] = rot;
                        new_flips[i] = flip;
                        improved = true;
                    }
                }
            }
        }
        
        if (improved) {
            rotations = new_rotations;
            flips = new_flips;
            W = new_W;
            H = new_H;
        }
    }
    
    // Final placement
    vector<pair<int, int>> final_placements(n);
    int cur_x_pos = 0;
    int cur_y_pos = 0;
    int max_y_pos = 0;
    int row_h = 0;
    
    for (int i = 0; i < n; ++i) {
        int w = pieces[i].width();
        int h = pieces[i].height();
        if (flips[i]) {
            swap(w, h);
        }
        for (int r = 0; r < rotations[i]; ++r) {
            swap(w, h);
        }
        
        if (cur_x_pos + w > W) {
            cur_x_pos = 0;
            cur_y_pos += row_h;
            row_h = 0;
        }
        
        final_placements[i] = {cur_x_pos, cur_y_pos};
        cur_x_pos += w;
        row_h = max(row_h, h);
        max_y_pos = max(max_y_pos, cur_y_pos + h);
    }
    
    // Adjust W and H to fit everything
    W = max(W, cur_x_pos);
    H = max(H, max_y_pos);
    
    cout << W << " " << H << "\n";
    
    for (int i = 0; i < n; ++i) {
        int x = final_placements[i].first;
        int y = final_placements[i].second;
        cout << x << " " << y << " " << rotations[i] << " " << flips[i] << "\n";
    }
    
    return 0;
