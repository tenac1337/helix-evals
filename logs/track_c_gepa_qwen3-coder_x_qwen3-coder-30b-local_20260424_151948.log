using namespace std;

struct Polyomino {
    vector<pair<int, int>> cells;
    int min_x, max_x, min_y, max_y;
    int width, height;
    
    Polyomino() : min_x(0), max_x(0), min_y(0), max_y(0), width(0), height(0) {}
    
    void read(int k) {
        cells.resize(k);
        min_x = min_y = INT_MAX;
        max_x = max_y = INT_MIN;
        for (int i = 0; i < k; ++i) {
            cin >> cells[i].first >> cells[i].second;
            min_x = min(min_x, cells[i].first);
            max_x = max(max_x, cells[i].first);
            min_y = min(min_y, cells[i].second);
            max_y = max(max_y, cells[i].second);
        }
        width = max_x - min_x + 1;
        height = max_y - min_y + 1;
    }
    
    vector<pair<int, int>> get_transformed_cells(int tx, int ty, int rot, bool flip) const {
        vector<pair<int, int>> result;
        for (const auto& p : cells) {
            int x = p.first, y = p.second;
            if (flip) x = -x;
            for (int i = 0; i < rot; ++i) {
                swap(x, y);
                y = -y;
            }
            result.emplace_back(x + tx, y + ty);
        }
        return result;
    }
};

bool check_overlap(const vector<pair<int, int>>& cells1, const vector<pair<int, int>>& cells2) {
    unordered_set<pair<int, int>, hash<pair<int, int>>> s1(cells1.begin(), cells1.end());
    for (const auto& p : cells2) {
        if (s1.count(p)) return true;
    }
    return false;
}

