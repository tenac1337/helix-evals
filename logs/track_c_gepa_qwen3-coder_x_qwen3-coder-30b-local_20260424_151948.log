using namespace std;

struct Polyomino {
    vector<pair<int,int>> cells;
    int minx, maxx, miny, maxy;
    int width, height;
    
    Polyomino() : minx(0), maxx(-1), miny(0), maxy(-1), width(0), height(0) {}
    
    void read(int k) {
        cells.clear();
        minx = INT_MAX; maxx = INT_MIN;
        miny = INT_MAX; maxy = INT_MIN;
        for (int i = 0; i < k; ++i) {
            int x, y; cin >> x >> y;
            cells.push_back({x, y});
            minx = min(minx, x);
            maxx = max(maxx, x);
            miny = min(miny, y);
            maxy = max(maxy, y);
        }
        width = maxx - minx + 1;
        height = maxy - miny + 1;
    }
    
    vector<pair<int,int>> get_transformed_cells(int dx, int dy, int rot, bool flip) const {
        vector<pair<int,int>> result;
        for (auto& p : cells) {
            int x = p.first, y = p.second;
            if (flip) x = -x;
            for (int i = 0; i < rot; ++i) {
                int tmp = x;
                x = y;
                y = -tmp;
            }
            result.push_back({x + dx, y + dy});
        }
        return result;
    }
};

