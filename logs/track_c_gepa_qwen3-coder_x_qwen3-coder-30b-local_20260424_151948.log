using namespace std;

// Function to generate all possible rotations and reflections of a polyomino
vector<vector<pair<int,int>>> get_transforms(const vector<pair<int,int>>& shape) {
    vector<vector<pair<int,int>>> transforms;
    
    // Original shape
    transforms.push_back(shape);
    
    // 90° clockwise rotation
    vector<pair<int,int>> rot90;
    for (auto& p : shape) {
        rot90.push_back({p.second, -p.first});
    }
    transforms.push_back(rot90);
    
    // 180° rotation
    vector<pair<int,int>> rot180;
    for (auto& p : shape) {
        rot180.push_back({-p.first, -p.second});
    }
    transforms.push_back(rot180);
    
    // 270° clockwise rotation
    vector<pair<int,int>> rot270;
    for (auto& p : shape) {
        rot270.push_back({-p.second, p.first});
    }
    transforms.push_back(rot270);
    
    // Reflection across y-axis
    vector<pair<int,int>> refl;
    for (auto& p : shape) {
        refl.push_back({-p.first, p.second});
    }
    transforms.push_back(refl);
    
    // 90° clockwise + reflection
    vector<pair<int,int>> r90;
    for (auto& p : refl) {
        r90.push_back({p.second, -p.first});
    }
    transforms.push_back(r90);
    
    // 180° + reflection
    vector<pair<int,int>> r180;
    for (auto& p : refl) {
        r180.push_back({-p.first, -p.second});
    }
    transforms.push_back(r180);
    
    // 270° clockwise + reflection
    vector<pair<int,int>> r270;
    for (auto& p : refl) {
        r270.push_back({-p.second, p.first});
    }
    transforms.push_back(r270);
    
    return transforms;
}

// Function to find bounding box of a transformed shape
pair<int,int> get_min_max(const vector<pair<int,int>>& shape) {
    int min_x = INT_MAX, max_x = INT_MIN;
    int min_y = INT_MAX, max_y = INT_MIN;
    for (auto& p : shape) {
        min_x = min(min_x, p.first);
        max_x = max(max_x, p.first);
        min_y = min(min_y, p.second);
        max_y = max(max_y, p.second);
    }
    return {min_x, min_y};
}

// Function to check if two shapes overlap
bool overlaps(const vector<pair<int,int>>& s1, const vector<pair<int,int>>& s2, int x1, int y1, int x2, int y2) {
    // Translate both shapes
    set<pair<int,int>> cells1, cells2;
    for (auto& p : s1) {
        cells1.insert({p.first + x1, p.second + y1});
    }
    for (auto& p : s2) {
        cells2.insert({p.first + x2, p.second + y2});
    }
    
    // Check for intersection
    for (auto& p : cells1) {
        if (cells2.count(p)) {
            return true;
        }
    }
    return false;
}

// Function to compute area of a shape
int compute_area(const vector<pair<int,int>>& shape) {
    set<pair<int,int>> unique_cells(shape.begin(), shape.end());
    return unique_cells.size();
}

