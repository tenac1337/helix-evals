class Planner:
    TASK_STRATEGIES = {
        "search": ["search", "summarize"],
        "math": ["compute", "verify"],
        "code": ["analyze", "execute", "test"],
        "classify": ["extract_features", "classify"],
        "summarize": ["fetch", "summarize"],
        "compare": ["fetch", "compare", "rank"],
        "qa": ["search", "extract", "answer"],
        "generate": ["plan", "generate", "refine"],
        "transform": ["parse", "transform", "validate"],
        "reasoning": ["decompose", "reason", "conclude"],
    }

    def make_plan(self, task, context=None):
        task_type = self._infer_type(task, context)
        steps = self.TASK_STRATEGIES.get(task_type, ["search", "summarize"])
        return [{"tool": step, "query": task, "task_type": task_type} for step in steps]

    def _infer_type(self, task, context=None):
        task_lower = str(task).lower()
        ctx_type = (context or {}).get("task_type")
        if ctx_type and ctx_type in self.TASK_STRATEGIES:
            return ctx_type
        rules = [
            ("math", ["calculate", "compute", "solve", "equation", "integral", "derivative"]),
            ("code", ["code", "function", "debug", "implement", "program", "script"]),
            ("classify", ["classify", "categorize", "label", "which category"]),
            ("summarize", ["summarize", "summary", "tldr", "brief"]),
            ("compare", ["compare", "difference", "versus", "vs", "better"]),
            ("qa", ["what is", "who is", "when did", "where is", "why did", "how does"]),
            ("generate", ["generate", "write", "create", "draft", "compose"]),
            ("transform", ["convert", "transform", "translate", "reformat", "parse"]),
            ("reasoning", ["reason", "logic", "infer", "deduce", "conclude"]),
        ]
        for task_type, keywords in rules:
            if any(kw in task_lower for kw in keywords):
                return task_type
        return "search"


class Agent:
    def __init__(self, name, tools=None):
        self.name = name
        self.tools = tools or {}
        self.memory = []
        self.max_turns = 10
        self.planner = Planner()

    def run(self, task, context=None):
        plan = self.planner.make_plan(task, context)
        result = None
        for turn, action in enumerate(plan[:self.max_turns]):
            result = self._execute(action)
            self.memory.append({"turn": turn, "action": action, "result": result})
            if self._is_done(result):
                break
        return result

    def _decide(self, task, context, turn):
        if turn == 0:
            return {"tool": "search", "query": task}
        return None

    def _execute(self, action):
        tool_name = action.get("tool")
        if tool_name in self.tools:
            return self.tools[tool_name](action)
        return {"status": "ok", "tool": tool_name, "result": f"Executed {tool_name}"}

    def _is_done(self, result):
        return result is not None and "error" not in result

    def add_tool(self, name, fn):
        self.tools[name] = fn

    def get_memory(self):
        return self.memory

    def clear_memory(self):
        self.memory = []
        return self
