"""Agent core."""


class Agent:
    def __init__(self, name, tools=None):
        self.name = name
        self.tools = tools or {}
        self.memory = []
        self.max_turns = 10
        self.planner = None

    def set_planner(self, planner):
        self.planner = planner
        return self

    def run(self, task, context=None):
        result = None
        for turn in range(self.max_turns):
            action = self._decide(task, context, turn, result)
            if action is None:
                break
            result = self._execute(action)
            self.memory.append({"turn": turn, "action": action, "result": result})
            if self._is_done(result):
                break
        return result

    def _decide(self, task, context, turn, last_result=None):
        if self.planner is not None:
            completed = [m["action"] for m in self.memory]
            action = self.planner.get_next_step(task, completed)
            if action is not None and last_result is not None:
                action = self._enrich_action(action, last_result)
            return action
        if turn == 0:
            return {"tool": "search", "query": task}
        return None

    def _enrich_action(self, action, last_result):
        """Propagate useful values from the previous step into the next action."""
        action = dict(action)
        tool = action.get("tool")
        if tool == "memory" and action.get("op") == "write":
            if isinstance(last_result, dict):
                if last_result.get("results"):
                    action["value"] = last_result["results"][0].get("value", action.get("value"))
                elif "result" in last_result:
                    action["value"] = last_result["result"]
        return action

    def _execute(self, action):
        tool_name = action.get("tool")
        if tool_name in self.tools:
            return self.tools[tool_name](action)
        return {"error": f"Tool {tool_name} not found"}

    def _is_done(self, result):
        # When planner is active, get_next_step returning None controls termination.
        # Stopping here would cut multi-step plans short after the first success.
        if self.planner is not None:
            return False
        return result is not None and "error" not in result

    def add_tool(self, name, fn):
        self.tools[name] = fn

    def get_memory(self):
        return self.memory

    def clear_memory(self):
        self.memory = []
        return self

