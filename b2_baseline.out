"""Agent core."""


class Agent:
    def __init__(self, name, tools=None):
        self.name = name
        self.tools = tools or {}
        self.memory = []
        self.max_turns = 10
        self.planner = None

    def set_planner(self, planner):
        self.planner = planner
        return self

    def run(self, task, context=None):
        result = None
        for turn in range(self.max_turns):
            action = self._decide(task, context, turn)
            if action is None:
                break
            result = self._execute(action)
            self.memory.append({"turn": turn, "action": action, "result": result})
            if self._is_done(result):
                break
        return result

    def _decide(self, task, context, turn):
        if self.planner is not None:
            completed = [m["action"] for m in self.memory]
            return self.planner.get_next_step(task, completed)
        if turn == 0:
            return {"tool": "search", "query": task}
        return None

    def _execute(self, action):
        tool_name = action.get("tool")
        if tool_name in self.tools:
            return self.tools[tool_name](action)
        return {"error": f"Tool {tool_name} not found"}

    def _is_done(self, result):
        # When planner is active, get_next_step returning None controls termination.
        # Stopping here would cut multi-step plans short after the first success.
        if self.planner is not None:
            return False
        return result is not None and "error" not in result

    def add_tool(self, name, fn):
        self.tools[name] = fn

    def get_memory(self):
        return self.memory

    def clear_memory(self):
        self.memory = []
        return self

# ===== FILE: harness.py =====
"""Agent harness for running and evaluating agents."""
from agent import Agent
from planner import Planner
from tools import make_search_tool, make_calculator_tool, make_memory_tool


def build_agent(knowledge_base=None):
    kb = knowledge_base or {
        "python": "A programming language",
        "helix": "An evolutionary optimization framework",
        "neural network": "A machine learning model",
        "gradient descent": "An optimization algorithm",
    }
    store = {}
    agent = Agent("test-agent")
    agent.add_tool("search", make_search_tool(kb))
    agent.add_tool("calculator", make_calculator_tool())
    agent.add_tool("memory", make_memory_tool(store))

    planner = Planner()
    agent.set_planner(planner)

    return agent


def run_task_suite(agent, tasks):
    results = []
    for task in tasks:
        agent.clear_memory()
        result = agent.run(task)
        results.append({
            "task": task,
            "result": result,
            "turns": len(agent.get_memory()),
            "success": _is_success(result),
        })
    return results


def _is_success(result):
    if result is None:
        return False
    if isinstance(result, dict):
        return "error" not in result
    return True

