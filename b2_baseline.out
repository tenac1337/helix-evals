"""Agent core."""


class Agent:
    def __init__(self, name, tools=None):
        self.name = name
        self.tools = tools or {}
        self.memory = []
        self.max_turns = 10
        self.planner = None

    def set_planner(self, planner):
        self.planner = planner
        return self

    def run(self, task, context=None):
        result = None
        for turn in range(self.max_turns):
            action = self._decide(task, context, turn)
            if action is None:
                break
            result = self._execute(action)
            self.memory.append({"turn": turn, "action": action, "result": result})
            if self._is_done(result):
                break
        return result

    def _decide(self, task, context, turn):
        if self.planner is not None:
            history = [{"action": m["action"], "result": m["result"]} for m in self.memory]
            return self.planner.get_next_step(task, history)
        if turn == 0:
            return {"tool": "search", "query": task}
        return None

    def _execute(self, action):
        tool_name = action.get("tool")
        if tool_name in self.tools:
            return self.tools[tool_name](action)
        return {"error": f"Tool {tool_name} not found"}

    def _is_done(self, result):
        # When planner is active, get_next_step returning None controls termination.
        # Stopping here would cut multi-step plans short after the first success.
        if self.planner is not None:
            return False
        return result is not None and "error" not in result

    def add_tool(self, name, fn):
        self.tools[name] = fn

    def get_memory(self):
        return self.memory

    def clear_memory(self):
        self.memory = []
        return self

