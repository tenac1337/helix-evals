"""Agent harness for running and evaluating agents."""
from agent import Agent
from planner import Planner
from tools import make_search_tool, make_calculator_tool, make_memory_tool


def build_agent(knowledge_base=None):
    kb = knowledge_base or {
        "python": "A programming language",
        "helix": "An evolutionary optimization framework",
        "neural network": "A machine learning model",
        "gradient descent": "An optimization algorithm",
        "machine learning": "A subset of artificial intelligence",
        "algorithm": "A step-by-step computational procedure",
    }
    store = {}
    agent = Agent("test-agent")
    agent.add_tool("search", make_search_tool(kb))
    agent.add_tool("calculator", make_calculator_tool())
    agent.add_tool("memory", make_memory_tool(store))

    planner = Planner()
    agent.set_planner(planner)

    return agent


def make_task_suite():
    """Return 10 tasks covering every plan type the Planner supports."""
    return [
        # 1. simple search via "search" keyword
        "search for python",
        # 2. simple search via "what is"
        "what is helix?",
        # 3. simple search via "define"
        "define neural network",
        # 4. simple search via "look up"
        "look up gradient descent",
        # 5. simple calculate
        "calculate 6 + 7",
        # 6. bare arithmetic (no keyword)
        "100 + 200",
        # 7. memory store
        "remember this for later",
        # 8. memory recall
        "recall result",
        # 9. multi-step: search then store
        "find python and remember it",
        # 10. multi-step: recall then calculate
        "retrieve result and calculate 3 + 4",
    ]


def run_task_suite(agent, tasks):
    results = []
    for task in tasks:
        agent.clear_memory()
        result = agent.run(task)
        results.append({
            "task": task,
            "result": result,
            "turns": len(agent.get_memory()),
            "success": _is_success(result),
        })
    return results


def _is_success(result):
    if result is None:
        return False
    if isinstance(result, dict):
        return "error" not in result
    return True

