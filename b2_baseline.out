class Agent:
    TASK_FALLBACKS = {
        "calculate": "search",
        "classify": "search",
        "extract": "search",
        "transform": "search",
        "generate": "search",
        "compare": "search",
        "filter": "search",
        "aggregate": "search",
        "reason": "analyze",
    }

    def __init__(self, name, tools=None):
        self.name = name
        self.tools = tools or {}
        self.memory = []
        self.max_turns = 10
        self.planner = Planner()

    def run(self, task, context=None):
        """Run agent on a task using a plan from the Planner."""
        plan = self.planner.make_plan(task, context)
        result = None
        accumulated_context = context

        for turn, action in enumerate(plan):
            if turn >= self.max_turns:
                break
            action = dict(action)
            action["_turn"] = turn
            action["context"] = accumulated_context
            result = self._execute(action)
            self.memory.append({"turn": turn, "action": action, "result": result})
            if result and "error" in result:
                fallback = self._fallback_action(task, accumulated_context, result)
                if fallback:
                    result = self._execute(fallback)
                    self.memory.append({"turn": turn, "action": fallback, "result": result})
            if result and result.get("status") != "unhandled":
                accumulated_context = result
            if self._is_done(result):
                break

        return result

    def _fallback_action(self, task, context, failed_result):
        """Produce a fallback action appropriate to the detected task type."""
        task_type = self.planner.detect_task_type(task)
        fallback_tool = self.TASK_FALLBACKS.get(task_type, "search")
        return {"tool": fallback_tool, "task": task, "context": context, "fallback": True}

    def _execute(self, action):
        """Execute an action using registered tools."""
        tool_name = action.get("tool")
        if tool_name in self.tools:
            return self.tools[tool_name](action)
        return {"status": "unhandled", "tool": tool_name, "action": action}

    def _is_done(self, result):
        """Check if task is complete."""
        if result is None:
            return False
        if "error" in result:
            return False
        if result.get("status") == "unhandled":
            return False
        return True

    def add_tool(self, name, fn):
        """Register a tool."""
        self.tools[name] = fn

    def get_memory(self):
        return self.memory

    def clear_memory(self):
        self.memory = []
        return self
