TASK_TYPE_TOOLS = {
    "search": ["search", "fetch", "summarize"],
    "code": ["search", "read_file", "write_file", "execute"],
    "math": ["calculate", "search"],
    "data": ["fetch", "parse", "transform", "summarize"],
    "classify": ["search", "classify"],
    "generate": ["search", "generate"],
    "translate": ["translate"],
    "summarize": ["fetch", "summarize"],
    "qa": ["search", "fetch", "summarize"],
    "plan": ["search", "decompose", "summarize"],
}


class Planner:
    def __init__(self, tools):
        self.tools = tools

    def infer_task_type(self, task):
        task_lower = task.lower()
        if any(k in task_lower for k in ("calculate", "compute", "solve", "equation", "math")):
            return "math"
        if any(k in task_lower for k in ("write code", "implement", "function", "script", "program")):
            return "code"
        if any(k in task_lower for k in ("translate", "in french", "in spanish", "in german")):
            return "translate"
        if any(k in task_lower for k in ("summarize", "summary", "tldr")):
            return "summarize"
        if any(k in task_lower for k in ("classify", "categorize", "label")):
            return "classify"
        if any(k in task_lower for k in ("generate", "create", "produce", "write")):
            return "generate"
        if any(k in task_lower for k in ("transform", "convert", "parse", "extract")):
            return "data"
        if any(k in task_lower for k in ("plan", "steps", "how to", "strategy")):
            return "plan"
        if any(k in task_lower for k in ("what", "who", "when", "where", "why", "answer")):
            return "qa"
        return "search"

    def make_plan(self, task, context=None):
        task_type = self.infer_task_type(task)
        preferred = TASK_TYPE_TOOLS.get(task_type, ["search", "summarize"])
        available = [t for t in preferred if t in self.tools]
        if not available:
            available = list(self.tools.keys())[:3] if self.tools else ["search"]

        steps = []
        for tool in available:
            if tool == "search":
                steps.append({"tool": "search", "query": task})
            elif tool == "fetch":
                steps.append({"tool": "fetch", "url": context.get("url", "") if context else ""})
            elif tool == "calculate":
                steps.append({"tool": "calculate", "expression": task})
            elif tool == "translate":
                steps.append({"tool": "translate", "text": task, "target": context.get("target_lang", "en") if context else "en"})
            elif tool == "classify":
                steps.append({"tool": "classify", "text": task})
            elif tool == "generate":
                steps.append({"tool": "generate", "prompt": task})
            elif tool == "decompose":
                steps.append({"tool": "decompose", "task": task})
            elif tool == "summarize":
                steps.append({"tool": "summarize", "text": task})
            elif tool == "read_file":
                steps.append({"tool": "read_file", "path": context.get("file", "") if context else ""})
            elif tool == "write_file":
                steps.append({"tool": "write_file", "path": context.get("file", "output.txt") if context else "output.txt", "content": ""})
            elif tool == "execute":
                steps.append({"tool": "execute", "code": ""})
            elif tool == "parse":
                steps.append({"tool": "parse", "data": context.get("data", "") if context else ""})
            elif tool == "transform":
                steps.append({"tool": "transform", "data": context.get("data", "") if context else "", "spec": task})
            else:
                steps.append({"tool": tool, "input": task})
        return steps


class Agent:
    def __init__(self, name, tools=None):
        self.name = name
        self.tools = tools or {}
        self.memory = []
        self.max_turns = 10
        self.planner = Planner(self.tools)

    def run(self, task, context=None):
        plan = self.planner.make_plan(task, context)
        result = None
        step_index = 0

        for turn in range(self.max_turns):
            if step_index < len(plan):
                action = plan[step_index]
                step_index += 1
            else:
                action = self._decide(task, context, turn, result)

            if action is None:
                break

            result = self._execute(action)
            self.memory.append({"turn": turn, "action": action, "result": result})

            if self._is_done(result) and step_index >= len(plan):
                break

        return result

    def _decide(self, task, context, turn, last_result=None):
        if last_result and "error" in last_result:
            fallback_tools = [t for t in self.tools if t != last_result.get("failed_tool")]
            if fallback_tools:
                return {"tool": fallback_tools[0], "input": task}
        return None

    def _execute(self, action):
        tool_name = action.get("tool")
        if tool_name in self.tools:
            return self.tools[tool_name](action)
        return {"error": f"Tool {tool_name} not found", "failed_tool": tool_name}

    def _is_done(self, result):
        return result is not None and "error" not in result

    def add_tool(self, name, fn):
        self.tools[name] = fn
        self.planner = Planner(self.tools)

    def get_memory(self):
        return self.memory

    def clear_memory(self):
        self.memory = []
        return self
