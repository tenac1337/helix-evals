TASK_TYPE_TOOLS = {
    "search": ["search"],
    "compute": ["compute", "search"],
    "classify": ["classify", "search"],
    "summarize": ["summarize", "search"],
    "generate": ["generate", "search"],
    "transform": ["transform", "compute"],
    "validate": ["validate", "search"],
    "extract": ["extract", "search"],
    "compare": ["compare", "search", "compute"],
    "rank": ["rank", "search", "compute"],
}


class Planner:
    def __init__(self, tools):
        self.tools = tools

    def detect_task_type(self, task):
        task_lower = str(task).lower()
        if any(w in task_lower for w in ["rank", "order", "sort", "top"]):
            return "rank"
        if any(w in task_lower for w in ["compare", "versus", "vs", "difference"]):
            return "compare"
        if any(w in task_lower for w in ["extract", "pull", "parse", "find all"]):
            return "extract"
        if any(w in task_lower for w in ["validate", "check", "verify", "is valid"]):
            return "validate"
        if any(w in task_lower for w in ["transform", "convert", "translate", "reformat"]):
            return "transform"
        if any(w in task_lower for w in ["generate", "create", "write", "produce"]):
            return "generate"
        if any(w in task_lower for w in ["summarize", "summary", "brief", "tldr"]):
            return "summarize"
        if any(w in task_lower for w in ["classify", "categorize", "label", "tag"]):
            return "classify"
        if any(w in task_lower for w in ["compute", "calculate", "math", "solve", "evaluate"]):
            return "compute"
        return "search"

    def plan(self, task, context=None):
        task_type = self.detect_task_type(task)
        tool_sequence = TASK_TYPE_TOOLS.get(task_type, ["search"])
        steps = []
        for tool in tool_sequence:
            if tool in self.tools:
                steps.append({"tool": tool, "query": task, "task_type": task_type})
        if not steps:
            steps.append({"tool": list(self.tools.keys())[0], "query": task, "task_type": task_type} if self.tools else None)
        return [s for s in steps if s is not None]


class Agent:
    def __init__(self, name, tools=None):
        self.name = name
        self.tools = tools or {}
        self.memory = []
        self.max_turns = 10
        self.planner = Planner(self.tools)

    def run(self, task, context=None):
        plan = self.planner.plan(task, context)
        result = None
        plan_iter = iter(plan)
        for turn in range(self.max_turns):
            action = self._decide(task, context, turn, plan_iter)
            if action is None:
                break
            result = self._execute(action)
            self.memory.append({"turn": turn, "action": action, "result": result})
            if self._is_done(result):
                break
        return result

    def _decide(self, task, context, turn, plan_iter):
        try:
            return next(plan_iter)
        except StopIteration:
            return None

    def _execute(self, action):
        tool_name = action.get("tool")
        if tool_name in self.tools:
            return self.tools[tool_name](action)
        return {"error": f"Tool {tool_name} not found"}

    def _is_done(self, result):
        return result is not None and "error" not in result

    def add_tool(self, name, fn):
        self.tools[name] = fn
        self.planner = Planner(self.tools)

    def get_memory(self):
        return self.memory

    def clear_memory(self):
        self.memory = []
        return self
