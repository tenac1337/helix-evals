"""Agent core."""


class Agent:
    def __init__(self, name, tools=None):
        self.name = name
        self.tools = tools or {}
        self.memory = []
        self.max_turns = 10
        self.planner = None

    def set_planner(self, planner):
        self.planner = planner
        return self

    def run(self, task, context=None):
        result = None
        for turn in range(self.max_turns):
            action = self._decide(task, context, turn, result)
            if action is None:
                break
            result = self._execute(action, result)
            self.memory.append({"turn": turn, "action": action, "result": result})
            if self._is_done(result):
                break
        return result

    def _decide(self, task, context, turn, last_result=None):
        if self.planner is not None:
            completed = [m["action"] for m in self.memory]
            return self.planner.get_next_step(task, completed, last_result)
        if turn == 0:
            return {"tool": "search", "query": task}
        return None

    def _execute(self, action, last_result=None):
        resolved = self._resolve_action(action, last_result)
        tool_name = resolved.get("tool")
        if tool_name in self.tools:
            return self.tools[tool_name](resolved)
        return {"error": f"Tool {tool_name} not found"}

    def _resolve_action(self, action, last_result):
        """Replace $last_result sentinels with the previous step's output."""
        if last_result is None:
            return action
        resolved = {}
        for k, v in action.items():
            if v == "$last_result":
                resolved[k] = last_result
            elif isinstance(v, str) and v.startswith("$last_result."):
                attr = v[len("$last_result."):]
                resolved[k] = last_result.get(attr, v) if isinstance(last_result, dict) else v
            else:
                resolved[k] = v
        return resolved

    def _is_done(self, result):
        # When planner is active, get_next_step returning None controls termination.
        # Stopping here would cut multi-step plans short after the first success.
        if self.planner is not None:
            return False
        return result is not None and "error" not in result

    def add_tool(self, name, fn):
        self.tools[name] = fn

    def get_memory(self):
        return self.memory

    def clear_memory(self):
        self.memory = []
        return self

# ===== FILE: harness.py =====
"""Agent harness for running and evaluating agents."""
from agent import Agent
from planner import Planner
from tools import make_search_tool, make_calculator_tool, make_memory_tool


def build_agent(knowledge_base=None):
    kb = knowledge_base or {
        "python": "A programming language",
        "helix": "An evolutionary optimization framework",
        "neural network": "A machine learning model",
        "gradient descent": "An optimization algorithm",
    }
    store = {}
    agent = Agent("test-agent")
    agent.add_tool("search", make_search_tool(kb))
    agent.add_tool("calculator", make_calculator_tool())
    agent.add_tool("memory", make_memory_tool(store))

    planner = Planner()
    agent.set_planner(planner)

    return agent


def run_task_suite(agent, tasks):
    results = []
    for task in tasks:
        agent.clear_memory()
        result = agent.run(task)
        results.append({
            "task": task,
            "result": result,
            "turns": len(agent.get_memory()),
            "success": _is_success(result),
        })
    return results


def _is_success(result):
    if result is None:
        return False
    if isinstance(result, dict):
        return "error" not in result
    return True

# ===== FILE: planner.py =====
"""Task planning — integrated with Agent via set_planner."""
import re


class Planner:
    """Decomposes tasks into steps for the Agent to execute."""

    TASK_PATTERNS = [
        ("calculate", "_plan_calculate"),
        ("compute",   "_plan_calculate"),
        ("eval",      "_plan_calculate"),
        ("remember",  "_plan_store"),
        ("store",     "_plan_store"),
        ("save",      "_plan_store"),
        ("recall",    "_plan_recall"),
        ("retrieve",  "_plan_recall"),
        ("fetch",     "_plan_recall"),
        ("load",      "_plan_recall"),
        ("search",    "_plan_search"),
        ("find",      "_plan_search"),
        ("look up",   "_plan_search"),
        ("lookup",    "_plan_search"),
        ("what is",   "_plan_search"),
        ("define",    "_plan_search"),
        ("explain",   "_plan_search"),
        ("describe",  "_plan_search"),
        ("show",      "_plan_search"),
        ("list",      "_plan_search"),
    ]

    # Matches complete arithmetic expressions including spaces around operators.
    _ARITH_RE = re.compile(r'\d+(?:\.\d+)?(?:\s*[+\-*/]\s*\d+(?:\.\d+)?)+')

    # Ordered from longest to shortest to prevent prefix shadowing.
    _SEARCH_PREFIXES = [
        "what is", "look up", "lookup", "define", "search for", "search",
        "find", "explain", "describe", "show me", "list", "show",
    ]

    def __init__(self):
        self.plans = {}

    def make_plan(self, task):
        steps = self._classify(task)
        self.plans[task] = steps
        return steps

    def _classify(self, task):
        lower = task.lower()

        has_search = "find" in lower or "search" in lower
        has_store = "store" in lower or "remember" in lower or "save" in lower
        has_recall = "recall" in lower or "retrieve" in lower or "fetch" in lower
        has_calc = (
            "calculate" in lower
            or "compute" in lower
            or bool(self._ARITH_RE.search(task))
        )

        # 3-step: search -> store -> recall
        if has_search and has_store and has_recall:
            return self._plan_search_store_recall(task)

        # 2-step: search then store
        if has_search and has_store:
            return self._plan_search_then_store(task)

        # 2-step: search then calculate
        if has_search and has_calc and not has_store:
            return self._plan_search_then_calculate(task)

        # 2-step: recall then calculate
        if has_recall and has_calc:
            return self._plan_recall_then_calculate(task)

        # Named single-step pattern match
        for keyword, builder in self.TASK_PATTERNS:
            if keyword in lower:
                return getattr(self, builder)(task)

        # Bare arithmetic expression with no keywords
        if self._ARITH_RE.search(task):
            return self._plan_calculate(task)

        # Default: search
        return self._plan_search(task)

    # ---- single-step plans ----

    def _plan_calculate(self, task):
        expr = self._extract_expression(task)
        return [{"tool": "calculator", "expression": expr}]

    def _plan_store(self, task):
        return [{"tool": "memory", "op": "write", "key": "result", "value": task}]

    def _plan_recall(self, task):
        return [{"tool": "memory", "op": "read", "key": "result"}]

    def _plan_search(self, task):
        query = self._extract_search_term(task)
        return [{"tool": "search", "query": query}]

    # ---- multi-step plans ----

    def _plan_search_then_store(self, task):
        query = self._extract_search_term(task)
        return [
            {"tool": "search", "query": query},
            {"tool": "memory", "op": "write", "key": "result", "value": "$last_result"},
        ]

    def _plan_search_then_calculate(self, task):
        query = self._extract_search_term(task)
        expr = self._extract_expression(task)
        return [
            {"tool": "search", "query": query},
            {"tool": "calculator", "expression": expr},
        ]

    def _plan_recall_then_calculate(self, task):
        expr = self._extract_expression(task)
        return [
            {"tool": "memory", "op": "read", "key": "result"},
            {"tool": "calculator", "expression": expr},
        ]

    def _plan_search_store_recall(self, task):
        query = self._extract_search_term(task)
        return [
            {"tool": "search", "query": query},
            {"tool": "memory", "op": "write", "key": "result", "value": "$last_result"},
            {"tool": "memory", "op": "read", "key": "result"},
        ]

    # ---- helpers ----

    def _extract_expression(self, task):
        m = self._ARITH_RE.search(task)
        if m:
            return m.group(0).strip()
        cleaned = re.sub(r"[a-zA-Z,?!]", "", task).strip()
        return cleaned if cleaned else task

    def _extract_search_term(self, task):
        """Strip leading query verbs so the KB substring match can succeed."""
        lower = task.lower()
        for prefix in self._SEARCH_PREFIXES:
            if lower.startswith(prefix):
                return task[len(prefix):].strip().rstrip("?.,")
        return task

    def get_next_step(self, task, completed_steps, last_result=None):
        plan = self.plans.get(task, self.make_plan(task))
        if len(completed_steps) < len(plan):
            return plan[len(completed_steps)]
        return None

# ===== FILE: tools.py =====
"""Tool implementations."""


def make_search_tool(knowledge_base):
    def search(action):
        query = action.get("query", "").lower()
        results = []
        for key, value in knowledge_base.items():
            key_lower = key.lower()
            # Match if query contains the key OR key contains the query substring
            if key_lower in query or query in key_lower or query in str(value).lower():
                results.append({"key": key, "value": value})
        return {"results": results[:5], "query": query}
    return search


def make_calculator_tool():
    def calculate(action):
        expr = action.get("expression", "")
        try:
            allowed = set("0123456789+-*/()., ")
            if not all(c in allowed for c in expr):
                return {"error": "Invalid expression"}
            result = eval(expr)  # nosec — guarded by character whitelist above
            return {"result": result, "expression": expr}
        except Exception as e:
            return {"error": str(e)}
    return calculate


def make_memory_tool(store):
    def memory_op(action):
        op = action.get("op", "read")
        key = action.get("key", "")
        if op == "write":
            store[key] = action.get("value")
            return {"status": "ok", "key": key}
        elif op == "read":
            return {"value": store.get(key), "key": key}
        return {"error": f"Unknown op: {op}"}
    return memory_op
