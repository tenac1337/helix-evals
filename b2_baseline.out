class Planner:
    TASK_TYPES = [
        "search", "compute", "classify", "summarize", "transform",
        "extract", "compare", "generate", "validate", "retrieve",
    ]

    def make_plan(self, task, tools):
        task_lower = task.lower() if isinstance(task, str) else ""
        steps = []

        if any(k in task_lower for k in ("find", "search", "look up", "query")):
            steps.append({"tool": "search", "query": task})
        elif any(k in task_lower for k in ("compute", "calculate", "math", "solve")):
            steps.append({"tool": "compute", "expression": task})
        elif any(k in task_lower for k in ("classify", "categorize", "label")):
            steps.append({"tool": "classify", "input": task})
        elif any(k in task_lower for k in ("summarize", "summary", "tldr")):
            steps.append({"tool": "summarize", "input": task})
        elif any(k in task_lower for k in ("transform", "convert", "translate")):
            steps.append({"tool": "transform", "input": task})
        elif any(k in task_lower for k in ("extract", "parse", "pull")):
            steps.append({"tool": "extract", "input": task})
        elif any(k in task_lower for k in ("compare", "diff", "versus", "vs")):
            steps.append({"tool": "compare", "input": task})
        elif any(k in task_lower for k in ("generate", "create", "write", "produce")):
            steps.append({"tool": "generate", "input": task})
        elif any(k in task_lower for k in ("validate", "verify", "check", "assert")):
            steps.append({"tool": "validate", "input": task})
        elif any(k in task_lower for k in ("retrieve", "get", "fetch", "load")):
            steps.append({"tool": "retrieve", "input": task})
        else:
            # Fallback: try available tools in priority order, then search
            preferred = [t for t in self.TASK_TYPES if t in tools]
            tool = preferred[0] if preferred else "search"
            steps.append({"tool": tool, "query": task, "input": task})

        return steps


class Agent:
    def __init__(self, name, tools=None):
        self.name = name
        self.tools = tools or {}
        self.memory = []
        self.max_turns = 10
        self.planner = Planner()

    def run(self, task, context=None):
        """Run agent on a task using Planner-driven multi-step execution."""
        plan = self.planner.make_plan(task, self.tools)
        result = None
        plan_idx = 0

        for turn in range(self.max_turns):
            action = self._decide(task, context, turn, plan, plan_idx)
            if action is None:
                break
            result = self._execute(action)
            self.memory.append({"turn": turn, "action": action, "result": result})
            plan_idx += 1
            if self._is_done(result):
                break

        return result

    def _decide(self, task, context, turn, plan, plan_idx):
        """Pick the next action from the plan, or None when exhausted."""
        if plan_idx < len(plan):
            action = dict(plan[plan_idx])
            if context:
                action["context"] = context
            return action
        return None

    def _execute(self, action):
        """Execute an action using registered tools."""
        tool_name = action.get("tool")
        if tool_name in self.tools:
            return self.tools[tool_name](action)
        # Graceful degradation: return the action itself as a stub result
        return {"tool": tool_name, "status": "no_impl", "action": action}

    def _is_done(self, result):
        """Check if task is complete."""
        return result is not None and "error" not in result

    def add_tool(self, name, fn):
        """Register a tool."""
        self.tools[name] = fn

    def get_memory(self):
        return self.memory

    def clear_memory(self):
        self.memory = []
        return self
