"""Task planning — integrated with Agent via set_planner."""
import re


class Planner:
    """Decomposes tasks into steps for the Agent to execute."""

    TASK_PATTERNS = [
        ("calculate", "_plan_calculate"),
        ("compute",   "_plan_calculate"),
        ("eval",      "_plan_calculate"),
        ("remember",  "_plan_store"),
        ("store",     "_plan_store"),
        ("save",      "_plan_store"),
        ("recall",    "_plan_recall"),
        ("retrieve",  "_plan_recall"),
        ("fetch",     "_plan_recall"),
        ("load",      "_plan_recall"),
        ("search",    "_plan_search"),
        ("find",      "_plan_search"),
        ("look up",   "_plan_search"),
        ("lookup",    "_plan_search"),
        ("what is",   "_plan_search"),
        ("define",    "_plan_search"),
    ]

    # Matches complete arithmetic expressions including spaces around operators.
    _ARITH_RE = re.compile(r'\d+(?:\.\d+)?(?:\s*[+\-*/]\s*\d+(?:\.\d+)?)+')

    # Ordered from longest to shortest to prevent prefix shadowing.
    _SEARCH_PREFIXES = ["what is", "look up", "lookup", "define", "search for", "search", "find"]

    def __init__(self):
        self.plans = {}

    def make_plan(self, task):
        steps = self._classify(task)
        self.plans[task] = steps
        return steps

    def _classify(self, task):
        lower = task.lower()

        has_search = "find" in lower or "search" in lower or "look up" in lower or "lookup" in lower
        has_store = "store" in lower or "remember" in lower or "save" in lower
        # "load" is treated as a recall alias throughout — include it in multi-step detection too.
        has_recall = "recall" in lower or "retrieve" in lower or "fetch" in lower or "load" in lower
        has_calc = "calculate" in lower or "compute" in lower or bool(self._ARITH_RE.search(task))

        # Multi-step: search then store
        if has_search and has_store:
            return self._plan_search_then_store(task)

        # Multi-step: search then calculate
        if has_search and has_calc:
            return self._plan_search_then_calculate(task)

        # Multi-step: recall then calculate
        if has_recall and has_calc:
            return self._plan_recall_then_calculate(task)

        # Named single-step pattern match
        for keyword, builder in self.TASK_PATTERNS:
            if keyword in lower:
                return getattr(self, builder)(task)

        # Bare arithmetic expression with no keywords
        if self._ARITH_RE.search(task):
            return self._plan_calculate(task)

        # Default: search
        return self._plan_search(task)

    # ---- single-step plans ----

    def _plan_calculate(self, task):
        expr = self._extract_expression(task)
        return [{"tool": "calculator", "expression": expr}]

    def _plan_store(self, task):
        return [{"tool": "memory", "op": "write", "key": "result", "value": task}]

    def _plan_recall(self, task):
        return [{"tool": "memory", "op": "read", "key": "result"}]

    def _plan_search(self, task):
        query = self._extract_search_term(task)
        return [{"tool": "search", "query": query}]

    # ---- multi-step plans ----

    def _plan_search_then_store(self, task):
        query = self._extract_search_term(task)
        return [
            {"tool": "search", "query": query},
            {"tool": "memory", "op": "write", "key": "result", "value": task},
        ]

    def _plan_search_then_calculate(self, task):
        query = self._extract_search_term(task)
        expr = self._extract_expression(task)
        return [
            {"tool": "search", "query": query},
            {"tool": "calculator", "expression": expr},
        ]

    def _plan_recall_then_calculate(self, task):
        expr = self._extract_expression(task)
        return [
            {"tool": "memory", "op": "read", "key": "result"},
            {"tool": "calculator", "expression": expr},
        ]

    # ---- helpers ----

    def _extract_expression(self, task):
        m = self._ARITH_RE.search(task)
        if m:
            return m.group(0).strip()
        cleaned = re.sub(r"[a-zA-Z,?!]", "", task).strip()
        return cleaned if cleaned else task

    def _extract_search_term(self, task):
        """Strip leading query verbs so the KB substring match can succeed."""
        lower = task.lower()
        for prefix in self._SEARCH_PREFIXES:
            if lower.startswith(prefix):
                return task[len(prefix):].strip().rstrip("?.,")
        return task

    def get_next_step(self, task, completed_steps):
        plan = self.plans.get(task, self.make_plan(task))
        if len(completed_steps) < len(plan):
            return plan[len(completed_steps)]
        return None

