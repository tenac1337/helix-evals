TASK_TYPES = [
    "search", "summarize", "classify", "extract", "transform",
    "generate", "compare", "validate", "aggregate", "plan",
]


class Planner:
    def __init__(self, tools):
        self.tools = tools

    def plan(self, task, context):
        task_type = self._infer_type(task, context)
        return self._build_steps(task_type, task, context)

    def _infer_type(self, task, context):
        task_lower = str(task).lower()
        ctx_lower = str(context).lower() if context else ""
        combined = task_lower + " " + ctx_lower

        if any(w in combined for w in ("summarize", "summary", "brief", "tldr")):
            return "summarize"
        if any(w in combined for w in ("classify", "category", "label", "tag")):
            return "classify"
        if any(w in combined for w in ("extract", "parse", "pull out", "identify")):
            return "extract"
        if any(w in combined for w in ("transform", "convert", "reformat", "translate")):
            return "transform"
        if any(w in combined for w in ("generate", "create", "write", "produce")):
            return "generate"
        if any(w in combined for w in ("compare", "difference", "versus", "vs")):
            return "compare"
        if any(w in combined for w in ("validate", "verify", "check", "assert")):
            return "validate"
        if any(w in combined for w in ("aggregate", "combine", "merge", "collect")):
            return "aggregate"
        if any(w in combined for w in ("plan", "schedule", "steps", "roadmap")):
            return "plan"
        return "search"

    def _build_steps(self, task_type, task, context):
        available = set(self.tools.keys())
        steps = []

        if task_type == "search":
            steps.append({"tool": "search", "query": task})
            if "summarize" in available:
                steps.append({"tool": "summarize", "input": "__prev__"})

        elif task_type == "summarize":
            if "fetch" in available:
                steps.append({"tool": "fetch", "input": task})
            steps.append({"tool": "summarize", "input": context or task})

        elif task_type == "classify":
            if "classify" in available:
                steps.append({"tool": "classify", "input": task, "context": context})
            else:
                steps.append({"tool": "search", "query": task})

        elif task_type == "extract":
            if "extract" in available:
                steps.append({"tool": "extract", "input": task, "context": context})
            else:
                steps.append({"tool": "search", "query": task})

        elif task_type == "transform":
            if "transform" in available:
                steps.append({"tool": "transform", "input": task, "context": context})
            elif "generate" in available:
                steps.append({"tool": "generate", "input": task, "context": context})
            else:
                steps.append({"tool": "search", "query": task})

        elif task_type == "generate":
            if "generate" in available:
                steps.append({"tool": "generate", "input": task, "context": context})
            else:
                steps.append({"tool": "search", "query": task})
                if "summarize" in available:
                    steps.append({"tool": "summarize", "input": "__prev__"})

        elif task_type == "compare":
            steps.append({"tool": "search", "query": task})
            if "compare" in available:
                steps.append({"tool": "compare", "input": "__prev__", "context": context})
            elif "summarize" in available:
                steps.append({"tool": "summarize", "input": "__prev__"})

        elif task_type == "validate":
            if "validate" in available:
                steps.append({"tool": "validate", "input": task, "context": context})
            else:
                steps.append({"tool": "search", "query": task})

        elif task_type == "aggregate":
            steps.append({"tool": "search", "query": task})
            if "aggregate" in available:
                steps.append({"tool": "aggregate", "input": "__prev__", "context": context})
            elif "summarize" in available:
                steps.append({"tool": "summarize", "input": "__prev__"})

        elif task_type == "plan":
            if "plan" in available:
                steps.append({"tool": "plan", "input": task, "context": context})
            else:
                steps.append({"tool": "search", "query": task})
                if "generate" in available:
                    steps.append({"tool": "generate", "input": "__prev__", "context": context})

        if not steps:
            steps.append({"tool": "search", "query": task})

        return steps


class Agent:
    def __init__(self, name, tools=None):
        self.name = name
        self.tools = tools or {}
        self.memory = []
        self.max_turns = 10

    def run(self, task, context=None):
        planner = Planner(self.tools)
        steps = planner.plan(task, context)

        result = None
        prev_result = None
        for turn, step in enumerate(steps):
            if turn >= self.max_turns:
                break
            action = self._resolve_refs(step, prev_result)
            result = self._execute(action)
            self.memory.append({"turn": turn, "action": action, "result": result})
            if self._is_done(result):
                prev_result = result
            else:
                break

        return result

    def _resolve_refs(self, action, prev_result):
        resolved = {}
        for key, value in action.items():
            if value == "__prev__" and prev_result is not None:
                resolved[key] = prev_result
            else:
                resolved[key] = value
        return resolved

    def _decide(self, task, context, turn):
        if turn == 0:
            return {"tool": "search", "query": task}
        return None

    def _execute(self, action):
        tool_name = action.get("tool")
        if tool_name in self.tools:
            return self.tools[tool_name](action)
        return {"error": f"Tool {tool_name} not found"}

    def _is_done(self, result):
        return result is not None and "error" not in result

    def add_tool(self, name, fn):
        self.tools[name] = fn

    def get_memory(self):
        return self.memory

    def clear_memory(self):
        self.memory = []
        return self
