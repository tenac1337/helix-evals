class Planner:
    TASK_STRATEGIES = {
        "search": ["search", "summarize"],
        "calculate": ["calculate", "validate"],
        "classify": ["classify", "verify"],
        "extract": ["extract", "format"],
        "transform": ["transform", "validate"],
        "generate": ["generate", "review"],
        "compare": ["search", "compare", "summarize"],
        "filter": ["search", "filter", "format"],
        "aggregate": ["search", "aggregate", "summarize"],
        "reason": ["analyze", "reason", "conclude"],
    }

    TASK_KEYWORDS = {
        "search": ["find", "look up", "retrieve", "locate", "discover", "fetch"],
        "calculate": ["calculate", "compute", "sum", "multiply", "divide", "add", "subtract", "math", "formula", "how many", "how much", "total"],
        "classify": ["classify", "categorize", "label", "group", "sort", "tag", "identify", "type of", "kind of"],
        "extract": ["extract", "pull out", "parse", "get field", "retrieve field", "find value", "obtain"],
        "transform": ["transform", "convert", "change format", "translate", "reformat", "encode", "decode"],
        "generate": ["generate", "create", "write", "produce", "make", "compose", "draft", "build"],
        "compare": ["compare", "contrast", "difference", "similar", "versus", "vs", "which is better", "how do"],
        "filter": ["filter", "remove", "exclude", "keep only", "select", "narrow", "only include"],
        "aggregate": ["aggregate", "combine", "merge", "count all", "group by", "tally", "collect all"],
        "reason": ["reason", "infer", "deduce", "conclude", "why", "explain", "analyze", "because", "cause", "therefore"],
    }

    DEFAULT_STRATEGY = ["search", "summarize"]

    def detect_task_type(self, task):
        task_lower = str(task).lower()
        for task_type in self.TASK_STRATEGIES:
            if task_type in task_lower:
                return task_type
        scores = {t: 0 for t in self.TASK_STRATEGIES}
        for task_type, keywords in self.TASK_KEYWORDS.items():
            for kw in keywords:
                if kw in task_lower:
                    scores[task_type] += 1
        best = max(scores, key=lambda k: scores[k])
        if scores[best] > 0:
            return best
        return "search"

    def make_plan(self, task, context=None):
        task_type = self.detect_task_type(task)
        steps = self.TASK_STRATEGIES.get(task_type, self.DEFAULT_STRATEGY)
        return [{"tool": step, "task": task, "context": context, "task_type": task_type} for step in steps]


class Agent:
    def __init__(self, name, tools=None):
        self.name = name
        self.tools = tools or {}
        self.memory = []
        self.max_turns = 10
        self.planner = Planner()

    def run(self, task, context=None):
        """Run agent on a task using a plan from the Planner."""
        plan = self.planner.make_plan(task, context)
        result = None
        running_context = context

        for turn, action in enumerate(plan):
            if turn >= self.max_turns:
                break
            action = dict(action)
            action["_turn"] = turn
            if result is not None:
                action["prior_result"] = result
                if isinstance(running_context, dict):
                    running_context = {**running_context, "prior_result": result}
                else:
                    running_context = {"original": running_context, "prior_result": result}
                action["context"] = running_context

            result = self._execute(action)
            self.memory.append({"turn": turn, "action": action, "result": result})

            if result and "error" in result:
                fallback = self._fallback_action(task, running_context, result, action.get("task_type"))
                if fallback:
                    result = self._execute(fallback)
                    self.memory.append({"turn": turn, "action": fallback, "result": result})

            if self._is_done(result) and turn == len(plan) - 1:
                break

        return result

    def _fallback_action(self, task, context, failed_result, task_type=None):
        """Produce a task-type-aware fallback when a planned step fails."""
        fallback_tool = "search"
        if task_type in ("calculate", "transform", "generate", "classify", "extract"):
            fallback_tool = task_type
        return {"tool": fallback_tool, "task": task, "context": context, "fallback": True}

    def _execute(self, action):
        """Execute an action using registered tools."""
        tool_name = action.get("tool")
        if tool_name in self.tools:
            return self.tools[tool_name](action)
        return {"status": "unhandled", "tool": tool_name, "action": action}

    def _is_done(self, result):
        """Check if task is complete."""
        if result is None:
            return False
        if "error" in result:
            return False
        if result.get("status") == "unhandled":
            return False
        return True

    def add_tool(self, name, fn):
        """Register a tool."""
        self.tools[name] = fn

    def get_memory(self):
        return self.memory

    def clear_memory(self):
        self.memory = []
        return self
