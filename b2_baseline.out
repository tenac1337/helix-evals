# ===== FILE: planner.py =====
"""Task planning — integrated with Agent via set_planner."""
import re


class Planner:
    """Decomposes tasks into steps for the Agent to execute.

    Supported task types (10 total):
      1. search only
      2. calculate only
      3. store only
      4. recall only
      5. search → store
      6. search → calculate
      7. recall → calculate
      8. calculate → store
      9. recall → store
     10. search → calculate → store
    """

    TASK_PATTERNS = [
        ("calculate", "_plan_calculate"),
        ("compute",   "_plan_calculate"),
        ("eval",      "_plan_calculate"),
        ("remember",  "_plan_store"),
        ("store",     "_plan_store"),
        ("save",      "_plan_store"),
        ("recall",    "_plan_recall"),
        ("retrieve",  "_plan_recall"),
        ("fetch",     "_plan_recall"),
        ("load",      "_plan_recall"),
        ("search",    "_plan_search"),
        ("find",      "_plan_search"),
        ("look up",   "_plan_search"),
        ("lookup",    "_plan_search"),
        ("what is",   "_plan_search"),
        ("define",    "_plan_search"),
    ]

    _ARITH_RE = re.compile(r'\d+(?:\.\d+)?(?:\s*[+\-*/]\s*\d+(?:\.\d+)?)+')

    # Ordered longest-first to prevent prefix shadowing.
    _SEARCH_PREFIXES = ["what is", "look up", "lookup", "define", "search for", "search", "find"]

    _SEARCH_KWS  = frozenset(["find", "search", "look up", "lookup", "what is", "define"])
    _STORE_KWS   = frozenset(["store", "remember", "save"])
    _RECALL_KWS  = frozenset(["recall", "retrieve", "fetch", "load"])
    _CALC_KWS    = frozenset(["calculate", "compute", "eval"])

    def __init__(self):
        self.plans = {}

    def make_plan(self, task):
        steps = self._classify(task)
        self.plans[task] = steps
        return steps

    # ---- keyword helpers ----

    def _has_search(self, lower):
        return any(kw in lower for kw in self._SEARCH_KWS)

    def _has_store(self, lower):
        return any(kw in lower for kw in self._STORE_KWS)

    def _has_recall(self, lower):
        return any(kw in lower for kw in self._RECALL_KWS)

    def _has_calc(self, lower):
        return any(kw in lower for kw in self._CALC_KWS) or bool(self._ARITH_RE.search(lower))

    # ---- classification ----

    def _classify(self, task):
        lower = task.lower()

        # 3-step: search → calculate → store
        if self._has_search(lower) and self._has_calc(lower) and self._has_store(lower):
            return self._plan_search_calculate_store(task)

        # 2-step combinations
        if self._has_search(lower) and self._has_store(lower):
            return self._plan_search_then_store(task)

        if self._has_search(lower) and self._has_calc(lower):
            return self._plan_search_then_calculate(task)

        if self._has_recall(lower) and self._has_calc(lower):
            return self._plan_recall_then_calculate(task)

        if self._has_calc(lower) and self._has_store(lower):
            return self._plan_calculate_then_store(task)

        if self._has_recall(lower) and self._has_store(lower):
            return self._plan_recall_then_store(task)

        # Single-step keyword match
        for keyword, builder in self.TASK_PATTERNS:
            if keyword in lower:
                return getattr(self, builder)(task)

        # Bare arithmetic expression
        if self._ARITH_RE.search(task):
            return self._plan_calculate(task)

        return self._plan_search(task)

    # ---- single-step plans ----

    def _plan_calculate(self, task):
        expr = self._extract_expression(task)
        return [{"tool": "calculator", "expression": expr}]

    def _plan_store(self, task):
        return [{"tool": "memory", "op": "write", "key": "result", "value": task}]

    def _plan_recall(self, task):
        return [{"tool": "memory", "op": "read", "key": "result"}]

    def _plan_search(self, task):
        query = self._extract_search_term(task)
        return [{"tool": "search", "query": query}]

    # ---- multi-step plans ----

    def _plan_search_then_store(self, task):
        query = self._extract_search_term(task)
        return [
            {"tool": "search", "query": query},
            {"tool": "memory", "op": "write", "key": "result", "value": task},
        ]

    def _plan_search_then_calculate(self, task):
        query = self._extract_search_term(task)
        expr = self._extract_expression(task)
        return [
            {"tool": "search", "query": query},
            {"tool": "calculator", "expression": expr},
        ]

    def _plan_recall_then_calculate(self, task):
        expr = self._extract_expression(task)
        return [
            {"tool": "memory", "op": "read", "key": "result"},
            {"tool": "calculator", "expression": expr},
        ]

    def _plan_calculate_then_store(self, task):
        expr = self._extract_expression(task)
        return [
            {"tool": "calculator", "expression": expr},
            {"tool": "memory", "op": "write", "key": "result", "value": expr},
        ]

    def _plan_recall_then_store(self, task):
        return [
            {"tool": "memory", "op": "read", "key": "result"},
            {"tool": "memory", "op": "write", "key": "result", "value": task},
        ]

    def _plan_search_calculate_store(self, task):
        query = self._extract_search_term(task)
        expr = self._extract_expression(task)
        return [
            {"tool": "search", "query": query},
            {"tool": "calculator", "expression": expr},
            {"tool": "memory", "op": "write", "key": "result", "value": expr},
        ]

    # ---- helpers ----

    def _extract_expression(self, task):
        m = self._ARITH_RE.search(task)
        if m:
            return m.group(0).strip()
        cleaned = re.sub(r"[a-zA-Z,?!]", "", task).strip()
        return cleaned if cleaned else task

    def _extract_search_term(self, task):
        lower = task.lower()
        for prefix in self._SEARCH_PREFIXES:
            if lower.startswith(prefix):
                return task[len(prefix):].strip().rstrip("?.,")
        return task

    def get_next_step(self, task, completed_steps):
        plan = self.plans.get(task, self.make_plan(task))
        if len(completed_steps) < len(plan):
            return plan[len(completed_steps)]
        return None

