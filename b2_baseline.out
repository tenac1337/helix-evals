        "filter": ["search", "filter", "format"],
        "aggregate": ["search", "aggregate", "summarize"],
        "reason": ["analyze", "reason", "conclude"],
    }

    TASK_KEYWORDS = {
        "search": ["search", "find", "lookup", "locate", "retrieve", "query"],
        "calculate": ["calculate", "compute", "math", "arithmetic", "sum", "multiply", "divide", "add", "subtract", "total", "count"],
        "classify": ["classify", "categorize", "label", "tag", "sort", "group", "type"],
        "extract": ["extract", "parse", "pull", "get", "read", "scrape"],
        "transform": ["transform", "convert", "change", "modify", "translate", "reformat"],
        "generate": ["generate", "create", "write", "produce", "make", "compose", "draft"],
        "compare": ["compare", "contrast", "difference", "similar", "versus", "vs"],
        "filter": ["filter", "remove", "exclude", "include", "select", "prune"],
        "aggregate": ["aggregate", "combine", "merge", "collect", "gather", "join"],
        "reason": ["reason", "analyze", "infer", "deduce", "explain", "why", "how", "evaluate"],
    }

    DEFAULT_STRATEGY = ["search", "summarize"]

    def make_plan(self, task, context=None):
        task_type = self.detect_task_type(task)
        steps = self.TASK_STRATEGIES.get(task_type, self.DEFAULT_STRATEGY)
        return [{"tool": step, "task": task, "context": context} for step in steps]

    def detect_task_type(self, task):
        task_lower = str(task).lower()
        scores = {task_type: 0 for task_type in self.TASK_KEYWORDS}
        for task_type, keywords in self.TASK_KEYWORDS.items():
            for keyword in keywords:
                if keyword in task_lower:
                    scores[task_type] += 1
        best = max(scores, key=lambda t: scores[t])
        if scores[best] > 0:
            return best
        return "search"


class Agent:
    def __init__(self, name, tools=None):
        self.name = name
        self.tools = tools or {}
        self.memory = []
        self.max_turns = 10
        self.planner = Planner()

    def run(self, task, context=None):
        """Run agent on a task using a plan from the Planner."""
        plan = self.planner.make_plan(task, context)
        result = None

        for turn, action in enumerate(plan):
            if turn >= self.max_turns:
                break
            action["_turn"] = turn
            result = self._execute(action)
            self.memory.append({"turn": turn, "action": action, "result": result})
            if result.get("status") == "unhandled":
                generic = self._generic_action(action, task, context)
                result = self._execute(generic)
                self.memory.append({"turn": turn, "action": generic, "result": result})
            if "error" in result:
                fallback = self._fallback_action(task, context, result)
                if fallback:
                    result = self._execute(fallback)
                    self.memory.append({"turn": turn, "action": fallback, "result": result})
            if self._is_done(result):
                break

        if result is None:
            result = {"status": "no_plan", "task": task}

        return result

    def _decide(self, task, context, turn):
        """Decide next action using the Planner."""
        plan = self.planner.make_plan(task, context)
        if turn < len(plan):
            return plan[turn]
        return None

    def _generic_action(self, original_action, task, context):
        """Remap an unhandled tool to the closest registered tool."""
        tool_name = original_action.get("tool", "")
        if self.tools:
            # Prefer exact prefix match, then first available
            for registered in self.tools:
                if registered.startswith(tool_name[:3]):
                    return {"tool": registered, "task": task, "context": context, "remapped_from": tool_name}
            first = next(iter(self.tools))
            return {"tool": first, "task": task, "context": context, "remapped_from": tool_name}
        return original_action

    def _fallback_action(self, task, context, failed_result):
        """Produce a fallback action when a planned step fails."""
        task_type = self.planner.detect_task_type(task)
        # Use the first step of the detected strategy as fallback
        steps = self.planner.TASK_STRATEGIES.get(task_type, self.planner.DEFAULT_STRATEGY)
        fallback_tool = steps[0] if steps else "search"
        if fallback_tool in self.tools:
            return {"tool": fallback_tool, "task": task, "context": context, "fallback": True}
        if self.tools:
            return {"tool": next(iter(self.tools)), "task": task, "context": context, "fallback": True}
        return None

    def _execute(self, action):
        """Execute an action using registered tools."""
        tool_name = action.get("tool")
        if tool_name in self.tools:
            try:
                return self.tools[tool_name](action)
            except Exception as exc:
                return {"error": str(exc), "tool": tool_name, "action": action}
        return {"status": "unhandled", "tool": tool_name, "action": action}

    def _is_done(self, result):
        """Check if task is complete."""
        if result is None:
            return False
        if "error" in result:
            return False
        if result.get("status") in ("unhandled", "no_plan"):
            return False
        return True

    def add_tool(self, name, fn):
        """Register a tool."""
        self.tools[name] = fn

    def get_memory(self):
        return self.memory

    def clear_memory(self):
        self.memory = []
        return self
