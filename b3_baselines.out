class DataProcessor:
    def __init__(self, fmt='default'):
        self.fmt = fmt

    def process(self, data):
        if self.fmt == 'json':
            return str(data)
        elif self.fmt == 'csv':
            return ','.join(map(str, data))
        return str(data)


def process_data(data, options=None):
    if options is None:
        options = {}
    fmt = options.get('format') if isinstance(options, dict) else options
    processor = DataProcessor(fmt=fmt or 'default')
    return processor.process(data)
