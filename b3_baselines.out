import json

def process_data(data, options=None):
    fmt = None
    if isinstance(options, dict):
        fmt = options.get('format')
    elif isinstance(options, str):
        fmt = options

    if fmt == 'json':
        return json.dumps(data)
    elif fmt == 'csv':
