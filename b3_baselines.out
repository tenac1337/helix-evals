from typing import Any, Iterable, Optional, Union
import json


class DataProcessor:
    """Processes data into various output formats."""

    SUPPORTED_FORMATS = ('json', 'csv', 'text')

    def __init__(self, fmt: str = 'text'):
        if fmt not in self.SUPPORTED_FORMATS:
            raise ValueError(f"Unsupported format: {fmt!r}. Choose from {self.SUPPORTED_FORMATS}")
        self.fmt = fmt

    def process(self, data: Any) -> str:
        if self.fmt == 'json':
            return json.dumps(data)
        elif self.fmt == 'csv':
            if not hasattr(data, '__iter__') or isinstance(data, (str, bytes)):
                return str(data)
            return ','.join(str(item) for item in data)
        return str(data)


def process_data(data: Any, options: Optional[Union[dict, str]] = None) -> str:
    """Process data according to the specified format options."""
    if options is None:
        fmt = 'text'
    elif isinstance(options, dict):
        fmt = options.get('format', 'text')
    else:
        fmt = options

    processor = DataProcessor(fmt if fmt in DataProcessor.SUPPORTED_FORMATS else 'text')
    return processor.process(data)
