"""Core module with API that will be refactored."""
import json

def process_data(data, options):
    fmt = options.get('format') if isinstance(options, dict) else options
    if fmt == 'json':
        return json.dumps(data)
    elif fmt == 'csv':
        return ','.join(map(str, data))
    return json.dumps(data)

# ===== FILE: handlers.py =====
"""Handler module that uses core API."""
from core import process_data

def handle_request(payload):
    """Handle incoming request.
    
    Args:
        payload: Dict with 'items' and 'type' keys
    
    Returns:
        Processed result
    """
    items = payload['items']
    fmt = payload['type']
    return process_data(items, fmt)

# ===== FILE: logger.py =====
"""Logger module that uses core API."""
from core import process_data

def log_output(items, log_format='json'):
    """Log output in specified format.
    
    Args:
        items: List of items to log
        log_format: Format for logging ('json' or 'csv')
    
    Returns:
        Logged string
    """
    return process_data(items, log_format)

