# ===== FILE: test_refactoring.py =====
import unittest
from analyzer import analyze
from pipeline import run_pipeline
from utils import transform

class TestRefactoring(unittest.TestCase):
    def test_analyze(self):
        self.assertEqual(analyze([1, 2, 3]), [2, 4, 6])

    def test_run_pipeline(self):
        self.assertEqual(run_pipeline([1, 2, 3]), [2, 4, 6])

    def test_transform(self):
        self.assertEqual(transform([1, 2, 3]), [2, 4, 6])

    def test_analyze_empty(self):
        self.assertEqual(analyze([]), [])

    def test_run_pipeline_empty(self):
        self.assertEqual(run_pipeline([]), [])

    def test_transform_empty(self):
        self.assertEqual(transform([]), [])

if __name__ == '__main__':
    unittest.main()
