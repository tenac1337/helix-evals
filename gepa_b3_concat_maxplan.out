from user_types import UserRecord
from storage import store_user, retrieve_user

def create_user(name, email, age):
    return UserRecord(name, email, age)

def validate_user(user):
    return (
        isinstance(user, UserRecord)
        and isinstance(user.name, str)
        and len(user.name) > 0
        and isinstance(user.email, str)
        and "@" in user.email
        and isinstance(user.age, int)
        and user.age >= 0
    )

def save_user(user):
    if not validate_user(user):
        raise ValueError(f"Invalid user: {user!r}")
    return store_user(user)

def get_user(name):
    return retrieve_user(name)
