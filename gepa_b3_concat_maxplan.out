"""Core module with API that will be refactored."""
def process_data(data, options):
    if isinstance(options, dict):
        fmt = options.get('format')
    else:
        fmt = options
    if fmt == 'json':
        return str(data)
    elif fmt == 'csv':
        return ','.join(map(str, data))
    return str(data)

